.ld2-card.ld2-fact{--bg:#142336;--bd:#669bc8;--tile:#243f5d;--title:#9ed4fd;--sub:#85b7e1;--ico:#9fd4fd;--body:#ebf5fe;--fl1:#3a6a96;--fl2:#243f5d}
