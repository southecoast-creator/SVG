.ld2-card.ld2-note{--bg:#302813;--bd:#c1ad6c;--tile:#53411b;--title:#fbe4a7;--sub:#dcc689;--ico:#fee49f;--body:#fef8e6;--fl1:#7d632a;--fl2:#53411b}

/* header: icon tile, title block, corner icon */
.ld2-card .ld2-head{display:flex;align-items:center;gap:10px}
.ld2-card .ld2-tile{
  flex:none;display:grid;place-items:center;width:44px;height:44px;border-radius:10px;background:var(--tile);
}
.ld2-card .ld2-tile svg{display:block;width:24px;height:24px;fill:none;stroke:var(--ico);stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.ld2-card .ld2-titles{flex:1 1 auto;min-width:0}
.ld2-card .ld2-title{
  display:flex;align-items:center;gap:10px;margin:0;padding:0;
  color:var(--title);font-size:clamp(17px,5.4vw,19.5px);font-weight:700;line-height:1.45;
}
.ld2-card .ld2-emoji{flex:none;display:block;width:21px;height:21px}
.ld2-card .ld2-sub{
  margin:0;padding:0;color:var(--sub);
  font-size:clamp(11px,3.5vw,13px);font-weight:400;line-height:1.5;text-transform:uppercase;letter-spacing:0;
}
.ld2-card .ld2-corner{flex:none;display:block;width:24px;height:24px;fill:none;stroke:var(--ico);stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}

/* body + footer */
.ld2-card .ld2-body{
  margin:16px 0 0;padding:0;color:var(--body);
  font-size:clamp(16.5px,5.3vw,19px);font-weight:400;line-height:1.58;
}
.ld2-card .ld2-body:last-child{padding-bottom:18px}   /* keeps the last line clear of the fold */
.ld2-card .ld2-foot{
  display:flex;align-items:center;justify-content:flex-end;gap:6px;
  margin:12px 0 0;padding:0;color:var(--sub);
  font-size:clamp(11px,3.5vw,13px);font-style:italic;font-weight:400;line-height:1.5;
}
.ld2-card .ld2-foot svg{flex:none;display:block;width:20px;height:20px}

/* ---------- dog-ear fold, lower-left (inline SVG) ---------- */
.ld2-card .ld2-fold{
  position:absolute;left:-1px;bottom:-1px;width:var(--f);height:var(--f);
  display:block;overflow:visible;pointer-events:none;
  filter:drop-shadow(1.4px .9px 1px rgba(0,0,0,.55));
}

@media (max-width:340px){
  .ld2-card{padding:18px 13px 14px;--f:24px}
  .ld2-card .ld2-tile{width:40px;height:40px}
}
