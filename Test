<input type="checkbox" name="AI Uses" value="Drafting">
Drafting
</label>

<label class="option-label">
<input type="checkbox" name="AI Uses" value="Rewriting">
Rewriting
</label>

<label class="option-label">
<input type="checkbox" name="AI Uses" value="Editing">
Editing
</label>

<label class="option-label">
<input type="checkbox" name="AI Uses" value="Grammar Correction">
Grammar Correction
</label>

<label class="option-label">
<input type="checkbox" name="AI Uses" value="Improving Descriptions">
Improving Descriptions
</label>

</div>

