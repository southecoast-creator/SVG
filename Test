/* ==========================
WRITER INFORMATION SECTIONS
========================== */

.option-group{
display:flex;
flex-wrap:wrap;
gap:12px;
margin-top:10px;
}

.option-label{
display:inline-flex;
align-items:center;
gap:8px;
padding:12px 18px;
background:#1b1624;
border:1px solid rgba(212,175,55,.35);
border-radius:999px;
color:#f5e6c8;
cursor:pointer;
transition:.3s;
}

.option-label:hover{
background:#2b2238;
border-color:#D4AF37;
}

.option-label input{
accent-color:#D4AF37;
}

.ai-note{
padding:22px;
margin-top:20px;
background:#1b1624;
border-left:3px solid #D4AF37;
border-radius:12px;
color:#d9ccb1;
line-height:1.8;
}

.required-note{
color:#cbb98f;
font-size:.9rem;
margin-top:8px;
font-style:italic;
}

.declaration-box{
margin-top:25px;
padding:25px;
background:#17121f;
border:1px solid rgba(212,175,55,.25);
border-radius:18px;
line-height:1.8;
}

@media(max-width:768px){

.option-label{
width:100%;
}

}