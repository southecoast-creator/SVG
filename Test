</style>


<script>

document.addEventListener(
  "DOMContentLoaded",
  async function () {

    /* =====================================================
       SUPABASE
    ===================================================== */

    const SUPABASE_URL =
      "https://uniecvgkxhcbedppadgx.supabase.co";

    const SUPABASE_KEY =
      "sb_publishable_UhqP7y8Cjyiv8RebOSMUDA_lBj0QuTE";

    const supabaseClient =
      window.supabase.createClient(
        SUPABASE_URL,
        SUPABASE_KEY,
        {
          auth: {
            persistSession: true,
            autoRefreshToken: true,
            detectSessionInUrl: true
          }
        }
      );


    /* =====================================================
       ELEMENTS
    ===================================================== */

    const booksContainer =
      document.getElementById(
        "led-books"
      );

    const bookCount =
      document.getElementById(
        "led-book-count"
      );

    const reviewPanel =
      document.getElementById(
        "led-review-panel"
      );

    const closeReview =
      document.getElementById(
        "led-close-review"
      );


    /* =====================================================
       CHECK LOGIN
    ===================================================== */

    const {
      data: {
        session
      }
    } =
      await supabaseClient.auth.getSession();


    if (!session) {

      booksContainer.innerHTML =
        "<div class='led-message'>" +
        "Please log in to use the Editor Dashboard." +
        "</div>";

      return;
    }


    /* =====================================================
       LOAD ALL BOOK SUBMISSIONS
    ===================================================== */

    booksContainer.innerHTML =
      "<div class='led-message'>" +
      "Loading books..." +
      "</div>";


    const {
      data: submissions,
      error
    } =
      await supabaseClient
        .from("book_submissions")
        .select(
          "id,author_id,book_id,title,description,genre,cover_url,status,created_at,submitted_at,subgenre,book_outline,protagonist,antagonist,additional_details,author_details"
        )
        .order(
          "created_at",
          {
            ascending: false
          }
        );


    if (error) {

      console.error(
        "EDITOR BOOK LOAD ERROR:",
        error
      );

      booksContainer.innerHTML =
        "<div class='led-message'>" +
        "Could not load book submissions." +
        "</div>";

      return;
    }


    const books =
      submissions || [];


    bookCount.textContent =
      books.length;


    if (books.length === 0) {

      booksContainer.innerHTML =
        "<div class='led-message'>" +
        "No book submissions yet." +
        "</div>";

      return;
    }


    /* =====================================================
       DISPLAY BOOKS
    ===================================================== */

    booksContainer.innerHTML = "";


    books.forEach(
      function (book) {

        const card =
          document.createElement(
            "div"
          );

        card.className =
          "led-book-card";


        const cover =
          document.createElement(
            "div"
          );

        cover.className =
          "led-book-cover";


        if (book.cover_url) {

          cover.style.backgroundImage =
            "url('" +
            book.cover_url +
            "')";

        }


        const info =
          document.createElement(
            "div"
          );

        info.className =
          "led-book-info";


        const title =
          document.createElement(
            "h3"
          );

        title.textContent =
          book.title ||
          "Untitled Book";


        const author =
          document.createElement(
            "p"
          );

        const authorDetails =
          book.author_details ||
          {};

        author.textContent =
          "Author: " +
          (
            authorDetails.pen_name ||
            authorDetails.full_name ||
            "Unknown"
          );


        const genre =
          document.createElement(
            "p"
          );

        genre.textContent =
          "Genre: " +
          (
            book.genre ||
            "Not specified"
          );


        const status =
          document.createElement(
            "span"
          );

        status.className =
          "led-status";

        status.textContent =
          book.status ||
          "draft";


        const button =
          document.createElement(
            "button"
          );

        button.type =
          "button";

        button.className =
          "led-review-button";

        button.textContent =
          "Open Review";


        button.addEventListener(
          "click",
          function () {

            openBookReview(
              book
            );

          }
        );


        info.appendChild(title);
        info.appendChild(author);
        info.appendChild(genre);
        info.appendChild(status);

        card.appendChild(cover);
        card.appendChild(info);
        card.appendChild(button);

        booksContainer.appendChild(card);

      }
    );


    /* =====================================================
       OPEN BOOK REVIEW
    ===================================================== */

    async function openBookReview(
      book
    ) {

      const title =
        document.getElementById(
          "led-review-title"
        );

      const author =
        document.getElementById(
          "led-review-author"
        );

      const details =
        document.getElementById(
          "led-review-details"
        );

      const chapters =
        document.getElementById(
          "led-review-chapters"
        );


      title.textContent =
        book.title ||
        "Untitled Book";


      const authorDetails =
        book.author_details ||
        {};


      author.textContent =
        "Author: " +
        (
          authorDetails.pen_name ||
          authorDetails.full_name ||
          "Unknown author"
        );


      details.innerHTML = "";


      addDetail(
        details,
        "Status",
        book.status ||
        "Not provided"
      );


      addDetail(
        details,
        "Genre",
        book.genre
      );


      addDetail(
        details,
        "Subgenre",
        book.subgenre
      );


      addDetail(
        details,
        "Description",
        book.description
      );


      addDetail(
        details,
        "Book Outline",
        book.book_outline
      );


      addDetail(
        details,
        "Author Name",
        authorDetails.full_name
      );


      addDetail(
        details,
        "Pen Name",
        authorDetails.pen_name
      );


      addDetail(
        details,
        "Author Bio",
        authorDetails.bio
      );


      chapters.innerHTML =
        "<div class='led-message'>" +
        "Loading chapters..." +
        "</div>";


      reviewPanel.style.display =
        "block";


      /* ===================================================
         LOAD CHAPTERS FOR THIS BOOK
      =================================================== */

      if (!book.book_id) {

        chapters.innerHTML =
          "<div class='led-message'>" +
          "This submission is not connected to a book yet." +
          "</div>";

        return;
      }


      const {
        data: chapterRows,
        error: chapterError
      } =
        await supabaseClient
          .from("chapters")
          .select(
            "id,book_id,chapter_number,title,content,status,word_count,is_locked,unlock_cost,updated_at,created_at,published_at,submitted_at,reviewed_at,reviewed_by,deletion_requested"
          )
          .eq(
            "book_id",
            book.book_id
          )
          .order(
            "chapter_number",
            {
              ascending: true
            }
          );


      if (chapterError) {

        console.error(
          "EDITOR CHAPTER LOAD ERROR:",
          chapterError
        );

        chapters.innerHTML =
          "<div class='led-message'>" +
          "Could not load the chapters for this book." +
          "</div>";

        return;
      }


      const rows =
        chapterRows || [];


      if (rows.length === 0) {

        chapters.innerHTML =
          "<div class='led-message'>" +
          "No chapters have been added to this book yet." +
          "</div>";

        return;
      }


      chapters.innerHTML = "";


      rows.forEach(
        function (chapter) {

          const card =
            document.createElement(
              "div"
            );

          card.className =
            "led-chapter";


          const heading =
            document.createElement(
              "h4"
            );

          heading.textContent =
            "Chapter " +
            (
              chapter.chapter_number ??
              "—"
            ) +
            " — " +
            (
              chapter.title ||
              "Untitled Chapter"
            );


          const meta =
            document.createElement(
              "div"
            );

          meta.className =
            "led-chapter-meta";


          addChapterBadge(
            meta,
            "Status: " +
            (
              chapter.status ||
              "draft"
            )
          );


          addChapterBadge(
            meta,
            "Words: " +
            (
              chapter.word_count ||
              0
            )
          );


          addChapterBadge(
            meta,
            "Locked: " +
            (
              chapter.is_locked
                ? "Yes"
                : "No"
            )
          );


          if (
            chapter.unlock_cost !==
            null &&
            chapter.unlock_cost !==
            undefined
          ) {

            addChapterBadge(
              meta,
              "Unlock: " +
              chapter.unlock_cost
            );

          }


          const content =
            document.createElement(
              "div"
            );

          content.className =
            "led-chapter-content";

          content.textContent =
            chapter.content ||
            "No chapter content available.";


          card.appendChild(
            heading
          );

          card.appendChild(
            meta
          );

          card.appendChild(
            content
          );

          chapters.appendChild(
            card
          );

        }
      );

    }


    /* =====================================================
       CLOSE REVIEW
    ===================================================== */

    closeReview.addEventListener(
      "click",
      function () {

        reviewPanel.style.display =
          "none";

      }
    );


    /* =====================================================
       HELPER: BOOK DETAIL
    ===================================================== */

    function addDetail(
      container,
      label,
      value
    ) {

      const row =
        document.createElement(
          "div"
        );

      row.className =
        "led-detail";


      const labelElement =
        document.createElement(
          "span"
        );

      labelElement.className =
        "led-detail-label";

      labelElement.textContent =
        label;


      const valueElement =
        document.createElement(
          "div"
        );

      valueElement.className =
        "led-detail-value";

      valueElement.textContent =
        value ||
        "Not provided";


      row.appendChild(
        labelElement
      );

      row.appendChild(
        valueElement
      );


      container.appendChild(
        row
      );

    }


    /* =====================================================
       HELPER: CHAPTER BADGE
    ===================================================== */

    function addChapterBadge(
      container,
      label
    ) {

      const badge =
        document.createElement(
          "span"
        );

      badge.className =
        "led-chapter-badge";

      badge.textContent =
        label;

      container.appendChild(
        badge
      );

    }

  }
);

</script>












      /* ===================================================
         LOAD AUTHOR PAYOUT ACCOUNT
      =================================================== */

      const {
        data: payoutAccount,
        error: payoutError
      } =
        await supabaseClient
          .from("payout_accounts")
          .select(
            "account_name,bank_name,account_number,is_primary"
          )
          .eq(
            "author_id",
            book.author_id
          )
          .eq(
            "is_primary",
            true
          )
          .maybeSingle();


      if (payoutError) {

        console.error(
          "EDITOR PAYOUT ACCOUNT LOAD ERROR:",
          payoutError
        );

        addDetail(
          details,
          "Bank Account",
          "Could not load payout information."
        );

      } else if (payoutAccount) {

        addDetail(
          details,
          "Account Name",
          payoutAccount.account_name
        );

        addDetail(
          details,
          "Bank Name",
          payoutAccount.bank_name
        );

        addDetail(
          details,
          "Account Number",
          payoutAccount.account_number
        );

        addDetail(
          details,
          "Primary Account",
          payoutAccount.is_primary
            ? "Yes"
            : "No"
        );

      } else {

        addDetail(
          details,
          "Bank Account",
          "No primary payout account has been added."
        );

      }