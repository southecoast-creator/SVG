/* ==========================
WRITER INFORMATION SECTIONS
========================== */

.option-group{
display:flex;
flex-wrap:wrap;
gap:12px;
margin-top:10px;
}

.option-label{
display:inline-flex;
align-items:center;
gap:8px;
padding:12px 18px;
background:#1b1624;
border:1px solid rgba(212,175,55,.35);
border-radius:999px;
color:#f5e6c8;
cursor:pointer;
transition:.3s;
}

.option-label:hover{
background:#2b2238;
border-color:#D4AF37;
}

.option-label input{
accent-color:#D4AF37;
}

.ai-note{
padding:22px;
margin-top:20px;
background:#1b1624;
border-left:3px solid #D4AF37;
border-radius:12px;
color:#d9ccb1;
line-height:1.8;
}

.required-note{
color:#cbb98f;
font-size:.9rem;
margin-top:8px;
font-style:italic;
}

.declaration-box{
margin-top:25px;
padding:25px;
background:#17121f;
border:1px solid rgba(212,175,55,.25);
border-radius:18px;
line-height:1.8;
}

@media(max-width:768px){

.option-label{
width:100%;
}

}












<!-- =====================================
WRITING EXPERIENCE
===================================== -->

<section class="form-section">

<h2 class="section-title">
✍️ Writing Experience
</h2>

<p class="section-description">
Tell us about your experience as a writer. There are no wrong answers — we simply want to understand your writing background.
</p>

<div class="input-group">

<label for="writingExperience">
How long have you been writing?
</label>

<select id="writingExperience" name="Writing Experience" required>

<option value="">Select an option</option>
<option>Less than 6 months</option>
<option>6 months – 1 year</option>
<option>1 – 3 years</option>
<option>3 – 5 years</option>
<option>5+ years</option>

</select>

</div>

<div class="input-group">

<label>
Have you published your writing before?
</label>

<div class="option-group">

<label class="option-label">
<input type="radio" name="Published Before" value="Yes" required>
Yes
</label>

<label class="option-label">
<input type="radio" name="Published Before" value="No">
No
</label>

</div>

</div>

<div class="input-group">

<label for="previousPlatforms">
If yes, where have you published your writing?
</label>

<input
type="text"
id="previousPlatforms"
name="Previous Publishing Platforms"
placeholder="e.g. Wattpad, GoodNovel, Webnovel, personal website...">

</div>

<div class="input-group">

<label for="completedStories">
How many stories or books have you completed?
</label>

<select id="completedStories" name="Completed Stories" required>

<option value="">Select an option</option>
<option>None</option>
<option>1</option>
<option>2 – 5</option>
<option>6 – 10</option>
<option>More than 10</option>

</select>

</div>

<div class="input-group">

<label for="previousGenres">
What genres have you previously written?
</label>

<input
type="text"
id="previousGenres"
name="Previous Genres"
placeholder="Tell us the genres you have experience writing.">

</div>

<div class="input-group">

<label>
What type of writing are you most experienced in?
</label>

<div class="option-group">

<label class="option-label">
<input type="checkbox" name="Writing Type" value="Serialized Fiction">
Serialized Fiction
</label>

<label class="option-label">
<input type="checkbox" name="Writing Type" value="Full-Length Novels">
Full-Length Novels
</label>

<label class="option-label">
<input type="checkbox" name="Writing Type" value="Short Stories">
Short Stories
</label>

<label class="option-label">
<input type="checkbox" name="Writing Type" value="Non-Fiction">
Non-Fiction
</label>

<label class="option-label">
<input type="checkbox" name="Writing Type" value="Poetry">
Poetry
</label>

<label class="option-label">
<input type="checkbox" name="Writing Type" value="Other">
Other
</label>

</div>

</div>

</section>


<!-- =====================================
WRITING PROCESS
===================================== -->

<section class="form-section">

<h2 class="section-title">
🧠 Your Writing Process
</h2>

<p class="section-description">
We want to understand how you approach storytelling and develop your ideas.
</p>

<div class="input-group">

<label for="storyBeginning">
How do you usually begin a new story?
</label>

<textarea
id="storyBeginning"
name="How I Begin Stories"
rows="6"
placeholder="Tell us how you normally develop the beginning of a new story..."
required></textarea>

</div>

<div class="input-group">

<label for="storyPlanning">
How do you normally plan your stories?
</label>

<textarea
id="storyPlanning"
name="Story Planning Process"
rows="6"
placeholder="Do you outline, plan chapters, develop characters first, write freely, or use another method?"
required></textarea>

</div>

<div class="input-group">

<label for="strongOpening">
What do you believe makes a strong opening chapter?
</label>

<textarea
id="strongOpening"
name="Strong Opening Chapter"
rows="6"
placeholder="Tell us what you think makes readers want to continue..."
required></textarea>

</div>

<div class="input-group">

<label for="readerInterest">
How do you keep readers interested from one chapter to the next?
</label>

<textarea
id="readerInterest"
name="Keeping Readers Interested"
rows="6"
placeholder="Explain your approach to maintaining reader interest..."
required></textarea>

</div>

<div class="input-group">

<label for="compellingCharacter">
What do you believe makes a character compelling?
</label>

<textarea
id="compellingCharacter"
name="Compelling Character"
rows="6"
placeholder="What makes readers care about or become interested in a character?"
required></textarea>

</div>

<div class="input-group">

<label for="writersBlock">
How do you handle writer's block or moments when you don't know what happens next?
</label>

<textarea
id="writersBlock"
name="Handling Writers Block"
rows="6"
placeholder="Tell us what you normally do when you get stuck..."
required></textarea>

</div>

</section>


