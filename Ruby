rows.forEach(
  function (chapter) {

    const card =
      document.createElement(
        "div"
      );

    card.className =
      "led-chapter";


    /* =================================================
       CHAPTER HEADING
    ================================================= */

    const heading =
      document.createElement(
        "h4"
      );

    heading.textContent =
      "Chapter " +
      (
        chapter.chapter_number ??
        "—"
      ) +
      " — " +
      (
        chapter.title ||
        "Untitled Chapter"
      );


    /* =================================================
       CHAPTER META
    ================================================= */

    const meta =
      document.createElement(
        "div"
      );

    meta.className =
      "led-chapter-meta";


    addChapterBadge(
      meta,
      "Status: " +
      (
        chapter.status ||
        "draft"
      )
    );


    addChapterBadge(
      meta,
      "Words: " +
      (
        chapter.word_count ||
        0
      )
    );


    addChapterBadge(
      meta,
      "Locked: " +
      (
        chapter.is_locked
          ? "Yes"
          : "No"
      )
    );


    addChapterBadge(
      meta,
      "Ruby: " +
      (
        chapter.unlock_cost !== null &&
        chapter.unlock_cost !== undefined &&
        chapter.unlock_cost !== ""
          ? chapter.unlock_cost
          : "Not set"
      )
    );


    /* =================================================
       CHAPTER CONTENT
    ================================================= */

    const content =
      document.createElement(
        "div"
      );

    content.className =
      "led-chapter-content";

    content.textContent =
      chapter.content ||
      "No chapter content available.";


    /* =================================================
       RUBY PRICE CONTROL
    ================================================= */

    const rubyControl =
      document.createElement(
        "div"
      );

    rubyControl.style.marginTop =
      "15px";

    rubyControl.style.padding =
      "15px";

    rubyControl.style.borderRadius =
      "14px";

    rubyControl.style.background =
      "#faf6f8";

    rubyControl.style.border =
      "1px solid #eadde5";


    const rubyLabel =
      document.createElement(
        "label"
      );

    rubyLabel.textContent =
      "Ruby price for this chapter";

    rubyLabel.style.display =
      "block";

    rubyLabel.style.marginBottom =
      "7px";

    rubyLabel.style.fontWeight =
      "700";

    rubyLabel.style.fontSize =
      "12px";


    const rubyInput =
      document.createElement(
        "input"
      );

    rubyInput.type =
      "number";

    rubyInput.min =
      "1";

    rubyInput.step =
      "1";

    rubyInput.placeholder =
      "Leave empty for free chapter";

    rubyInput.value =
      (
        chapter.unlock_cost !== null &&
        chapter.unlock_cost !== undefined
      )
        ? chapter.unlock_cost
        : "";

    rubyInput.style.width =
      "100%";

    rubyInput.style.boxSizing =
      "border-box";

    rubyInput.style.padding =
      "10px";

    rubyInput.style.borderRadius =
      "10px";

    rubyInput.style.border =
      "1px solid #decbd6";


    const saveRubyButton =
      document.createElement(
        "button"
      );

    saveRubyButton.type =
      "button";

    saveRubyButton.textContent =
      "Save Ruby Price";

    saveRubyButton.className =
      "led-action-button";

    saveRubyButton.style.marginTop =
      "9px";


    saveRubyButton.addEventListener(
      "click",
      async function () {

        const rawValue =
          rubyInput.value.trim();


        /*
         * EMPTY RUBY PRICE
         *
         * Empty means:
         * - no Ruby charge
         * - chapter remains unlocked
         */

        if (rawValue === "") {

          saveRubyButton.disabled =
            true;


          const {
            error
          } =
            await supabaseClient
              .from("chapters")
              .update({
                unlock_cost: null,
                is_locked: false,
                updated_at:
                  new Date().toISOString()
              })
              .eq(
                "id",
                chapter.id
              );


          saveRubyButton.disabled =
            false;


          if (error) {

            console.error(
              "CLEAR CHAPTER RUBY PRICE ERROR:",
              error
            );

            alert(
              "The Ruby price could not be cleared."
            );

            return;
          }


          chapter.unlock_cost =
            null;

          chapter.is_locked =
            false;


          alert(
            "Ruby price cleared. This chapter is now free."
          );


          openBookReview(
            currentReviewBook
          );

          return;
        }


        const rubyPrice =
          Number(
            rawValue
          );


        if (
          !Number.isInteger(
            rubyPrice
          ) ||
          rubyPrice <= 0
        ) {

          alert(
            "Enter a valid Ruby amount greater than zero."
          );

          return;
        }


        saveRubyButton.disabled =
          true;


        const {
          error
        } =
          await supabaseClient
            .from("chapters")
            .update({
              unlock_cost:
                rubyPrice,

              is_locked:
                true,

              updated_at:
                new Date().toISOString()
            })
            .eq(
              "id",
              chapter.id
            );


        saveRubyButton.disabled =
          false;


        if (error) {

          console.error(
            "SAVE CHAPTER RUBY PRICE ERROR:",
            error
          );

          alert(
            "The Ruby price could not be saved."
          );

          return;
        }


        chapter.unlock_cost =
          rubyPrice;

        chapter.is_locked =
          true;


        alert(
          "Ruby price saved. This chapter is now locked."
        );


        openBookReview(
          currentReviewBook
        );

      }
    );


    rubyControl.appendChild(
      rubyLabel
    );

    rubyControl.appendChild(
      rubyInput
    );

    rubyControl.appendChild(
      saveRubyButton
    );


    /* =================================================
       REVIEW ACTIONS
    ================================================= */

    const actions =
      document.createElement(
        "div"
      );

    actions.style.display =
      "flex";

    actions.style.flexWrap =
      "wrap";

    actions.style.gap =
      "8px";

    actions.style.marginTop =
      "15px";


    /* =================================================
       APPROVE CHAPTER BUTTON
    ================================================= */

    const approveChapterButton =
      document.createElement(
        "button"
      );

    approveChapterButton.type =
      "button";

    approveChapterButton.textContent =
      "Approve Chapter";

    approveChapterButton.className =
      "led-action-button";


    approveChapterButton.addEventListener(
      "click",
      async function () {

        if (
          chapter.status ===
          "approved"
        ) {

          alert(
            "This chapter is already approved."
          );

          return;
        }


        const confirmed =
          confirm(
            "Approve Chapter " +
            (
              chapter.chapter_number ??
              ""
            ) +
            "?"
          );


        if (!confirmed) {
          return;
        }


        approveChapterButton.disabled =
          true;

        rejectChapterButton.disabled =
          true;


        const now =
          new Date().toISOString();


        const {
          error
        } =
          await supabaseClient
            .from("chapters")
            .update({

              status:
                "approved",

              reviewed_at:
                now,

              reviewed_by:
                session.user.id,

              published_at:
                now,

              updated_at:
                now

            })
            .eq(
              "id",
              chapter.id
            );


        if (error) {

          console.error(
            "CHAPTER APPROVAL ERROR:",
            error
          );


          alert(
            "The chapter could not be approved."
          );


          approveChapterButton.disabled =
            false;

          rejectChapterButton.disabled =
            false;

          return;
        }


        alert(
          "Chapter approved."
        );


        openBookReview(
          currentReviewBook
        );

      }
    );


    /* =================================================
       REJECT CHAPTER BUTTON
    ================================================= */

    const rejectChapterButton =
      document.createElement(
        "button"
      );

    rejectChapterButton.type =
      "button";

    rejectChapterButton.textContent =
      "Reject Chapter";

    rejectChapterButton.className =
      "led-action-button";


    rejectChapterButton.style.background =
      "#8b4055";


    rejectChapterButton.addEventListener(
      "click",
      async function () {

        const confirmed =
          confirm(
            "Reject Chapter " +
            (
              chapter.chapter_number ??
              ""
            ) +
            "?"
          );


        if (!confirmed) {
          return;
        }


        approveChapterButton.disabled =
          true;

        rejectChapterButton.disabled =
          true;


        const now =
          new Date().toISOString();


        const {
          error
        } =
          await supabaseClient
            .from("chapters")
            .update({

              status:
                "rejected",

              reviewed_at:
                now,

              reviewed_by:
                session.user.id,

              updated_at:
                now

            })
            .eq(
              "id",
              chapter.id
            );


        if (error) {

          console.error(
            "CHAPTER REJECTION ERROR:",
            error
          );


          alert(
            "The chapter could not be rejected."
          );


          approveChapterButton.disabled =
            false;

          rejectChapterButton.disabled =
            false;

          return;
        }


        alert(
          "Chapter rejected."
        );


        openBookReview(
          currentReviewBook
        );

      }
    );


    actions.appendChild(
      approveChapterButton
    );

    actions.appendChild(
      rejectChapterButton
    );


    /* =================================================
       ADD EVERYTHING TO CHAPTER CARD
    ================================================= */

    card.appendChild(
      heading
    );

    card.appendChild(
      meta
    );

    card.appendChild(
      content
    );

    card.appendChild(
      rubyControl
    );

    card.appendChild(
      actions
    );


    chapters.appendChild(
      card
    );

  }
);

}














const approveChapterButton =
  document.createElement(
    "button"
  );

approveChapterButton.type =
  "button";

approveChapterButton.className =
  "led-action-button";


/* =====================================================
   CHAPTER APPROVAL BUTTON STATE
===================================================== */

if (
  chapter.status ===
    "published"
) {

  approveChapterButton.textContent =
    "✓ Approved";

  approveChapterButton.disabled =
    true;

  approveChapterButton.style.opacity =
    "0.65";

  approveChapterButton.style.cursor =
    "default";

} else {

  approveChapterButton.textContent =
    "Approve Chapter";


  approveChapterButton.addEventListener(
    "click",
    async function () {

      if (!currentReviewBook) {

        alert(
          "No book is currently selected."
        );

        return;
      }


      const confirmed =
        confirm(
          "Approve Chapter " +
          (
            chapter.chapter_number ??
            ""
          ) +
          "?"
        );


      if (!confirmed) {
        return;
      }


      approveChapterButton.disabled =
        true;

      rejectChapterButton.disabled =
        true;


      const now =
        new Date().toISOString();


      const {
        error
      } =
        await supabaseClient
          .from("chapters")
          .update({

            status:
              "published",

            reviewed_at:
              now,

            reviewed_by:
              session.user.id,

            published_at:
              now,

            updated_at:
              now

          })
          .eq(
            "id",
            chapter.id
          );


      if (error) {

        console.error(
          "CHAPTER APPROVAL ERROR:",
          error
        );


        alert(
          "Chapter approval failed:\n\n" +
          (
            error.message ||
            "Unknown error"
          ) +
          "\n\nCode: " +
          (
            error.code ||
            "Unknown"
          )
        );


        approveChapterButton.disabled =
          false;

        rejectChapterButton.disabled =
          false;

        return;
      }


      alert(
        "Chapter approved and published."
      );


      /* =============================================
         RELOAD BOOK REVIEW
      ============================================= */

      openBookReview(
        currentReviewBook
      );

    }
  );

}

















/* =========================================================
   LITDOM EDITOR DASHBOARD — CLEAN UI POLISH
   VISUAL ONLY — DOES NOT CHANGE DATABASE LOGIC
========================================================= */


/* =========================================================
   BOOK LIST
========================================================= */

#led-books {
  display: grid;
  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 16px;
}


/* =========================================================
   BOOK CARD
========================================================= */

.led-book-card {
  position: relative;

  display: grid;

  grid-template-columns:
    82px minmax(0, 1fr);

  grid-template-rows:
    auto auto;

  column-gap: 15px;
  row-gap: 12px;

  margin: 0;

  padding: 15px;

  border-radius: 18px;

  background: #fff;

  border: 1px solid #eee2e8;

  box-shadow:
    0 5px 18px
    rgba(70, 40, 55, .045);

  transition:
    transform .18s ease,
    box-shadow .18s ease,
    border-color .18s ease;
}


.led-book-card:hover {

  transform:
    translateY(-2px);

  border-color:
    #dfcbd6;

  box-shadow:
    0 9px 24px
    rgba(70, 40, 55, .08);
}


/* =========================================================
   COVER
========================================================= */

.led-book-cover {

  grid-column: 1;
  grid-row: 1;

  width: 82px;
  height: 112px;

  border-radius: 11px;

  background-color: #f4e8ee;

  background-size: cover;
  background-position: center;

  box-shadow:
    0 4px 12px
    rgba(60, 35, 50, .10);
}


/* =========================================================
   BOOK INFORMATION
========================================================= */

.led-book-info {

  grid-column: 2;
  grid-row: 1;

  min-width: 0;

  padding-top: 2px;
}


.led-book-info h3 {

  margin: 0 0 7px;

  color: #382731;

  font-size: 16px;

  line-height: 1.25;

  font-weight: 750;

  overflow: hidden;

  display: -webkit-box;

  -webkit-line-clamp: 2;

  -webkit-box-orient: vertical;
}


.led-book-info p {

  margin: 4px 0;

  color: #897681;

  font-size: 12px;

  line-height: 1.35;
}


/* =========================================================
   STATUS
========================================================= */

.led-status {

  margin-top: 8px;

  padding: 5px 9px;

  font-size: 10px;

  letter-spacing: .2px;

  background: #f5e9ef;

  color: #75445e;
}


/* =========================================================
   OPEN REVIEW BUTTON
========================================================= */

.led-review-button {

  grid-column: 1 / -1;
  grid-row: 2;

  width: 100%;

  min-height: 38px;

  padding: 9px 14px;

  border: none;

  border-radius: 11px;

  background:
    linear-gradient(
      135deg,
      #5d334b,
      #713f5b
    );

  color: #fff;

  font-size: 12px;

  font-weight: 750;

  cursor: pointer;

  transition:
    transform .15s ease,
    opacity .15s ease;
}


.led-review-button:hover {

  transform:
    translateY(-1px);

  opacity: .94;
}


/* =========================================================
   REVIEW PANEL
========================================================= */

.led-review-panel {

  width: min(
    760px,
    calc(100% - 24px)
  );

  padding: 27px;

  border-radius: 22px;
}


/* =========================================================
   REVIEW ACTION BUTTONS
========================================================= */

.led-action-button {

  min-height: 40px;

  padding: 9px 15px;

  border: 1px solid #dfcbd6;

  border-radius: 11px;

  background: #fff;

  color: #5d334b;

  font-size: 12px;

  font-weight: 750;

  cursor: pointer;

  transition:
    background .15s ease,
    border-color .15s ease,
    transform .15s ease;
}


.led-action-button:hover {

  background: #faf3f7;

  border-color: #cfaebe;

  transform:
    translateY(-1px);
}


.led-action-button:disabled {

  cursor: default;

  transform: none;

}


/* =========================================================
   PRICE CONTROLS
========================================================= */

.led-price-control {

  margin-top: 18px;

  padding: 17px;

  border-radius: 15px;

  background: #fbf8fa;

  border: 1px solid #eee1e8;
}


.led-price-control label {

  display: block;

  margin-bottom: 8px;

  color: #55414d;

  font-size: 12px;

  font-weight: 750;
}


.led-price-control input {

  width: 100%;

  box-sizing: border-box;

  min-height: 42px;

  margin-bottom: 9px;

  padding: 10px 12px;

  border: 1px solid #decbd5;

  border-radius: 10px;

  background: #fff;

  color: #3e3037;

  font-size: 14px;

  outline: none;
}


.led-price-control input:focus {

  border-color: #a45b82;

  box-shadow:
    0 0 0 3px
    rgba(164, 91, 130, .10);
}


/* =========================================================
   CHAPTER CARDS
========================================================= */

.led-chapter {

  margin-bottom: 12px;

  padding: 16px;

  border-radius: 16px;

  background: #fff;

  border: 1px solid #ebe0e6;

  box-shadow:
    0 3px 12px
    rgba(70, 40, 55, .035);
}


.led-chapter h4 {

  margin-bottom: 9px;

  font-size: 15px;
}


.led-chapter-meta {

  margin-bottom: 12px;
}


.led-chapter-content {

  max-height: 300px;

  padding: 13px;

  border-radius: 10px;

  background: #faf7f9;

  font-size: 13px;

  line-height: 1.65;
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 760px) {

  #led-books {

    grid-template-columns:
      1fr;

  }

}


@media (max-width: 500px) {

  #litdom-editor-dashboard {

    margin: 15px auto;

    padding: 10px;

  }


  .led-section {

    padding: 15px;

    border-radius: 18px;

  }


  .led-book-card {

    grid-template-columns:
      68px minmax(0, 1fr);

    padding: 13px;

  }


  .led-book-cover {

    width: 68px;

    height: 94px;

  }


  .led-book-info h3 {

    font-size: 15px;

  }


  .led-review-button {

    min-height: 40px;

  }


  .led-review-panel {

    width:
      calc(100% - 16px);

    max-height: 92vh;

    padding: 21px 16px;

    border-radius: 19px;

  }

}