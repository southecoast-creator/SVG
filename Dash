.chapter-nav-toggle {
  position: fixed;
  right: 16px;
  bottom: 24px;
  z-index: 99998;
  width: 52px;
  height: 52px;
  border-radius: 50%;
  border: 1px solid rgba(255,210,92,0.3);
  background: linear-gradient(145deg, rgba(31,27,20,0.98), rgba(15,14,12,0.99));
  color: #f5d47b;
  font-size: 20px;
  box-shadow: 0 8px 24px rgba(0,0,0,0.4);
  cursor: pointer;
}

.chapter-nav-drawer {
  position: fixed;
  top: 0; right: 0;
  height: 100%;
  width: min(78vw, 320px);
  z-index: 99999;
  background: linear-gradient(145deg, rgba(31,27,20,0.98), rgba(15,14,12,0.99));
  border-left: 1px solid rgba(255,210,92,0.22);
  transform: translateX(100%);
  transition: transform 240ms cubic-bezier(0.16,1,0.3,1);
  overflow-y: auto;
  padding: 20px 14px;
  box-sizing: border-box;
}
.chapter-nav-drawer.open { transform: translateX(0); }

.chapter-nav-drawer h4 {
  margin: 0 0 14px;
  font-family: Georgia, serif;
  color: #f8e8bd;
  font-size: 16px;
}

.chapter-nav-item {
  display: block;
  width: 100%;
  text-align: left;
  padding: 10px 12px;
  margin-bottom: 6px;
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 10px;
  background: rgba(255,255,255,0.03);
  color: rgba(255,255,255,0.78);
  font-size: 13px;
  cursor: pointer;
}
.chapter-nav-item.active {
  border-color: rgba(255,214,92,0.9);
  background: rgba(255,210,92,0.08);
  color: #f5d47b;
}

.chapter-nav-backdrop {
  position: fixed;
  inset: 0;
  z-index: 99997;
  background: rgba(0,0,0,0.5);
  opacity: 0;
  pointer-events: none;
  transition: opacity 220ms ease;
}
.chapter-nav-backdrop.open { opacity: 1; pointer-events: auto; }














// Give each chapter a jump target
document.querySelectorAll(".reader-chapter").forEach(function (el, i) {
  el.id = "chapter-" + chapters[i].chapter_number;
});

// Build the nav UI
const backdrop = document.createElement("div");
backdrop.className = "chapter-nav-backdrop";

const toggle = document.createElement("button");
toggle.className = "chapter-nav-toggle";
toggle.innerHTML = "☰";

const drawer = document.createElement("div");
drawer.className = "chapter-nav-drawer";
drawer.innerHTML = "<h4>Chapters</h4>";

chapters.forEach(function (chapter) {
  const item = document.createElement("button");
  item.className = "chapter-nav-item";
  item.dataset.chapterNumber = chapter.chapter_number;
  item.textContent = "Ch. " + chapter.chapter_number + (chapter.title ? " — " + chapter.title : "");
  item.addEventListener("click", function () {
    document.getElementById("chapter-" + chapter.chapter_number)
      .scrollIntoView({ behavior: "smooth", block: "start" });
    drawer.classList.remove("open");
    backdrop.classList.remove("open");
  });
  drawer.appendChild(item);
});

function openDrawer() {
  drawer.classList.add("open");
  backdrop.classList.add("open");
}
function closeDrawer() {
  drawer.classList.remove("open");
  backdrop.classList.remove("open");
}
toggle.addEventListener("click", openDrawer);
backdrop.addEventListener("click", closeDrawer);

document.body.appendChild(backdrop);
document.body.appendChild(drawer);
document.body.appendChild(toggle);

// Highlight the chapter currently in view
const navItems = drawer.querySelectorAll(".chapter-nav-item");
const observer = new IntersectionObserver(function (entries) {
  entries.forEach(function (entry) {
    if (entry.isIntersecting) {
      const num = entry.target.id.replace("chapter-", "");
      navItems.forEach(function (btn) {
        btn.classList.toggle("active", btn.dataset.chapterNumber == num);
      });
    }
  });
}, { rootMargin: "-40% 0px -50% 0px" });

document.querySelectorAll(".reader-chapter").forEach(function (el) {
  observer.observe(el);
});

// Jump straight to a chapter if one was passed in the URL
if (startingChapterId) {
  const targetChapter = chapters.find(c => String(c.id) === String(startingChapterId));
  if (targetChapter) {
    setTimeout(function () {
      document.getElementById("chapter-" + targetChapter.chapter_number)
        .scrollIntoView({ block: "start" });
    }, 100);
  }
}