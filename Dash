<!-- CREATE BOOK MODAL -->

<div id="create-book-modal" class="book-modal" style="display:none;">

  <div class="book-modal-box">

    <button id="close-book-modal" class="close-modal" type="button">
      ×
    </button>

    <p class="dashboard-label">NEW BOOK</p>

    <h2 id="book-type-heading">Create Book</h2>

    <form id="create-book-form">

      <label for="book-title">Book title</label>

      <input
        id="book-title"
        type="text"
        placeholder="Enter your book title"
        required
      >

      <label for="book-description">Blurb</label>

      <textarea
        id="book-description"
        placeholder="Tell readers what your book is about"
      ></textarea>

      <label for="book-genre">Genre</label>

      <select id="book-genre">
        <option value="">Select a genre</option>
      </select>

      <div id="fiction-fields"></div>

      <div id="nonfiction-fields"></div>

      <input
        id="selected-book-type"
        type="hidden"
      >

      <button id="save-book-button" type="submit">
        Create Draft
      </button>

      <p id="create-book-message"></p>

    </form>

  </div>

</div>



<div id="fiction-fields">

  <div class="type-field-group">

    <label for="age-rating">Age Rating</label>

    <select id="age-rating">
      <option value="">Select age rating</option>
      <option value="all-ages">All Ages</option>
      <option value="13+">13+</option>
      <option value="16+">16+</option>
      <option value="18+">18+</option>
    </select>

    <label for="fiction-tags">Tags</label>

    <input
      id="fiction-tags"
      type="text"
      placeholder="e.g. romance, billionaire, enemies-to-lovers"
    >

  </div>

</div>

<div id="nonfiction-fields">

  <div class="type-field-group">

    <label for="nonfiction-subgenre">Subgenre / Niche</label>

    <input
      id="nonfiction-subgenre"
      type="text"
      placeholder="e.g. study guide, self-development"
    >

    <label for="nonfiction-audience">Intended Reader</label>

    <input
      id="nonfiction-audience"
      type="text"
      placeholder="Who is this book written for?"
    >

    <label for="nonfiction-content-level">Content Level</label>

    <select id="nonfiction-content-level">
      <option value="">Select content level</option>
      <option value="medium">Medium-content</option>
      <option value="high">High-content</option>
    </select>

    <label for="nonfiction-tags">Tags</label>

    <input
      id="nonfiction-tags"
      type="text"
      placeholder="e.g. anatomy, medical students, study skills"
    >

  </div>

</div>




