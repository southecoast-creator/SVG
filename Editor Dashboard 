            );

          }
        );


        info.appendChild(title);
        info.appendChild(author);
        info.appendChild(genre);
        info.appendChild(status);

        card.appendChild(cover);
        card.appendChild(info);
        card.appendChild(button);

        booksContainer.appendChild(card);

      }
    );
    
    
        /* =====================================================
       OPEN BOOK REVIEW
    ===================================================== */

    async function openBookReview(
      book
    ) {
      
      currentReviewBook = book;

      const title =
        document.getElementById(
          "led-review-title"
        );

      const author =
        document.getElementById(
          "led-review-author"
        );

      const details =
        document.getElementById(
          "led-review-details"
        );

      const chapters =
        document.getElementById(
          "led-review-chapters"
        );


      title.textContent =
        book.title ||
        "Untitled Book";
      
      /* =====================================================
   LOAD SAVED DIAMOND PRICE
===================================================== */

diamondPriceInput.value = "";

if (book.book_id) {

  const {
    count: rubyCount
  } = await supabaseClient
    .from("chapter_unlocks")
    .select("id", { count: "exact", head: true })
    .eq("book_id", book.book_id);

  const {
    count: diamondCount
  } = await supabaseClient
    .from("book_unlocks")
    .select("id", { count: "exact", head: true })
    .eq("book_id", book.book_id);

  addDetail(
    details,
    "Total Rubies Spent (Chapter Unlocks)",
    String(rubyCount || 0)
  );

  addDetail(
    details,
    "Total Diamonds Spent (Book Unlocks)",
    String(diamondCount || 0)
  );

}

if (book.book_id) {

  const {
    data: bookPricing,
    error: bookPricingError
  } =
    await supabaseClient
      .from("books")
      .select(
        "full_book_unlock_cost"
      )
      .eq(
        "id",
        book.book_id
      )
      .maybeSingle();


  if (bookPricingError) {
    
    console.error(
      "BOOK DIAMOND PRICE LOAD ERROR:",
      bookPricingError
    );

  } else if (
    bookPricing &&
    bookPricing.full_book_unlock_cost !== null &&
    bookPricing.full_book_unlock_cost !== undefined
  ) {

    diamondPriceInput.value =
      bookPricing.full_book_unlock_cost;

  }

}


      const authorDetails =
        book.author_details ||
        {};


      author.textContent =
        "Author: " +
        (
          authorDetails.pen_name ||
          authorDetails.full_name ||
          "Unknown author"
        );


      details.innerHTML = "";


      addDetail(
        details,
        "Status",
        book.status ||
        "Not provided"
      );


      addDetail(
        details,
        "Genre",
        book.genre
      );


      addDetail(
        details,
        "Subgenre",
        book.subgenre
      );


      addDetail(
        details,
        "Description",
        book.description
      );


      addDetail(
        details,
        "Book Outline",
        book.book_outline
      );


      addDetail(
        details,
        "Author Name",
        authorDetails.full_name
      );


      addDetail(
        details,
        "Pen Name",
        authorDetails.pen_name
      );
      
      
            addDetail(
        details,
        "Author Bio",
        authorDetails.bio
      );
      
      
      addDetail(
  details,
  "Email",
  authorDetails.email
);

addDetail(
  details,
  "Phone",
  authorDetails.phone
);
      
      
            /* ===================================================
         SUBMITTED PAYOUT INFORMATION
      =================================================== */

      const additionalDetails =
        book.additional_details || {};


      addDetail(
        details,
        "Bank Name",
        additionalDetails.bank_name
      );


      addDetail(
        details,
        "Account Name",
        additionalDetails.account_name
      );


      addDetail(
        details,
        "Account Number",
        additionalDetails.account_number
      );


      chapters.innerHTML =
        "<div class='led-message'>" +
        "Loading chapters..." +
        "</div>";


      reviewPanel.style.display =
        "block";


      /* ===================================================
         LOAD CHAPTERS FOR THIS BOOK
      =================================================== */

      if (!book.book_id) {

        chapters.innerHTML =
          "<div class='led-message'>" +
          "This submission is not connected to a book yet." +
          "</div>";

        return;
      }


      const {
        data: chapterRows,
        error: chapterError
      } =
        await supabaseClient
          .from("chapters")
          .select(
            "id,book_id,chapter_number,title,content,status,word_count,is_locked,unlock_cost,updated_at,created_at,published_at,submitted_at,reviewed_at,reviewed_by,deletion_requested"
          )
          .eq(
            "book_id",
            book.book_id
          )
          .order(
            "chapter_number",
            {
              ascending: true
            }
          );


      if (chapterError) {

        console.error(
          "EDITOR CHAPTER LOAD ERROR:",
          chapterError
        );

        chapters.innerHTML =
          "<div class='led-message'>" +
          "Could not load the chapters for this book." +
          "</div>";

        return;
