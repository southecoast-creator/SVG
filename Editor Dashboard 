booksContainer.innerHTML = "";

// filter out rejected books so they disappear from the dashboard
const visibleBooks = books.filter(function (book) {
  return book.status !== "rejected";
});

if (visibleBooks.length === 0) {
  booksContainer.innerHTML =
    "<div class='led-message'>No book submissions yet.</div>";
} else {

  const rowsWrapper = document.createElement("div");
  rowsWrapper.className = "led-books-rows";

  // chunk into groups of 10
  for (let i = 0; i < visibleBooks.length; i += 10) {

    const chunk = visibleBooks.slice(i, i + 10);

    const rowScroll = document.createElement("div");
    rowScroll.className = "led-book-row-scroll";

    const rowTrack = document.createElement("div");
    rowTrack.className = "led-book-row-track";

    chunk.forEach(function (book) {

      const card = document.createElement("div");
      card.className = "led-book-card";

      const cover = document.createElement("div");
      cover.className = "led-book-cover";

      if (book.cover_url) {
        cover.style.backgroundImage = "url('" + book.cover_url + "')";
      }

      const info = document.createElement("div");
      info.className = "led-book-info";

      const title = document.createElement("h3");
      title.textContent = book.title || "Untitled Book";

      const author = document.createElement("p");
      const authorDetails = book.author_details || {};
      author.textContent =
        "Author: " + (authorDetails.pen_name || authorDetails.full_name || "Unknown");

      const genre = document.createElement("p");
      genre.textContent = "Genre: " + (book.genre || "Not specified");

      const status = document.createElement("span");
      status.className = "led-status";
      status.textContent = book.status || "draft";

      const button = document.createElement("button");
      button.type = "button";
      button.className = "led-review-button";
      button.textContent = "Open Review";

      button.addEventListener("click", function () {
        openBookReview(book);
      });

      info.appendChild(title);
      info.appendChild(author);
      info.appendChild(genre);
      info.appendChild(status);

      card.appendChild(cover);
      card.appendChild(info);
      card.appendChild(button);

      rowTrack.appendChild(card);
    });

    rowScroll.appendChild(rowTrack);
    rowsWrapper.appendChild(rowScroll);
  }

  booksContainer.appendChild(rowsWrapper);
}