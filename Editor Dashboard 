<script>

document.addEventListener(
  "DOMContentLoaded",
  async function () {

    /* =====================================================
       SUPABASE
    ===================================================== */

    const SUPABASE_URL =
      "https://uniecvgkxhcbedppadgx.supabase.co";

    const SUPABASE_KEY =
      "sb_publishable_UhqP7y8Cjyiv8RebOSMUDA_lBj0QuTE";

    const supabaseClient =
      window.supabase.createClient(
        SUPABASE_URL,
        SUPABASE_KEY,
        {
          auth: {
            persistSession: true,
            autoRefreshToken: true,
            detectSessionInUrl: true
          }
        }
      );
    
    
        /* =====================================================
       ELEMENTS
    ===================================================== */

    const booksContainer =
      document.getElementById(
        "led-books"
      );

    const bookCount =
      document.getElementById(
        "led-book-count"
      );

    const reviewPanel =
      document.getElementById(
        "led-review-panel"
      );

    const closeReview =
      document.getElementById(
        "led-close-review"
      );
    
    const approveBookButton =
  document.getElementById(
    "led-approve-book"
  );

const rejectBookButton =
  document.getElementById(
    "led-reject-book"
  );

const diamondPriceInput =
  document.getElementById(
    "led-book-diamond-price"
  );

const saveDiamondPriceButton =
  document.getElementById(
    "led-save-diamond-price"
  );

let currentReviewBook = null;


    /* =====================================================
       CHECK LOGIN
    ===================================================== */

    const {
      data: {
        session
      }
    } =
      await supabaseClient.auth.getSession();


    if (!session) {

      booksContainer.innerHTML =
        "<div class='led-message'>" +
        "Please log in to use the Editor Dashboard." +
        "</div>";

      return;
    }


    /* =====================================================
       LOAD ALL BOOK SUBMISSIONS
    ===================================================== */

    booksContainer.innerHTML =
      "<div class='led-message'>" +
      "Loading books..." +
      "</div>";


    const {
      data: submissions,
      error
    } =
      await supabaseClient
        .from("book_submissions")
        .select(
          "id,author_id,book_id,title,description,genre,cover_url,status,created_at,submitted_at,subgenre,book_outline,protagonist,antagonist,additional_details,author_details"
        )
        .order(
          "created_at",
          {
            ascending: false
          }
        );


    if (error) {

      console.error(
        "EDITOR BOOK LOAD ERROR:",
        error
      );
      
            booksContainer.innerHTML =
        "<div class='led-message'>" +
        "Could not load book submissions." +
        "</div>";

      return;
    }


    const books =
      submissions || [];


    bookCount.textContent =
      books.length;


    if (books.length === 0) {

      booksContainer.innerHTML =
        "<div class='led-message'>" +
        "No book submissions yet." +
        "</div>";

      return;
    }


    /* =====================================================
       DISPLAY BOOKS
    ===================================================== */

    booksContainer.innerHTML = "";


    books.forEach(
      function (book) {

        const card =
          document.createElement(
            "div"
          );

        card.className =
          "led-book-card";


        const cover =
          document.createElement(
            "div"
          );

        cover.className =
          "led-book-cover";


        if (book.cover_url) {

          cover.style.backgroundImage =
            "url('" +
            book.cover_url +
            "')";

        }
        
                const info =
          document.createElement(
            "div"
          );

        info.className =
          "led-book-info";


        const title =
          document.createElement(
            "h3"
          );

        title.textContent =
          book.title ||
          "Untitled Book";


        const author =
          document.createElement(
            "p"
          );

        const authorDetails =
          book.author_details ||
          {};

        author.textContent =
          "Author: " +
          (
            authorDetails.pen_name ||
            authorDetails.full_name ||
            "Unknown"
          );


        const genre =
          document.createElement(
            "p"
          );

        genre.textContent =
          "Genre: " +
          (
            book.genre ||
            "Not specified"
          );


        const status =
          document.createElement(
            "span"
          );

        status.className =
          "led-status";

        status.textContent =
          book.status ||
          "draft";


