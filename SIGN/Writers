  async function checkPublicationEligibility(
  book,
  applyButton
) {

  /* =========================
     ALREADY SUBMITTED?
  ========================== */

  const {
    data: existingSubmission,
    error: submissionCheckError
  } =
    await supabaseClient
      .from("book_submissions")
      .select("id,status")
      .eq(
        "book_id",
        book.id
      )
      .limit(1);


  if (submissionCheckError) {

    console.error(
      "PUBLICATION SUBMISSION CHECK ERROR:",
      submissionCheckError
    );

    applyButton.style.display =
      "none";

    return;

  }
    
      /* =========================
     HIDE AFTER SUBMISSION
  ========================== */

  if (
    existingSubmission &&
    existingSubmission.length > 0
  ) {

    applyButton.style.display =
      "none";

    return;

  }


  /* =========================
     ALREADY PUBLISHED?
  ========================== */

  if (
    book.status === "published"
  ) {

    applyButton.style.display =
      "none";

    return;

  }
    
    
      /* =========================
   CHECK TOTAL WORD COUNT
========================= */

const {
  data: bookData,
  error: wordCountError
} = await supabaseClient
  .from("books")
  .select("total_word_count")
  .eq("id", book.id)
  .single();


if (wordCountError) {

  console.error(
    "PUBLICATION WORD COUNT ERROR:",
    wordCountError
  );

  applyButton.style.display =
    "none";

  return;

}


const totalWords =
  Number(
    bookData.total_word_count
  ) || 0;


if (
  totalWords >= 5000
) {

  applyButton.style.display =
    "inline-flex";

} else {

  applyButton.style.display =
    "none";

}

}
  
