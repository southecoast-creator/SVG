  deleteChapterRequest.addEventListener(
  "click",
  async function () {

    if (!editingChapterId) {

      chapterEditorMessage.textContent =
        "Only an existing chapter can be requested for deletion.";

      return;

    }
    
        const confirmed =
      window.confirm(
        "Request deletion of this chapter? The chapter will not be deleted immediately. An editor must approve the deletion."
      );

    if (!confirmed) {
      return;
    }

    deleteChapterRequest.disabled =
      true;

chapterEditorMessage.textContent =
      "Sending deletion request...";


    const {
      error
    } = await supabaseClient
      .from("chapters")
      .update({

        deletion_requested:
          true,

        updated_at:
          new Date().toISOString()

      })
      .eq(
        "id",
        editingChapterId
      );
    
    
        deleteChapterRequest.disabled =
      false;


    if (error) {

      console.error(
        "CHAPTER DELETION REQUEST ERROR:",
        error
      );


return;

    }


    chapterEditorMessage.textContent =
      "Deletion request sent to the editor.";

    await loadChapters(
      managingBookId
    );

  }
);
  
