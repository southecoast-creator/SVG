<div id="author-dashboard">

  <div id="dashboard-loading">
    Loading your dashboard...
  </div>

  <div id="dashboard-content" style="display:none;">

    <div class="dashboard-header">
      <div>
        <p class="dashboard-label">WRITER'S SPACE</p>
        <h1>Author Dashboard</h1>
        <p id="author-name"></p>
      </div>

      <button id="logout-button" type="button">
        Log out
      </button>
    </div>

    <div class="dashboard-actions">

      <button id="create-fiction" type="button">
        <span>＋</span>
        Create Fiction Book
      </button>

      <button id="create-nonfiction" type="button">
        <span>＋</span>
        Create Non-fiction Book
      </button>

    </div>

<section class="my-books">

      <div class="section-heading">
        <h2>My Books</h2>
        <span id="book-count">0 books</span>
      </div>

      <div id="books-list">
        <p class="empty-books">
          You haven't created any books yet.
        </p>
      </div>

    </section>

  </div>

</div>


<!-- CREATE BOOK MODAL -->

<div id="create-book-modal" class="book-modal" style="display:none;">

  <div class="book-modal-box">

    <button id="close-book-modal" class="close-modal" type="button">
      ×
    </button>

    <p
  id="book-modal-label"
class="dashboard-label"
>
  NEW BOOK
</p>

<h2 id="book-type-heading">
  Create Book
</h2>
 
       <form id="create-book-form">

  <label for="book-title">
    Book title
  </label>

  <input
    id="book-title"
    type="text"
    placeholder="Enter your book title"
    required
  >

  <label for="book-description">
    Blurb
  </label>
         
           <textarea
    id="book-description"
    placeholder="Tell readers what your book is about"
  ></textarea>

  <label for="book-genre">
    Genre
  </label>

  <select id="book-genre">
    <option value="">


Select a genre
    </option>
  </select>


  <!-- FICTION -->

  <div id="fiction-fields">

    <div class="type-field-group">

      <label for="age-rating">
        Age Rating
      </label>
      
            <select id="age-rating">
        <option value="">
          Select age rating
        </option>
        <option value="all-ages">
          All Ages
        </option>
        <option value="13+">
          13+
        </option>
        <option value="16+">
          16+
        </option>
        <option value="18+">
          18+
        </option>
      </select>
      
      <div class="type-field-group">

  <label for="fiction-subgenre">
    Subgenre
  </label>


<select id="fiction-subgenre">
    <option value="">
      Select a subgenre
    </option>
  </select>

</div>

      <label for="fiction-tags">
  Story Tags
</label>

<input
  id="fiction-tags"
  type="text"
  placeholder="Select tags below"
  readonly
>

<div id="fiction-tag-chips"></div>

    </div>


    <div class="type-field-group">

      <label>
        Book Cover
      </label>

      <label
        for="fiction-book-cover"
        class="cover-upload-box"
      >

        <span class="cover-upload-icon">

＋
        </span>
        
                <strong>
          Upload Your Book Cover
        </strong>

        <span>
          600 × 800 px • Under 1 MB <br/>WebP/Jpeg 
        </span>

      </label>

      <input
        id="fiction-book-cover"
        type="file"
        accept="image/jpeg,image/webp"
        style="display:none;"
      >

      <p id="fiction-cover-message"></p>
      <img
  id="fiction-cover-preview"
  style="display:none; width:120px; height:160px; object-fit:cover; margin:10px auto; border-radius:8px;"
  alt="Fiction book cover preview"
>

    </div>
    
      </div>


  <!-- NON-FICTION -->

<div id="nonfiction-fields">

    <label for="nonfiction-tags">
      Tags
    </label>

    <input
      id="nonfiction-tags"
      type="text"
      placeholder="e.g. confidence, mindset, personal growth"
    >

    <p>
      Add tags that describe your book. Separate each tag with a comma.
    </p>

    <div id="nonfiction-tag-chips"></div>
    
        <div class="type-field-group">

      <label for="nonfiction-subgenre">
        Subgenre / Niche
      </label>

      <select id="nonfiction-subgenre">
        <option value="">
          Select a niche
        </option>
      </select>

    </div>


    <div class="type-field-group">

<label for="intended-audience">
        Intended Audience
      </label>

      <select id="intended-audience">
        
                <option value="">
          Select intended audience
        </option>

        <option value="13+">
          13+
        </option>

        <option value="16+">
          16+
        </option>

        <option value="18+">
          18+
        </option>

      </select>

    </div>


    <div class="type-field-group">

      <label for="nonfiction-content-level">
        Content Level
      </label>

      <select id="nonfiction-content-level">
        
                <option value="">
          Select content level
        </option>

<option value="medium">
          Medium-content
        </option>

        <option value="high">
          High-content
        </option>

      </select>

    </div>


    <div class="type-field-group">

      <label>
        Book Cover
      </label>

      <label
        for="book-cover"
        class="cover-upload-box"
      >

        <span class="cover-upload-icon">
          ＋
        </span>
        
                <strong>
          Upload Your Book Cover
        </strong>

        <span>
          600 × 800 px • Under 1 MB <br/>WebP/Jpeg 
        </span>

      </label>

      <input
        id="book-cover"
        type="file"
        accept="image/jpeg,image/webp"
        style="display:none;"
      >

      <p id="cover-message"></p>
      <img
  id="cover-preview"
style="display:none; width:120px; height:160px; object-fit:cover; margin:10px auto; border-radius:8px;"
  alt="Non-fiction book cover preview"
>

    </div>

  </div>
         
         
           <input
    id="selected-book-type"
    type="hidden"
  >

  <button
    id="save-book-button"
    type="submit"
  >
    Create Draft
  </button>

  <p id="create-book-message"></p>

</form>
  </div>

</div>

<!-- MANAGE CHAPTERS MODAL -->

<div
  id="manage-chapters-modal"
  class="book-modal"
  style="display:none;"
>

  <div class="book-modal-box manage-chapters-box">

    <button
      id="close-manage-chapters"
      class="close-modal"
      type="button"
    >
      ×
    </button>

    <p class="dashboard-label">
      MANAGE CHAPTERS
    </p>

    <h2 id="manage-chapters-book-title">
      Book Chapters
    </h2>

    <div class="chapter-summary">

      <div class="chapter-summary-item">

        <strong id="chapter-count">
          0
        </strong>
        
                <span>
          Chapters
        </span>

      </div>

      <div class="chapter-summary-item">

        <strong id="chapter-word-count">
          0
        </strong>

        <span>
          Words
        </span>

      </div>

    </div>
    
        <button
      id="create-chapter-button"
      type="button"
      class="book-action-button"
    >
      + New Chapter
    </button>


    <div id="chapters-list">

      <p class="empty-chapters">
        No chapters yet.
      </p>

    </div>

  </div>

</div>
