/* ================================
   LITDOM PROFILE LOGIN GATE
   ================================ */

#profile-login-gate {
  width: min(92%, 460px) !important;
  box-sizing: border-box !important;

  margin: 80px auto !important;
  padding: 45px 35px !important;

  text-align: center !important;

  background:
    linear-gradient(
      145deg,
      #1C1C22 0%,
      #141419 100%
    ) !important;

  border: 1px solid rgba(212, 175, 55, 0.28) !important;

  border-radius: 24px !important;

  box-shadow:
    0 25px 60px rgba(0, 0, 0, 0.45),
    inset 0 1px 0 rgba(255, 248, 231, 0.04) !important;
}


/* Heading */

#profile-login-gate h2 {
  margin: 0 0 14px !important;

  color: #F4D58D !important;

  font-family:
    Georgia,
    "Times New Roman",
    serif !important;

  font-size: 26px !important;

  font-weight: 500 !important;

  line-height: 1.3 !important;
}


/* Description */

#profile-login-gate p {
  margin: 0 auto 28px !important;

  max-width: 330px !important;

  color: #AAA28E !important;

  font-family:
    Arial,
    Helvetica,
    sans-serif !important;

  font-size: 14px !important;

  line-height: 1.7 !important;
}


/* Login button */

#profile-login-gate a {
  display: inline-flex !important;

  align-items: center !important;
  justify-content: center !important;

  min-width: 150px !important;
  min-height: 50px !important;

  box-sizing: border-box !important;

  padding: 0 25px !important;

  background: #D4AF37 !important;

  color: #0B0B0F !important;

  border: 1px solid #D4AF37 !important;

  border-radius: 14px !important;

  text-decoration: none !important;

  font-family:
    Arial,
    Helvetica,
    sans-serif !important;

  font-size: 14px !important;

  font-weight: 700 !important;

  transition:
    0.2s ease !important;
}


/* Hover */

#profile-login-gate a:hover {
  background: #F4D58D !important;

  border-color: #F4D58D !important;

  color: #0B0B0F !important;

  transform: translateY(-2px) !important;

  box-shadow:
    0 10px 25px rgba(212, 175, 55, 0.16) !important;
}


/* Mobile */

@media screen and (max-width: 600px) {

  #profile-login-gate {
    width: calc(100% - 28px) !important;

    margin: 55px auto !important;

    padding: 35px 22px !important;

    border-radius: 20px !important;
  }

  #profile-login-gate h2 {
    font-size: 23px !important;
  }

}