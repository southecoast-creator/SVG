/* =================================
   LITDOM — PROFILE BOOK CARD
   ================================= */

.profile-book-card {
  display: flex !important;
  align-items: center !important;
  gap: 16px !important;

  width: 100% !important;
  max-width: 520px !important;

  padding: 12px !important;
  margin: 12px 0 !important;

  box-sizing: border-box !important;

  background: #17171C !important;
  border: 1px solid #8C7625 !important;
  border-radius: 14px !important;

  text-decoration: none !important;

  transition:
    transform 0.2s ease,
    border-color 0.2s ease,
    box-shadow 0.2s ease !important;
}

.profile-book-card:hover {
  transform: translateY(-2px) !important;
  border-color: #D4AF37 !important;
  box-shadow: 0 8px 25px rgba(212, 175, 55, 0.12) !important;
}


/* BOOK COVER */

.profile-book-cover {
  width: 68px !important;
  height: 92px !important;

  flex: 0 0 68px !important;

  object-fit: cover !important;

  border-radius: 8px !important;

  display: block !important;

  border: 1px solid #8C7625 !important;
}


/* INFORMATION BESIDE COVER */

.profile-book-info {
  min-width: 0 !important;
  flex: 1 !important;
}


/* TITLE */

.profile-book-info h3 {
  margin: 0 0 6px 0 !important;

  color: #F4D58D !important;

  font-size: 17px !important;
  font-weight: 600 !important;

  line-height: 1.3 !important;

  overflow: hidden !important;
  text-overflow: ellipsis !important;
}


/* GENRE */

.profile-book-genre {
  margin: 0 0 5px 0 !important;

  color: #D4AF37 !important;

  font-size: 12px !important;
  font-weight: 500 !important;

  text-transform: uppercase !important;
  letter-spacing: 0.5px !important;
}


/* DESCRIPTION */

.profile-book-description {
  margin: 0 !important;

  color: #FFF8E7 !important;

  font-size: 13px !important;

  line-height: 1.45 !important;

  display: -webkit-box !important;
  -webkit-line-clamp: 2 !important;
  -webkit-box-orient: vertical !important;

  overflow: hidden !important;
}


/* MOBILE */

@media (max-width: 600px) {

  .profile-book-card {
    max-width: 100% !important;
    gap: 12px !important;
    padding: 10px !important;
  }

  .profile-book-cover {
    width: 58px !important;
    height: 80px !important;

    flex-basis: 58px !important;
  }

  .profile-book-info h3 {
    font-size: 15px !important;
  }

  .profile-book-description {
    font-size: 12px !important;
  }

}