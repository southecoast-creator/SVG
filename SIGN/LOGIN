/* =========================================================
   LITDOM AUTHENTICATION PAGE
   Obsidian • Royal Gold • Champagne • Ivory
   CSS ONLY — DO NOT CHANGE YOUR JAVASCRIPT
   ========================================================= */


/* ---------- PAGE ---------- */

#litdom-signup,
#litdom-login,
#litdom-user-area {
  box-sizing: border-box !important;
  font-family: Arial, Helvetica, sans-serif !important;
}


/* ---------- SIGN UP + LOGIN CARDS ---------- */

#litdom-signup,
#litdom-login {
  width: min(92%, 440px) !important;
  margin: 35px auto !important;
  padding: 38px 32px !important;

  box-sizing: border-box !important;

  background:
    linear-gradient(
      145deg,
      #1C1C22 0%,
      #15151A 100%
    ) !important;

  border: 1px solid rgba(212, 175, 55, 0.28) !important;

  border-radius: 24px !important;

  box-shadow:
    0 18px 50px rgba(0, 0, 0, 0.45),
    inset 0 1px 0 rgba(255, 248, 231, 0.035) !important;

  text-align: left !important;
}


/* ---------- HEADINGS ---------- */

#litdom-signup h2,
#litdom-login h2 {
  margin: 0 0 28px !important;

  color: #FFF8E7 !important;

  font-family:
    Georgia,
    "Times New Roman",
    serif !important;

  font-size: 25px !important;

  font-weight: 500 !important;

  line-height: 1.25 !important;

  letter-spacing: -0.3px !important;
}


/* Small gold line under heading */

#litdom-signup h2::after,
#litdom-login h2::after {
  content: "" !important;

  display: block !important;

  width: 42px !important;
  height: 2px !important;

  margin-top: 12px !important;

  background: #D4AF37 !important;

  border-radius: 10px !important;
}


/* =========================================================
   INPUTS
   ========================================================= */

#signup-email,
#signup-password,
#login-email,
#login-password,
#edit-display-name,
#edit-username,
#edit-bio {

  display: block !important;

  width: 100% !important;

  box-sizing: border-box !important;

  -webkit-appearance: none !important;
  appearance: none !important;

  background: #0B0B0F !important;

  color: #FFF8E7 !important;

  border: 1px solid #39362E !important;

  border-radius: 15px !important;

  outline: none !important;

  font-family:
    Arial,
    Helvetica,
    sans-serif !important;

  font-size: 15px !important;

  line-height: 1.4 !important;

  transition:
    border-color 0.2s ease,
    background 0.2s ease,
    box-shadow 0.2s ease,
    transform 0.2s ease !important;
}


/* Regular inputs */

#signup-email,
#signup-password,
#login-email,
#login-password,
#edit-display-name,
#edit-username {

  height: 58px !important;

  padding:
    0 18px !important;

  margin:
    0 0 15px !important;
}


/* Textarea */

#edit-bio {

  min-height: 125px !important;

  padding: 17px 18px !important;

  margin-bottom: 18px !important;

  resize: vertical !important;
}


/* Placeholder */

#signup-email::placeholder,
#signup-password::placeholder,
#login-email::placeholder,
#login-password::placeholder,
#edit-display-name::placeholder,
#edit-username::placeholder,
#edit-bio::placeholder {

  color: #77715F !important;

  opacity: 1 !important;
}


/* INPUT HOVER */

#signup-email:hover,
#signup-password:hover,
#login-email:hover,
#login-password:hover,
#edit-display-name:hover,
#edit-username:hover,
#edit-bio:hover {

  border-color: #6E5D29 !important;

  background: #101015 !important;
}


/* INPUT FOCUS */

#signup-email:focus,
#signup-password:focus,
#login-email:focus,
#login-password:focus,
#edit-display-name:focus,
#edit-username:focus,
#edit-bio:focus {

  border-color: #D4AF37 !important;

  background: #111116 !important;

  box-shadow:
    0 0 0 3px rgba(212, 175, 55, 0.09),
    0 8px 25px rgba(0, 0, 0, 0.25) !important;

  transform: translateY(-1px) !important;
}


/* =========================================================
   BUTTONS
   ========================================================= */

#signup-button,
#login-button,
#save-profile-button,
#logout-button {

  display: block !important;

  width: 100% !important;

  min-height: 56px !important;

  box-sizing: border-box !important;

  -webkit-appearance: none !important;
  appearance: none !important;

  border-radius: 15px !important;

  font-family:
    Arial,
    Helvetica,
    sans-serif !important;

  font-size: 14px !important;

  font-weight: 700 !important;

  letter-spacing: 0.3px !important;

  cursor: pointer !important;

  transition:
    background 0.2s ease,
    border-color 0.2s ease,
    transform 0.2s ease,
    box-shadow 0.2s ease !important;
}


/* Primary buttons */

#signup-button,
#login-button,
#save-profile-button {

  background: #D4AF37 !important;

  color: #0B0B0F !important;

  border:
    1px solid #D4AF37 !important;

  box-shadow:
    0 8px 20px rgba(212, 175, 55, 0.10) !important;
}


/* Primary hover */

#signup-button:hover,
#login-button:hover,
#save-profile-button:hover {

  background: #F4D58D !important;

  border-color: #F4D58D !important;

  transform: translateY(-2px) !important;

  box-shadow:
    0 12px 28px rgba(212, 175, 55, 0.18) !important;
}


/* Primary click */

#signup-button:active,
#login-button:active,
#save-profile-button:active {

  transform: translateY(0) !important;

  box-shadow:
    0 5px 12px rgba(212, 175, 55, 0.10) !important;
}


/* Logout */

#logout-button {

  margin-top: 20px !important;

  background: transparent !important;

  color: #F4D58D !important;

  border:
    1px solid #8C7625 !important;

  box-shadow: none !important;
}


#logout-button:hover {

  background: rgba(212, 175, 55, 0.08) !important;

  border-color: #D4AF37 !important;

  transform: translateY(-1px) !important;
}


/* =========================================================
   STATUS MESSAGES
   ========================================================= */

#signup-message,
#login-message,
#profile-save-message,
#logout-message {

  min-height: 18px !important;

  margin:
    12px 0 0 !important;

  color: #F4D58D !important;

  font-family:
    Arial,
    Helvetica,
    sans-serif !important;

  font-size: 12px !important;

  line-height: 1.5 !important;

  text-align: center !important;
}


/* =========================================================
   DIVIDER
   ========================================================= */

#litdom-signup + hr {

  width: min(80%, 340px) !important;

  margin: 5px auto !important;

  border: 0 !important;

  border-top:
    1px solid rgba(140, 118, 37, 0.25) !important;

  opacity: 1 !important;
}


/* =========================================================
   LOGGED-IN PROFILE AREA
   ========================================================= */

#litdom-user-area {

  width: min(92%, 600px) !important;

  margin: 35px auto !important;

  padding: 38px 32px !important;

  background:
    linear-gradient(
      145deg,
      #1C1C22,
      #15151A
    ) !important;

  border:
    1px solid rgba(212, 175, 55, 0.28) !important;

  border-radius: 24px !important;

  color: #FFF8E7 !important;

  box-shadow:
    0 18px 50px rgba(0, 0, 0, 0.45) !important;
}


#litdom-user-area h2 {

  margin:
    0 0 8px !important;

  color: #F4D58D !important;

  font-family:
    Georgia,
    "Times New Roman",
    serif !important;

  font-size: 26px !important;

  font-weight: 500 !important;
}


#litdom-user-email {

  display: block !important;

  margin-bottom: 25px !important;

  color: #8C7625 !important;

  font-family:
    Arial,
    Helvetica,
    sans-serif !important;

  font-size: 13px !important;
}


/* =========================================================
   PROFILE INFORMATION
   ========================================================= */

#litdom-profile-info {

  margin:
    0 0 30px !important;

  padding:
    18px 20px !important;

  background: #0B0B0F !important;

  border:
    1px solid #302D25 !important;

  border-radius: 16px !important;
}


#litdom-profile-info p {

  margin:
    7px 0 !important;

  color: #AAA28E !important;

  font-family:
    Arial,
    Helvetica,
    sans-serif !important;

  font-size: 13px !important;
}


#litdom-profile-info strong {

  color: #F4D58D !important;

  font-weight: 600 !important;
}


/* =========================================================
   EDIT PROFILE
   ========================================================= */

#litdom-edit-profile h3 {

  margin:
    0 0 20px !important;

  color: #FFF8E7 !important;

  font-family:
    Georgia,
    "Times New Roman",
    serif !important;

  font-size: 20px !important;

  font-weight: 500 !important;
}


/* =========================================================
   MOBILE
   ========================================================= */

@media screen and (max-width: 600px) {

  #litdom-signup,
  #litdom-login,
  #litdom-user-area {

    width: calc(100% - 24px) !important;

    padding: 30px 22px !important;

    border-radius: 20px !important;
  }


  #litdom-signup h2,
  #litdom-login h2 {

    font-size: 22px !important;
  }


  #signup-email,
  #signup-password,
  #login-email,
  #login-password,
  #edit-display-name,
  #edit-username {

    height: 56px !important;
  }


  #signup-button,
  #login-button,
  #save-profile-button,
  #logout-button {

    min-height: 54px !important;
  }
}