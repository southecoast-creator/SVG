<style>
/* =====================================================
   LITDOM AUTH — OBSIDIAN & GOLD
   ===================================================== */

#litdom-auth {
  min-height: 100vh;
  width: 100%;
  box-sizing: border-box;
  background: #0B0B0F;
  padding: 50px 20px;
  display: flex;
  justify-content: center;
  align-items: center;
  font-family: Georgia, "Times New Roman", serif;
}

#litdom-auth .auth-card {
  width: 100%;
  max-width: 430px;
  box-sizing: border-box;
  background: #17171C;
  border: 1px solid rgba(212, 175, 55, 0.25);
  border-radius: 22px;
  padding: 38px 32px;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.45);
}

.litdom-brand {
  text-align: center;
  margin-bottom: 35px;
}

.litdom-brand-name {
  margin: 0;
  color: #D4AF37;
  font-size: 31px;
  font-weight: 600;
  letter-spacing: 5px;
}

.litdom-brand-line {
  width: 45px;
  height: 1px;
  background: #D4AF37;
  margin: 13px auto;
}

.litdom-brand-text {
  margin: 0;
  color: #8C7625;
  font-family: Arial, sans-serif;
  font-size: 12px;
  letter-spacing: 1px;
}


/* HEADINGS */

#litdom-auth h2 {
  margin: 0 0 7px;
  color: #FFF8E7;
  font-size: 24px;
  font-weight: 500;
}

.auth-description {
  margin: 0 0 25px;
  color: #8f8a7b;
  font-family: Arial, sans-serif;
  font-size: 13px;
  line-height: 1.6;
}


/* INPUTS */

.litdom-input {
  position: relative;
  margin-bottom: 17px;
}

.litdom-input input,
.litdom-input textarea {
  display: block;
  width: 100%;
  box-sizing: border-box;

  background: #0B0B0F;
  color: #FFF8E7;

  border: 1px solid #343129;
  border-radius: 13px;

  outline: none;

  font-family: Arial, sans-serif;
  font-size: 14px;

  transition: 0.2s ease;
}

.litdom-input input {
  height: 55px;
  padding: 0 17px;
}

.litdom-input textarea {
  min-height: 110px;
  padding: 17px;
  resize: vertical;
}

.litdom-input input::placeholder,
.litdom-input textarea::placeholder {
  color: #77715f;
}

.litdom-input input:focus,
.litdom-input textarea:focus {
  border-color: #D4AF37;
  background: #101015;
  box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.07);
}


/* BUTTONS */

.litdom-auth-button {
  width: 100%;
  height: 54px;

  border: 0;
  border-radius: 13px;

  background: #D4AF37;
  color: #0B0B0F;

  font-family: Arial, sans-serif;
  font-size: 14px;
  font-weight: 700;

  cursor: pointer;

  transition: 0.2s ease;
}

.litdom-auth-button:hover {
  background: #F4D58D;
  transform: translateY(-1px);
}

.litdom-auth-button:active {
  transform: translateY(0);
}


/* DIVIDER */

.litdom-divider {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 30px 0;
}

.litdom-divider::before,
.litdom-divider::after {
  content: "";
  height: 1px;
  flex: 1;
  background: #302d25;
}

.litdom-divider span {
  color: #8C7625;
  font-family: Arial, sans-serif;
  font-size: 10px;
  letter-spacing: 1.5px;
  text-transform: uppercase;
}


/* MESSAGES */

#signup-message,
#login-message,
#profile-save-message,
#logout-message {
  min-height: 17px;
  margin: 10px 0 0;
  color: #8C7625;
  font-family: Arial, sans-serif;
  font-size: 12px;
  text-align: center;
}


/* USER AREA */

#litdom-user-area {
  width: 100%;
  max-width: 560px;
  box-sizing: border-box;

  background: #17171C;
  border: 1px solid rgba(212, 175, 55, 0.25);
  border-radius: 22px;

  padding: 35px;

  color: #FFF8E7;
}

#litdom-user-area h2 {
  color: #D4AF37;
}

#litdom-user-email {
  color: #8f8a7b;
  font-family: Arial, sans-serif;
  font-size: 13px;
}

#litdom-profile-info {
  background: #0B0B0F;
  border: 1px solid #302d25;
  border-radius: 14px;
  padding: 17px;
  margin: 22px 0 28px;
}

#litdom-profile-info p {
  margin: 8px 0;
  color: #aaa28e;
  font-family: Arial, sans-serif;
  font-size: 13px;
}

#litdom-profile-info strong {
  color: #F4D58D;
}

#litdom-edit-profile h3 {
  color: #FFF8E7;
  font-size: 18px;
  font-weight: 500;
  margin-bottom: 18px;
}

#logout-button {
  margin-top: 20px;
  background: transparent;
  color: #F4D58D;
  border: 1px solid #8C7625;
}


/* MOBILE */

@media (max-width: 480px) {

  #litdom-auth {
    padding: 25px 14px;
  }

  #litdom-auth .auth-card {
    padding: 30px 22px;
    border-radius: 18px;
  }

  .litdom-brand-name {
    font-size: 27px;
  }

}
</style>


<div id="litdom-auth">

  <div class="auth-card">

    <div class="litdom-brand">
      <h1 class="litdom-brand-name">LITDOM</h1>
      <div class="litdom-brand-line"></div>
      <p class="litdom-brand-text">
        STORIES. AUTHORS. WORLDS.
      </p>
    </div>


    <!-- SIGN UP -->

    <div id="litdom-signup">

      <h2>Create your account</h2>

      <p class="auth-description">
        Join Litdom and discover your next world.
      </p>

      <div class="litdom-input">
        <input
          type="email"
          id="signup-email"
          placeholder="Email address"
          autocomplete="email"
        >
      </div>

      <div class="litdom-input">
        <input
          type="password"
          id="signup-password"
          placeholder="Password"
          autocomplete="new-password"
        >
      </div>

      <button
        id="signup-button"
        class="litdom-auth-button"
      >
        Create Account
      </button>

      <p id="signup-message"></p>

    </div>


    <div class="litdom-divider">
      <span>Already a member</span>
    </div>


    <!-- LOGIN -->

    <div id="litdom-login">

      <h2>Welcome back</h2>

      <p class="auth-description">
        Log in to continue your Litdom journey.
      </p>

      <div class="litdom-input">
        <input
          type="email"
          id="login-email"
          placeholder="Email address"
          autocomplete="email"
        >
      </div>

      <div class="litdom-input">
        <input
          type="password"
          id="login-password"
          placeholder="Password"
          autocomplete="current-password"
        >
      </div>

      <button
        id="login-button"
        class="litdom-auth-button"
      >
        Log In
      </button>

      <p id="login-message"></p>

    </div>

  </div>

</div>


<!-- LOGGED-IN USER AREA -->

<div id="litdom-user-area" style="display:none;">

  <h2>Welcome to Litdom! 🎉</h2>

  <p id="litdom-user-email"></p>


  <div id="litdom-profile-info">

    <p>
      <strong>Display name:</strong>
      <span id="profile-display-name">Not set</span>
    </p>

    <p>
      <strong>Username:</strong>
      <span id="profile-username">Not set</span>
    </p>

  </div>


  <div id="litdom-edit-profile">

    <h3>Edit Profile</h3>

    <div class="litdom-input">
      <input
        type="text"
        id="edit-display-name"
        placeholder="Display name"
      >
    </div>

    <div class="litdom-input">
      <input
        type="text"
        id="edit-username"
        placeholder="Username"
      >
    </div>

    <div class="litdom-input">
      <textarea
        id="edit-bio"
        placeholder="Tell readers about yourself"
      ></textarea>
    </div>

    <button
      id="save-profile-button"
      class="litdom-auth-button"
    >
      Save Profile
    </button>

    <p id="profile-save-message"></p>

  </div>


  <button
    id="logout-button"
    class="litdom-auth-button"
  >
    Log Out
  </button>

  <p id="logout-message"></p>

</div>