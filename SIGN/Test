/* =========================================================
   LITDOM — PUBLICATION APPLICATION
   LIGHT BRAND STYLE
========================================================= */

.publication-modal {
  position: fixed;
  inset: 0;
  z-index: 99999;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 20px;

  background: rgba(11, 11, 15, 0.62);

  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);

  overflow-y: auto;
}


/* =========================================================
   MAIN CARD
========================================================= */

.publication-modal-box {
  position: relative;

  width: min(720px, 100%);
  max-height: 92vh;
  overflow-y: auto;

  padding: 38px;

  background:
    linear-gradient(
      145deg,
      #ffffff 0%,
      #fffdf8 55%,
      #fff8e7 100%
    );

  border: 1px solid rgba(212, 175, 55, 0.28);

  border-radius: 28px;

  box-shadow:
    0 30px 80px rgba(11, 11, 15, 0.25),
    0 10px 30px rgba(212, 175, 55, 0.10);

  color: #17171C;

  box-sizing: border-box;

  animation:
    publicationModalIn
    0.28s ease-out;
}


@keyframes publicationModalIn {

  from {
    opacity: 0;
    transform:
      translateY(18px)
      scale(0.98);
  }

  to {
    opacity: 1;
    transform:
      translateY(0)
      scale(1);
  }

}


/* =========================================================
   CLOSE BUTTON
========================================================= */

.publication-close {
  position: absolute;

  top: 18px;
  right: 18px;

  width: 42px;
  height: 42px;

  border: 1px solid #eadfbd;
  border-radius: 50%;

  background: #fff8e7;

  color: #6f5a1c;

  font-size: 25px;
  line-height: 1;

  cursor: pointer;

  transition:
    transform 0.2s ease,
    background 0.2s ease,
    color 0.2s ease,
    border-color 0.2s ease;
}


.publication-close:hover {

  background: #f4d58d;

  color: #17171C;

  border-color: #d4af37;

  transform:
    rotate(8deg)
    scale(1.05);
}


/* =========================================================
   HEADER
========================================================= */

.publication-label {

  margin: 0 0 8px;

  color: #8c7625;

  font-size: 11px;
  font-weight: 800;

  letter-spacing: 2.2px;

  text-transform: uppercase;
}


.publication-modal-box > h2 {

  margin: 0;

  color: #17171C;

  font-size: clamp(28px, 5vw, 38px);

  line-height: 1.15;

  letter-spacing: -0.8px;
}


.publication-book-name {

  margin: 10px 0 25px;

  color: #827969;

  font-size: 15px;
}


/* =========================================================
   BOOK SUMMARY
========================================================= */

.publication-summary {

  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 14px;

  margin-bottom: 32px;
}


.publication-summary > div {

  padding: 17px 18px;

  border-radius: 18px;

  background:
    linear-gradient(
      135deg,
      #fffdf8,
      #fff8e7
    );

  border: 1px solid #eadfbd;
}


.publication-summary span {

  display: block;

  margin-bottom: 5px;

  color: #9a8961;

  font-size: 11px;
  font-weight: 700;

  text-transform: uppercase;

  letter-spacing: 1px;
}


.publication-summary strong {

  color: #3f3517;

  font-size: 16px;
}


/* =========================================================
   SECTION HEADINGS
========================================================= */

.publication-modal-box h3 {

  position: relative;

  margin: 34px 0 8px;

  padding-left: 14px;

  color: #4f4017;

  font-size: 20px;
}


.publication-modal-box h3::before {

  content: "";

  position: absolute;

  left: 0;
  top: 3px;
  bottom: 3px;

  width: 4px;

  border-radius: 10px;

  background:
    linear-gradient(
      180deg,
      #d4af37,
      #8c7625
    );
}


.publication-modal-box h4 {

  margin: 28px 0 15px;

  color: #765f1d;

  font-size: 16px;
}


/* =========================================================
   SECTION NOTES
========================================================= */

.publication-section-note {

  margin: 0 0 20px;

  color: #8c8273;

  font-size: 13px;

  line-height: 1.65;
}


/* =========================================================
   LABELS
========================================================= */

.publication-modal-box form > label,
.publication-modal-box label[for] {

  display: block;

  margin:
    18px 0 7px;

  color: #493f32;

  font-size: 13px;
  font-weight: 700;
}


/* =========================================================
   INPUTS
========================================================= */

.publication-modal-box
input[type="text"],
.publication-modal-box
input[type="email"],
.publication-modal-box
input[type="tel"],
.publication-modal-box
select,
.publication-modal-box
textarea {

  width: 100%;

  box-sizing: border-box;

  border: 1px solid #e6dcc6;

  border-radius: 15px;

  background: #ffffff;

  color: #29251f;

  padding:
    14px 16px;

  font-family: inherit;

  font-size: 14px;

  outline: none;

  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease,
    background 0.2s ease,
    transform 0.2s ease;
}


.publication-modal-box
input[type="text"],
.publication-modal-box
input[type="email"],
.publication-modal-box
input[type="tel"],
.publication-modal-box
select {

  min-height: 50px;
}


.publication-modal-box textarea {

  min-height: 120px;

  resize: vertical;

  line-height: 1.6;
}


.publication-modal-box
input::placeholder,
.publication-modal-box
textarea::placeholder {

  color: #b1a798;
}


/* =========================================================
   FOCUS
========================================================= */

.publication-modal-box
input[type="text"]:focus,
.publication-modal-box
input[type="email"]:focus,
.publication-modal-box
input[type="tel"]:focus,
.publication-modal-box
select:focus,
.publication-modal-box
textarea:focus {

  border-color: #d4af37;

  background: #fffdf8;

  box-shadow:
    0 0 0 4px
    rgba(212, 175, 55, 0.12);

  transform:
    translateY(-1px);
}


/* =========================================================
   FICTION SECTION
========================================================= */

#fiction-publication-fields {

  margin-top: 30px;

  padding: 22px;

  border-radius: 22px;

  background:
    linear-gradient(
      145deg,
      #fffdf8,
      #fff8e7
    );

  border: 1px solid #eadfbd;
}


/* =========================================================
   AGREEMENTS
========================================================= */

.publication-agreements {

  margin-top: 32px;

  padding: 20px;

  border-radius: 20px;

  background: #fffdf9;

  border: 1px solid #e9dfca;
}


.publication-check {

  display: flex !important;

  align-items: flex-start;

  gap: 12px;

  margin: 0 0 15px !important;

  color: #675f52 !important;

  font-size: 13px !important;

  font-weight: 500 !important;

  line-height: 1.55;
}


.publication-check:last-child {

  margin-bottom: 0 !important;
}


.publication-check input[type="checkbox"] {

  flex: 0 0 auto;

  width: 18px;
  height: 18px;

  margin-top: 2px;

  accent-color: #d4af37;

  cursor: pointer;
}


.publication-check span {

  cursor: pointer;
}


/* =========================================================
   SUBMIT BUTTON
========================================================= */

#submit-publication-application {

  width: 100%;

  min-height: 56px;

  margin-top: 28px;

  padding: 15px 22px;

  border: 1px solid #d4af37;

  border-radius: 17px;

  background:
    linear-gradient(
      135deg,
      #d4af37,
      #b89125
    );

  color: #17171C;

  font-family: inherit;

  font-size: 15px;
  font-weight: 800;

  letter-spacing: 0.2px;

  cursor: pointer;

  box-shadow:
    0 12px 24px
    rgba(140, 118, 37, 0.18);

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    filter 0.2s ease;
}


#submit-publication-application:hover {

  transform:
    translateY(-2px);

  box-shadow:
    0 16px 30px
    rgba(140, 118, 37, 0.25);

  filter: brightness(1.04);
}


#submit-publication-application:active {

  transform:
    translateY(0)
    scale(0.99);
}


/* =========================================================
   MESSAGE
========================================================= */

#publication-application-message {

  margin: 15px 0 0;

  padding: 0;

  text-align: center;

  color: #806b35;

  font-size: 13px;

  font-weight: 600;

  line-height: 1.5;
}


/* =========================================================
   SCROLLBAR
========================================================= */

.publication-modal-box::-webkit-scrollbar {

  width: 7px;
}


.publication-modal-box::-webkit-scrollbar-track {

  background: transparent;
}


.publication-modal-box::-webkit-scrollbar-thumb {

  background: #d8c99f;

  border-radius: 20px;
}


.publication-modal-box::-webkit-scrollbar-thumb:hover {

  background: #b99b43;
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

  .publication-modal {

    align-items: flex-start;

    padding: 10px;
  }


  .publication-modal-box {

    width: 100%;

    max-height: 96vh;

    padding: 27px 20px 25px;

    border-radius: 23px;
  }


  .publication-close {

    top: 12px;
    right: 12px;

    width: 38px;
    height: 38px;
  }


  .publication-summary {

    grid-template-columns: 1fr;
  }


  .publication-modal-box > h2 {

    padding-right: 35px;

    font-size: 28px;
  }


  #fiction-publication-fields {

    padding: 17px;
  }
}