const {
  error: bookStatusError
} =
  await supabaseClient
    .from("books")
    .update({

      status:
        "pending",

      submission_status:
        "pending"

    })
    .eq(
      "id",
      submissionResult.data.id
        ? bookId
        : bookId
    );


if (
  bookStatusError
) {

  console.error(
    "SUBMISSION STATUS UPDATE ERROR:",
    bookStatusError
  );

  message.textContent =
    "Your application was submitted, but its review status could not be updated.";

  return;
}