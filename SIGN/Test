const {
  error: bookStatusError
} =
  await supabaseClient
    .from("books")
    .update({

      status:
        "pending",

      submission_status:
        "pending"

    })
    .eq(
      "id",
      submissionResult.data.id
        ? bookId
        : bookId
    );


if (
  bookStatusError
) {

  console.error(
    "SUBMISSION STATUS UPDATE ERROR:",
    bookStatusError
  );

  message.textContent =
    "Your application was submitted, but its review status could not be updated.";

  return;
}









if (!books.length) {

      booksList.innerHTML =
        '<p class="empty-books">You haven\'t created any books yet.</p>';

      return;

    }


    /* =========================
       BATCH: PUBLICATION SUBMISSIONS
       (one query for all books, replaces
       N separate per-book queries)
    ========================= */

    const bookIds =
      books.map(function (b) { return b.id; });

    const {
      data: existingSubmissions,
      error: submissionsError
    } = await supabaseClient
      .from("book_submissions")
      .select("book_id")
      .in("book_id", bookIds);

    if (submissionsError) {
      console.error(
        "PUBLICATION SUBMISSIONS BATCH ERROR:",
        submissionsError
      );
    }

    const submittedBookIds =
      new Set(
        (existingSubmissions || []).map(
          function (s) { return s.book_id; }
        )
      );


    booksList.innerHTML = "";










function setPublicationButtonVisibility(
    book,
    applyButton,
    submittedBookIds
  ) {

    if (submittedBookIds.has(book.id)) {
      applyButton.style.display = "none";
      return;
    }

    if (book.status === "published") {
      applyButton.style.display = "none";
      return;
    }

    const totalWords =
      Number(book.total_word_count) || 0;

    applyButton.style.display =
      totalWords >= 5000
        ? "inline-flex"
        : "none";

  }














