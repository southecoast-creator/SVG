/* =========================
   RESET COVER PREVIEW
   THEN LOAD THIS BOOK'S COVER
========================= */

const fictionCoverInput =
  document.getElementById("fiction-book-cover");

const fictionCoverMessage =
  document.getElementById("fiction-cover-message");

const fictionCoverPreview =
  document.getElementById("fiction-cover-preview");

const nonfictionCoverInput =
  document.getElementById("book-cover");

const nonfictionCoverMessage =
  document.getElementById("cover-message");

const nonfictionCoverPreview =
  document.getElementById("cover-preview");


/* Clear previous book's file selection */

if (fictionCoverInput) {
  fictionCoverInput.value = "";
}

if (nonfictionCoverInput) {
  nonfictionCoverInput.value = "";
}


/* Clear previous preview */

if (fictionCoverPreview) {
  fictionCoverPreview.src = "";
  fictionCoverPreview.style.display = "none";
}

if (nonfictionCoverPreview) {
  nonfictionCoverPreview.src = "";
  nonfictionCoverPreview.style.display = "none";
}

if (fictionCoverMessage) {
  fictionCoverMessage.textContent = "";
}

if (nonfictionCoverMessage) {
  nonfictionCoverMessage.textContent = "";
}


/* Load ONLY the cover belonging to this book */

if (book.book_type === "fiction") {

  if (book.cover_url && fictionCoverPreview) {

    fictionCoverPreview.src =
      book.cover_url;

    fictionCoverPreview.style.display =
      "block";

    if (fictionCoverMessage) {
      fictionCoverMessage.textContent =
        "Current cover";
    }

  }

} else {

  if (book.cover_url && nonfictionCoverPreview) {

    nonfictionCoverPreview.src =
      book.cover_url;

    nonfictionCoverPreview.style.display =
      "block";

    if (nonfictionCoverMessage) {
      nonfictionCoverMessage.textContent =
        "Current cover";
    }

  }

}













/* =========================
   CHECK TOTAL WORD COUNT
========================= */

const {
  data: bookData,
  error: wordCountError
} = await supabaseClient
  .from("books")
  .select("total_word_count")
  .eq("id", book.id)
  .single();


if (wordCountError) {

  console.error(
    "PUBLICATION WORD COUNT ERROR:",
    wordCountError
  );

  applyButton.style.display =
    "none";

  return;

}


const totalWords =
  Number(
    bookData.total_word_count
  ) || 0;


if (
  totalWords >= 5000
) {

  applyButton.style.display =
    "inline-flex";

} else {

  applyButton.style.display =
    "none";

}