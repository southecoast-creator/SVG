/* =========================================================
   LITDOM — CREATE BOOK + CHAPTER WORKSPACE
   Complete dark-brand styling
========================================================= */


/* =========================================================
   MODAL BACKDROP
========================================================= */

.book-modal {
  position: fixed;
  inset: 0;
  z-index: 99998;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 20px;

  background: rgba(11, 11, 15, 0.86);

  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);

  overflow-y: auto;
}


/* =========================================================
   MAIN MODAL
========================================================= */

.book-modal-box {

  position: relative;

  width: min(720px, 100%);

  max-height: 92vh;

  overflow-y: auto;

  padding: 36px;

  box-sizing: border-box;

  background:
    linear-gradient(
      145deg,
      #17171C 0%,
      #121216 55%,
      #0B0B0F 100%
    );

  color: #FFF8E7;

  border: 1px solid rgba(212, 175, 55, 0.24);

  border-radius: 26px;

  box-shadow:
    0 30px 80px rgba(0, 0, 0, .65),
    0 10px 35px rgba(212, 175, 55, .08);

  animation:
    litdomModalIn .25s ease-out;
}


@keyframes litdomModalIn {

  from {
    opacity: 0;
    transform:
      translateY(16px)
      scale(.98);
  }

  to {
    opacity: 1;
    transform:
      translateY(0)
      scale(1);
  }
}


/* =========================================================
   CLOSE BUTTON
========================================================= */

.book-modal .close-modal {

  position: absolute;

  top: 16px;
  right: 16px;

  width: 40px;
  height: 40px;

  border-radius: 50%;

  border: 1px solid rgba(212, 175, 55, .18);

  background: #0B0B0F;

  color: #B9AE9A;

  font-size: 24px;

  line-height: 1;

  cursor: pointer;

  transition:
    .2s ease;
}


.book-modal .close-modal:hover {

  background: #211F18;

  border-color: #D4AF37;

  color: #F4D58D;

  transform: scale(1.05);
}


/* =========================================================
   MODAL HEADINGS
========================================================= */

.book-modal-box h2 {

  margin: 0 0 25px;

  padding-right: 45px;

  color: #FFF8E7;

  font-size: clamp(26px, 5vw, 34px);

  line-height: 1.2;

  letter-spacing: -.6px;
}


.book-modal-box .dashboard-label {

  margin-bottom: 8px;

  color: #F4D58D;

  font-size: 10px;

  font-weight: 900;

  letter-spacing: 2px;
}


/* =========================================================
   FORM LABELS
========================================================= */

#create-book-form label,
.book-modal-box .type-field-group > label,
.book-modal-box > label {

  display: block;

  margin: 19px 0 7px;

  color: #F4D58D;

  font-size: 13px;

  font-weight: 700;

  letter-spacing: .2px;
}


/* =========================================================
   ALL FORM CONTROLS
========================================================= */

#create-book-form input[type="text"],
#create-book-form input[type="number"],
#create-book-form textarea,
#create-book-form select,

.book-modal-box input[type="text"],
.book-modal-box input[type="number"],
.book-modal-box textarea,
.book-modal-box select {

  width: 100%;

  min-height: 50px;

  box-sizing: border-box;

  padding: 13px 15px;

  border: 1px solid #38352D;

  border-radius: 14px;

  outline: none;

  background: #0B0B0F;

  color: #FFF8E7;

  font-family: inherit;

  font-size: 14px;

  transition:
    border-color .2s ease,
    box-shadow .2s ease,
    background .2s ease;
}


#create-book-form textarea,
.book-modal-box textarea {

  min-height: 125px;

  resize: vertical;

  line-height: 1.65;
}


/* =========================================================
   PLACEHOLDERS
========================================================= */

.book-modal-box input::placeholder,
.book-modal-box textarea::placeholder {

  color: #716B60;
}


/* =========================================================
   FOCUS
========================================================= */

.book-modal-box input:focus,
.book-modal-box textarea:focus,
.book-modal-box select:focus {

  border-color: #D4AF37;

  background: #111116;

  box-shadow:
    0 0 0 3px
    rgba(212, 175, 55, .12),
    0 6px 20px
    rgba(0, 0, 0, .15);
}


/* =========================================================
   SELECT OPTIONS
========================================================= */

.book-modal-box select option {

  background: #17171C;

  color: #FFF8E7;
}


/* =========================================================
   FICTION / NON-FICTION CONTAINERS
========================================================= */

#fiction-fields,
#nonfiction-fields {

  margin-top: 27px;

  padding: 21px;

  border-radius: 20px;

  background:
    linear-gradient(
      145deg,
      #17171C,
      #121216
    );

  border: 1px solid rgba(212, 175, 55, .16);

  box-shadow:
    inset 0 1px 0
    rgba(255,255,255,.025);
}


/* =========================================================
   FIELD GROUPS
========================================================= */

.type-field-group {

  margin-top: 20px;
}


/* =========================================================
   STORY TAG INPUT
========================================================= */

#fiction-tags,
#nonfiction-tags {

  background: #0B0B0F;

  border-color: #38352D;
}


/* Read-only tag field */

#fiction-tags[readonly] {

  cursor: default;

  color: #B9AE9A;
}


/* =========================================================
   TAG CHIPS
========================================================= */

#fiction-tag-chips,
#nonfiction-tag-chips {

  display: flex;

  flex-wrap: wrap;

  gap: 7px;

  margin-top: 11px;

  min-height: 4px;
}


#fiction-tag-chips span,
#nonfiction-tag-chips span {

  display: inline-flex;

  align-items: center;

  padding: 6px 10px;

  border-radius: 999px;

  background:
    rgba(212, 175, 55, .10);

  border: 1px solid
    rgba(212, 175, 55, .35);

  color: #F4D58D;

  font-size: 11px;

  font-weight: 700;
}


/* =========================================================
   NON-FICTION DESCRIPTION
========================================================= */

#nonfiction-fields > p {

  margin: 8px 0 18px;

  color: #81796C;

  font-size: 12px;

  line-height: 1.55;
}


/* =========================================================
   COVER UPLOAD
========================================================= */

.cover-upload-box {

  display: flex;

  flex-direction: column;

  align-items: center;

  justify-content: center;

  gap: 8px;

  min-height: 175px;

  padding: 22px;

  box-sizing: border-box;

  border: 2px dashed #6F5D22;

  border-radius: 18px;

  background:
    radial-gradient(
      circle at center,
      #17171C 0%,
      #0B0B0F 75%
    );

  color: #B9AE9A;

  text-align: center;

  cursor: pointer;

  transition:
    border-color .2s ease,
    background .2s ease,
    transform .2s ease,
    box-shadow .2s ease;
}


.cover-upload-box:hover {

  border-color: #D4AF37;

  background:
    radial-gradient(
      circle at center,
      #1D1B18 0%,
      #0B0B0F 75%
    );

  box-shadow:
    0 0 25px
    rgba(212,175,55,.08);

  transform: translateY(-1px);
}


.cover-upload-box strong {

  color: #FFF8E7;

  font-size: 14px;
}


.cover-upload-box > span:last-child {

  color: #81796C;

  font-size: 11px;

  line-height: 1.5;
}


/* =========================================================
   COVER UPLOAD ICON
========================================================= */

.cover-upload-icon {

  display: flex;

  align-items: center;
  justify-content: center;

  width: 45px;
  height: 45px;

  border-radius: 14px;

  background:
    rgba(212,175,55,.12);

  border: 1px solid
    rgba(212,175,55,.28);

  color: #F4D58D;

  font-size: 25px;

  font-weight: 300;
}


/* =========================================================
   COVER PREVIEW
========================================================= */

#fiction-cover-preview,
#cover-preview {

  display: block;

  max-width: 120px;

  border: 1px solid
    rgba(212,175,55,.30);

  box-shadow:
    0 10px 25px rgba(0,0,0,.45);
}


/* =========================================================
   COVER VALIDATION MESSAGE
========================================================= */

#fiction-cover-message,
#cover-message,
#create-book-message {

  color: #B9AE9A;

  font-size: 12px;

  line-height: 1.5;
}


/* =========================================================
   CREATE DRAFT BUTTON
========================================================= */

#save-book-button {

  width: 100%;

  min-height: 54px;

  margin-top: 28px;

  border: 1px solid #D4AF37;

  border-radius: 15px;

  background:
    linear-gradient(
      135deg,
      #D4AF37,
      #A98520
    );

  color: #0B0B0F;

  font-family: inherit;

  font-size: 14px;

  font-weight: 900;

  cursor: pointer;

  box-shadow:
    0 10px 25px
    rgba(212,175,55,.15);

  transition:
    transform .2s ease,
    box-shadow .2s ease,
    filter .2s ease;
}


#save-book-button:hover {

  transform: translateY(-2px);

  filter: brightness(1.07);

  box-shadow:
    0 14px 30px
    rgba(212,175,55,.23);
}


/* =========================================================
   CHAPTER MANAGEMENT
========================================================= */

.manage-chapters-box {

  max-width: 650px;
}


/* Chapter summary */

.chapter-summary {

  display: grid;

  grid-template-columns:
    repeat(2, 1fr);

  gap: 12px;

  margin-bottom: 20px;
}


.chapter-summary-item {

  padding: 17px;

  text-align: center;

  border-radius: 16px;

  background: #0B0B0F;

  border: 1px solid
    rgba(212,175,55,.15);
}


.chapter-summary-item strong {

  display: block;

  margin-bottom: 4px;

  color: #F4D58D;

  font-size: 22px;
}


.chapter-summary-item span {

  color: #81796C;

  font-size: 11px;

  text-transform: uppercase;

  letter-spacing: 1px;
}


/* =========================================================
   CHAPTER LIST
========================================================= */

#chapters-list {

  margin-top: 20px;
}


.empty-chapters {

  padding: 25px;

  border-radius: 16px;

  background: #0B0B0F;

  border: 1px dashed #38352D;

  color: #81796C;

  text-align: center;

  font-size: 13px;
}


/* =========================================================
   CHAPTER EDITOR
========================================================= */

.chapter-editor-box {

  max-width: 820px;
}


/* =========================================================
   CHAPTER TOOLBAR
========================================================= */

.chapter-editor-toolbar {

  display: flex;

  flex-wrap: wrap;

  align-items: center;

  gap: 6px;

  margin-top: 8px;

  padding: 9px;

  border: 1px solid #38352D;

  border-bottom: none;

  border-radius:
    14px 14px 0 0;

  background: #0B0B0F;
}


.chapter-format-button {

  display: flex;

  align-items: center;

  justify-content: center;

  width: 34px;
  height: 32px;

  padding: 0;

  border: 1px solid #38352D;

  border-radius: 8px;

  background: #17171C;

  color: #FFF8E7;

  cursor: pointer;

  transition:
    .18s ease;
}


.chapter-format-button:hover {

  border-color: #D4AF37;

  background: #211F18;

  color: #F4D58D;
}


.chapter-toolbar-divider {

  width: 1px;

  height: 22px;

  margin: 0 3px;

  background: #38352D;
}


/* =========================================================
   CHAPTER CONTENT
========================================================= */

.chapter-content-editor,
#chapter-content {

  min-height: 350px;

  padding: 18px;

  box-sizing: border-box;

  border: 1px solid #38352D;

  border-radius:
    0 0 14px 14px;

  outline: none;

  background: #0B0B0F;

  color: #FFF8E7;

  font-family: inherit;

  font-size: 15px;

  line-height: 1.8;
}


.chapter-content-editor:focus,
#chapter-content:focus {

  border-color: #D4AF37;

  box-shadow:
    0 0 0 3px
    rgba(212,175,55,.10);
}


/* =========================================================
   CHAPTER FOOTER
========================================================= */

.chapter-editor-footer {

  display: flex;

  align-items: center;

  gap: 10px;

  margin-top: 15px;

  flex-wrap: wrap;
}


.chapter-editor-footer > span {

  margin-right: auto;

  color: #81796C;

  font-size: 12px;
}


.chapter-editor-footer strong {

  color: #F4D58D;
}


/* =========================================================
   CHAPTER ACTION BUTTON
========================================================= */

.book-action-button {

  min-height: 42px;

  padding: 10px 16px;

  border: 1px solid #8C7625;

  border-radius: 12px;

  background: #17171C;

  color: #FFF8E7;

  font-family: inherit;

  font-size: 12px;

  font-weight: 800;

  cursor: pointer;

  transition:
    .2s ease;
}


.book-action-button:hover {

  border-color: #D4AF37;

  background: #211F18;

  color: #F4D58D;

  transform: translateY(-1px);
}


/* =========================================================
   DELETE DRAFT
========================================================= */

#delete-chapter-request {

  min-height: 42px;

  padding: 10px 16px;

  border: 1px solid #8F3A3F;

  border-radius: 12px;

  background: transparent;

  color: #F0908C;

  font-family: inherit;

  font-size: 12px;

  font-weight: 800;

  cursor: pointer;

  transition: .2s ease;
}


#delete-chapter-request:hover {

  background: #E5484D;

  border-color: #E5484D;

  color: #0B0B0F;
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

  .book-modal {

    align-items: flex-start;

    padding: 10px;
  }


  .book-modal-box {

    width: 100%;

    max-height: 96vh;

    padding: 27px 19px 24px;

    border-radius: 22px;
  }


  .book-modal-box h2 {

    font-size: 27px;

    padding-right: 35px;
  }


  #fiction-fields,
  #nonfiction-fields {

    padding: 16px;

    border-radius: 18px;
  }


  .chapter-summary {

    gap: 8px;
  }


  .chapter-summary-item {

    padding: 14px 8px;
  }


  .chapter-editor-footer {

    align-items: stretch;

    flex-direction: column;
  }


  .chapter-editor-footer > span {

    margin-right: 0;

    text-align: center;
  }


  .chapter-editor-footer .book-action-button,
  #delete-chapter-request {

    width: 100%;
  }


  .chapter-content-editor,
  #chapter-content {

    min-height: 300px;
  }

}















/* =========================================================
   LITDOM — BOOK COVER UPLOAD
   Soft luxury card / polished uploader
========================================================= */

.cover-upload-box {
  position: relative;

  width: 240px;
  height: 320px;

  margin: 16px auto;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  gap: 11px;

  box-sizing: border-box;

  border: 1px dashed rgba(244, 213, 141, .42);

  border-radius: 20px;

  background:
    radial-gradient(
      circle at 50% 35%,
      rgba(212, 175, 55, .10),
      transparent 42%
    ),
    linear-gradient(
      145deg,
      #1B1B21,
      #111116
    );

  color: #D9CCB3;

  text-align: center;

  cursor: pointer;

  overflow: hidden;

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.035),
    0 12px 30px rgba(0,0,0,.24);

  transition:
    transform .25s ease,
    border-color .25s ease,
    background .25s ease,
    box-shadow .25s ease;
}


/* Soft inner glow */

.cover-upload-box::before {

  content: "";

  position: absolute;

  inset: 10px;

  border:
    1px solid
    rgba(212,175,55,.055);

  border-radius: 14px;

  pointer-events: none;
}


/* Subtle top shine */

.cover-upload-box::after {

  content: "";

  position: absolute;

  left: 18%;
  right: 18%;
  top: 0;

  height: 1px;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(244,213,141,.35),
      transparent
    );

  opacity: .7;

  pointer-events: none;
}


/* Hover */

.cover-upload-box:hover {

  transform: translateY(-3px);

  border-color:
    rgba(212,175,55,.75);

  background:
    radial-gradient(
      circle at 50% 35%,
      rgba(212,175,55,.15),
      transparent 45%
    ),
    linear-gradient(
      145deg,
      #201F24,
      #141419
    );

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.045),
    0 18px 38px rgba(0,0,0,.30),
    0 0 28px rgba(212,175,55,.07);
}


/* =========================================================
   UPLOAD ICON
========================================================= */

.cover-upload-icon {

  position: relative;

  z-index: 2;

  width: 58px;
  height: 58px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin-bottom: 3px;

  border:
    1px solid
    rgba(244,213,141,.28);

  border-radius: 17px;

  background:
    linear-gradient(
      145deg,
      rgba(212,175,55,.17),
      rgba(212,175,55,.07)
    );

  color:
    var(--litdom-champagne);

  font-size: 29px;

  font-weight: 300;

  line-height: 1;

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.08),
    0 8px 20px rgba(0,0,0,.20);

  transition:
    transform .25s ease,
    background .25s ease,
    border-color .25s ease;
}


.cover-upload-box:hover .cover-upload-icon {

  transform:
    translateY(-2px)
    scale(1.04);

  border-color:
    rgba(244,213,141,.50);

  background:
    linear-gradient(
      145deg,
      rgba(212,175,55,.24),
      rgba(212,175,55,.10)
    );
}


/* =========================================================
   UPLOAD TEXT
========================================================= */

.cover-upload-box strong {

  position: relative;

  z-index: 2;

  color:
    var(--litdom-ivory);

  font-size: 14px;

  font-weight: 800;

  letter-spacing: -.1px;
}


.cover-upload-box span:last-child {

  position: relative;

  z-index: 2;

  max-width: 190px;

  color:
    #8F887B;

  font-size: 11px;

  line-height: 1.55;

  opacity: 1;
}


/* =========================================================
   COVER PREVIEW
========================================================= */

#fiction-cover-preview,
#cover-preview {

  display: block;

  width: 120px;
  height: 160px;

  object-fit: cover;

  margin: 14px auto;

  border:
    1px solid
    rgba(212,175,55,.32);

  border-radius: 12px;

  background:
    #0B0B0F;

  box-shadow:
    0 10px 25px rgba(0,0,0,.35),
    0 0 18px rgba(212,175,55,.05);
}


/* =========================================================
   COVER VALIDATION MESSAGE
========================================================= */

#fiction-cover-message,
#cover-message {

  margin: 8px 0 0;

  color:
    #A9A092;

  font-size: 12px;

  line-height: 1.5;

  text-align: center;
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

  .cover-upload-box {

    width: 220px;
    height: 293px;

    border-radius: 18px;
  }

  .cover-upload-icon {

    width: 54px;
    height: 54px;

    border-radius: 15px;

    font-size: 27px;
  }

  .cover-upload-box strong {

    font-size: 13px;
  }

  .cover-upload-box span:last-child {

    font-size: 10.5px;
  }

}