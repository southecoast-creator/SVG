/* =========================================================
   BOOK CARD — PROTECT COVER / BOOKMARK SPACE
========================================================= */

/* Keep the cover column completely separate */
.book-card-header {
  display: grid;
  grid-template-columns: 88px minmax(0, 1fr);
  column-gap: 16px;
  align-items: start;
}

/* Cover stays inside its own lane */
.book-card-cover {
  grid-column: 1;
  grid-row: 1;
}

/* Everything containing the title/details stays in column 2 */
.book-card-info {
  grid-column: 2;
  grid-row: 1;
  min-width: 0;
  overflow: visible;
}

/* Make sure the title can never slide underneath the cover */
.book-card-info h3,
.book-card-info .book-meta,
.book-card-info .book-card-tags,
.book-card-info .book-status {
  max-width: 100%;
}

/* Keep the status/bookmark inside the information column */
.book-card-info .book-status {
  position: static;
  margin-left: 0;
}

/* =========================================================
   NO-COVER CARDS
   The cover lane still exists even when there is no image.
========================================================= */

.book-card-header:has(.book-card-cover[src=""]) .book-card-info,
.book-card-header:not(:has(.book-card-cover)) .book-card-info {
  grid-column: 2;
}

/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

  .book-card-header {
    grid-template-columns: 76px minmax(0, 1fr);
    column-gap: 14px;
  }

}