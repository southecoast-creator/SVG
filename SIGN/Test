if (payRubyBtn) {
  payRubyBtn.disabled = true;
  payRubyBtn.textContent = "Processing...";

  const { data, error } = await litdomSupabase
    .rpc("unlock_chapter_with_rubies", {
      p_chapter_id: chapter.id
    });

  payRubyBtn.disabled = false;
  payRubyBtn.textContent = `Pay ${chapter.unlock_cost} Rubies`;

  if (error) {
    console.error("Ruby unlock error:", error);

    if (error.message && error.message.includes("Insufficient Rubies")) {
      chapterContent.innerHTML = `
        <div class="chapter-lock-blocker" style="
          padding: 32px 20px;
          text-align: center;
          background: #0b0b0f;
          border-radius: 16px;
          border: 1px solid #8c7625;
        ">
          <p style="
            font-size: 17px;
            margin-bottom: 14px;
            font-weight: 600;
          ">
            Your Ruby balance is not enough to unlock this chapter.
          </p>

          <p style="
            font-size: 14px;
            margin-bottom: 20px;
            color: #f4d58d;
          ">
            You need ${chapter.unlock_cost} Rubies to continue.
          </p>

          <button
            type="button"
            class="check-wallet-button"
            style="
              width: 100%;
              max-width: 320px;
              padding: 13px 20px;
              border: none;
              border-radius: 10px;
              background: #d4af37;
              color: #111;
              font-size: 15px;
              font-weight: 600;
              cursor: pointer;
            "
          >
            Check My Wallet Balance
          </button>
        </div>
      `;

      return;
    }

    alert("Unable to unlock this chapter. Please try again.");
    return;
  }

  if (data === true) {
    chapterContent.innerHTML = chapter.content || "";
    return;
  }

  alert("The chapter could not be unlocked. Please try again.");
  return;
}