/* =========================================================
   LITDOM — PROPER CENTERED MODAL SYSTEM
========================================================= */

.book-modal {
  position: fixed;
  inset: 0;
  z-index: 99999;

  display: none;

  align-items: center;
  justify-content: center;

  width: 100%;
  height: 100%;

  padding: 20px;

  box-sizing: border-box;

  background: rgba(5, 5, 8, .82);

  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);

  overflow-y: auto;
}

/* The modal itself */
.book-modal-box {
  position: relative;

  width: min(560px, 94vw);
  max-height: 90vh;

  box-sizing: border-box;

  padding: 30px;

  overflow-y: auto;

  background:
    linear-gradient(
      145deg,
      #1A1A20,
      #111116
    );

  border:
    1px solid
    rgba(212,175,55,.24);

  border-radius: 24px;

  color: var(--litdom-ivory);

  box-shadow:
    0 30px 80px rgba(0,0,0,.60),
    0 0 40px rgba(212,175,55,.07);

  animation:
    litdomModalIn .22s ease-out;
}

@keyframes litdomModalIn {
  from {
    opacity: 0;
    transform: translateY(10px) scale(.98);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}