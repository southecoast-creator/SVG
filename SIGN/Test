await loadBooks();


  /* =========================
     DASHBOARD TABS
  ========================= */

  const dashboardTabs =
    document.querySelectorAll(".dashboard-tab");

  const tabPanels = {
    mybooks: document.getElementById("tab-mybooks"),
    insights: document.getElementById("tab-insights"),
    calendar: document.getElementById("tab-calendar")
  };

  let insightsInitialized = false;
  let calendarInitialized = false;

  dashboardTabs.forEach(function (tabButton) {

    tabButton.addEventListener("click", function () {

      dashboardTabs.forEach(function (btn) {
        btn.classList.remove("active");
      });

      tabButton.classList.add("active");

      Object.keys(tabPanels).forEach(function (key) {
        tabPanels[key].classList.remove("active");
      });

      const target = tabButton.dataset.tab;

      tabPanels[target].classList.add("active");

      if (target === "insights" && !insightsInitialized) {
        insightsInitialized = true;
        initInsightsTab();
      }

      if (target === "calendar" && !calendarInitialized) {
        calendarInitialized = true;
        initCalendarTab();
      }

    });

  });


  /* =========================
     INSIGHTS & EARNINGS TAB
  ========================= */

  const insightsBookSelect =
    document.getElementById("insights-book-select");

  const insightsLikes =
    document.getElementById("insights-likes");

  const insightsReads =
    document.getElementById("insights-reads");

  const insightsFollowers =
    document.getElementById("insights-followers");

  const insightsEarnings =
    document.getElementById("insights-earnings");

  const insightsMessage =
    document.getElementById("insights-message");

  function initInsightsTab() {

    insightsBookSelect.innerHTML = "";

    if (!authorBooksCache.length) {

      insightsBookSelect.innerHTML =
        '<option value="">No books yet</option>';

      return;

    }

    authorBooksCache.forEach(function (book) {

      const option =
        document.createElement("option");

      option.value = book.id;
      option.textContent = book.title;

      insightsBookSelect.appendChild(option);

    });

    insightsBookSelect.addEventListener(
      "change",
      function () {

        loadInsightsForBook(insightsBookSelect.value);

      }
    );

    loadFollowerCount();

    loadInsightsForBook(insightsBookSelect.value);

  }

  async function loadFollowerCount() {

    const {
      count,
      error
    } = await supabaseClient
      .from("follows")
      .select("id", { count: "exact", head: true })
      .eq("following_id", session.user.id);

    if (error) {

      console.error("FOLLOWER COUNT ERROR:", error);

      insightsFollowers.textContent = "—";

      return;

    }

    insightsFollowers.textContent =
      (count || 0).toLocaleString();

  }

  async function loadInsightsForBook(bookId) {

    if (!bookId) {
      return;
    }

    insightsMessage.textContent =
      "Loading insights...";

    insightsLikes.textContent = "—";
    insightsReads.textContent = "—";
    insightsEarnings.textContent = "—";


    const {
      count: readCount,
      error: readError
    } = await supabaseClient
      .from("book_reads")
      .select("id", { count: "exact", head: true })
      .eq("book_id", bookId);

    if (readError) {
      console.error("READ COUNT ERROR:", readError);
    }

    insightsReads.textContent =
      (readCount || 0).toLocaleString();


    const {
      data: bookChapters,
      error: chaptersError
    } = await supabaseClient
      .from("chapters")
      .select("id")
      .eq("book_id", bookId);

    if (chaptersError) {

      console.error("CHAPTERS FOR LIKES ERROR:", chaptersError);

      insightsLikes.textContent = "0";

    } else {

      const chapterIds =
        bookChapters.map(function (c) { return c.id; });

      if (!chapterIds.length) {

        insightsLikes.textContent = "0";

      } else {

        const {
          count: likeCount,
          error: likeError
        } = await supabaseClient
          .from("chapter_likes")
          .select("id", { count: "exact", head: true })
          .in("chapter_id", chapterIds);

        if (likeError) {
          console.error("LIKE COUNT ERROR:", likeError);
        }

        insightsLikes.textContent =
          (likeCount || 0).toLocaleString();

      }

    }


    const {
      data: bookUnlocks,
      error: bookUnlocksError
    } = await supabaseClient
      .from("book_unlocks")
      .select("monetary_value")
      .eq("book_id", bookId);

    const {
      data: chapterUnlocks,
      error: chapterUnlocksError
    } = await supabaseClient
      .from("chapter_unlocks")
      .select("monetary_value")
      .eq("book_id", bookId);

    if (bookUnlocksError) {
      console.error("BOOK UNLOCKS ERROR:", bookUnlocksError);
    }

    if (chapterUnlocksError) {
      console.error("CHAPTER UNLOCKS ERROR:", chapterUnlocksError);
    }

    const totalEarnings =
      (bookUnlocks || []).reduce(function (sum, row) {
        return sum + (Number(row.monetary_value) || 0);
      }, 0) +
      (chapterUnlocks || []).reduce(function (sum, row) {
        return sum + (Number(row.monetary_value) || 0);
      }, 0);

    insightsEarnings.textContent =
      "\u20A6" + totalEarnings.toLocaleString();

    insightsMessage.textContent = "";

  }


  /* =========================
     CALENDAR TAB
  ========================= */

  const calendarGrid =
    document.getElementById("calendar-grid");

  const calendarMonthLabel =
    document.getElementById("calendar-month-label");

  const calendarPrev =
    document.getElementById("calendar-prev");

  const calendarNext =
    document.getElementById("calendar-next");

  let calendarViewDate = new Date();

  function initCalendarTab() {

    calendarPrev.addEventListener("click", function () {

      calendarViewDate.setMonth(calendarViewDate.getMonth() - 1);

      renderCalendar();

    });

    calendarNext.addEventListener("click", function () {

      calendarViewDate.setMonth(calendarViewDate.getMonth() + 1);

      renderCalendar();

    });

    renderCalendar();

  }

  async function renderCalendar() {

    const year = calendarViewDate.getFullYear();

    const month = calendarViewDate.getMonth();

    const monthNames = [
      "January", "February", "March", "April", "May", "June",
      "July", "August", "September", "October", "November", "December"
    ];

    calendarMonthLabel.textContent =
      monthNames[month] + " " + year;

    calendarGrid.innerHTML =
      "<p>Loading...</p>";

    const bookIds =
      authorBooksCache.map(function (b) { return b.id; });

    let updatedDates = new Set();

    if (bookIds.length) {

      const monthStart =
        new Date(year, month, 1).toISOString();

      const monthEnd =
        new Date(year, month + 1, 1).toISOString();

      const {
        data: monthChapters,
        error: monthChaptersError
      } = await supabaseClient
        .from("chapters")
        .select("published_at")
        .in("book_id", bookIds)
        .not("published_at", "is", null)
        .gte("published_at", monthStart)
        .lt("published_at", monthEnd);

      if (monthChaptersError) {

        console.error("CALENDAR CHAPTERS ERROR:", monthChaptersError);

      } else {

        (monthChapters || []).forEach(function (chapter) {

          const day =
            new Date(chapter.published_at).getDate();

          updatedDates.add(day);

        });

      }

    }

    calendarGrid.innerHTML = "";

    const daysInMonth =
      new Date(year, month + 1, 0).getDate();

    const firstWeekday =
      new Date(year, month, 1).getDay();

    for (let i = 0; i < firstWeekday; i++) {

      const blank =
        document.createElement("div");

      blank.className = "calendar-cell empty";

      calendarGrid.appendChild(blank);

    }

    for (let day = 1; day <= daysInMonth; day++) {

      const cell =
        document.createElement("div");

      cell.className = "calendar-cell";

      if (updatedDates.has(day)) {

        cell.classList.add("updated");

      }

      cell.textContent = day;

      calendarGrid.appendChild(cell);

    }

  }


