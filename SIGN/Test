/* =========================
   DELETE BOOK BUTTON
========================= */

const submissionStatus =
  submissionStatusByBookId[book.id];

const canDelete =
  !submittedBookIds.has(book.id) ||
  submissionStatus === "rejected";

if (canDelete && book.status !== "published") {

  const deleteBookButton =
    document.createElement("button");

  deleteBookButton.type = "button";

  deleteBookButton.className =
    "book-action-button";

  deleteBookButton.textContent =
    "Delete Book";

  deleteBookButton.style.color = "#F0908C";

  deleteBookButton.addEventListener(
    "click",
    async function () {

      const confirmed =
        confirm(
          "Delete \"" + book.title + "\"? This cannot be undone."
        );

      if (!confirmed) {
        return;
      }

      deleteBookButton.disabled = true;

      const {
        error: deleteError
      } = await supabaseClient
        .from("books")
        .delete()
        .eq("id", book.id);

      if (deleteError) {

        console.error("BOOK DELETE ERROR:", deleteError);

        alert(
          "Could not delete this book.\n\nError: " +
          (deleteError.message || "Unknown") +
          "\n\nCode: " +
          (deleteError.code || "Unknown")
        );

        deleteBookButton.disabled = false;

        return;

      }

      await loadBooks();

    }
  );

  actions.appendChild(deleteBookButton);

}


card.appendChild(actions);