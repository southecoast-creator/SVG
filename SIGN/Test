<!-- ============================================================
     LITDOM APP-SHELL SNIPPET
     Paste this ENTIRE block once, right before </body> in your
     Blogger theme (Theme → Edit HTML → search for </body>,
     paste just above it, then Save).

     BEFORE PASTING: replace the 5 placeholder URLs below
     (search for "REPLACE-WITH") with your real Blogger page URLs.
     ============================================================ -->

<style>
  /* Reserve space at the bottom of every page so content never
     hides behind the fixed nav bar */
  body{
    padding-bottom: 64px;
  }

  /* ---------- BOTTOM NAV BAR ---------- */
  #litdom-bottom-nav{
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 60px;
    display: flex;
    justify-content: space-around;
    align-items: center;
    background: #1d1d1d;              /* swap for your obsidian bg */
    border-top: 1px solid rgba(212,175,55,0.25); /* gold hairline */
    z-index: 9999;
  }
  .litdom-tab{
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    flex: 1;
    height: 100%;
  }
  .litdom-tab svg{
    width: 24px;
    height: 24px;
    fill: none;
    stroke: #9a9a9a;              /* inactive outline color */
    stroke-width: 1.8;
  }
  .litdom-tab span{
    font-size: 10px;
    margin-top: 3px;
    color: #9a9a9a;
    font-family: Roboto, sans-serif;
  }
  /* ACTIVE state: filled icon + gold color */
  .litdom-tab.active svg{
    fill: #d4af37;
    stroke: #d4af37;
  }
  .litdom-tab.active span{
    color: #d4af37;
    font-weight: 700;
  }

  /* ---------- HEADER / LOGO AREA ---------- */
  /* Hides Blogger's default plain-text blog title */
  .Header .title, .Header h1{
    display: none !important;
  }
  #litdom-app-header{
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 14px 0 10px;
    background: #000;
  }
  #litdom-app-header img{
    height: 34px;      /* adjust to taste */
  }

  /* ---------- PAGE / POST TITLE REDESIGN ---------- */
  /* Makes individual post/page titles smaller + more elegant,
     app-like, instead of Blogger's oversized default */
  .post-title, h3.post-title{
    font-family: 'Playfair Display', serif !important;
    font-size: 18px !important;
    font-weight: 700 !important;
    letter-spacing: 0.2px;
    color: #f5f0e6 !important;   /* ivory */
    margin: 10px 0 !important;
  }

  /* ---------- FOOTER ---------- */
  #litdom-footer{
    text-align: center;
    padding: 24px 16px 80px;   /* extra bottom padding clears the nav bar */
    background: #000;
    color: #7a7a7a;
    font-family: Roboto, sans-serif;
    font-size: 12px;
  }
  #litdom-footer img{
    height: 22px;
    margin-bottom: 8px;
    opacity: 0.85;
  }
  #litdom-footer a{
    color: #d4af37;
    text-decoration: none;
  }
</style>

<!-- APP HEADER (put your logo image URL in) -->
<div id="litdom-app-header">
  <a href="/" aria-label="Litdom Home">
    <img src="REPLACE-WITH-YOUR-LOGO-IMAGE-URL" alt="Litdom"/>
  </a>
</div>

<!-- BOTTOM NAV -->
<nav id="litdom-bottom-nav">

  <a class="litdom-tab" data-match="REPLACE-WITH-HOME-URL" href="REPLACE-WITH-HOME-URL">
    <svg viewBox="0 0 24 24"><path d="M3 11.5L12 4l9 7.5M5 10v9a1 1 0 001 1h4v-6h4v6h4a1 1 0 001-1v-9"/></svg>
    <span>Home</span>
  </a>

  <a class="litdom-tab" data-match="REPLACE-WITH-FICTION-URL" href="REPLACE-WITH-FICTION-URL">
    <svg viewBox="0 0 24 24"><path d="M4 4.5A2.5 2.5 0 016.5 2H20v17H6.5A2.5 2.5 0 004 16.5v-12z"/><path d="M4 16.5A2.5 2.5 0 016.5 19H20"/></svg>
    <span>Fiction</span>
  </a>

  <a class="litdom-tab" data-match="REPLACE-WITH-NONFICTION-URL" href="REPLACE-WITH-NONFICTION-URL">
    <svg viewBox="0 0 24 24"><rect x="4" y="3" width="16" height="18" rx="1.5"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>
    <span>Non-fiction</span>
  </a>

  <a class="litdom-tab" data-match="REPLACE-WITH-WALLET-URL" href="REPLACE-WITH-WALLET-URL">
    <svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18"/><circle cx="16.5" cy="14" r="1.2"/></svg>
    <span>Wallet</span>
  </a>

  <a class="litdom-tab" data-match="REPLACE-WITH-PROFILE-URL" href="REPLACE-WITH-PROFILE-URL">
    <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.2"/><path d="M5 20c0-3.5 3.1-6 7-6s7 2.5 7 6"/></svg>
    <span>Profile</span>
  </a>

</nav>

<!-- FOOTER -->
<div id="litdom-footer">
  <img src="REPLACE-WITH-YOUR-LOGO-IMAGE-URL" alt="Litdom"/>
  <p>&#169; <span id="litdom-year"></span> Litdom. All rights reserved.</p>
</div>

<script>
(function(){
  // Auto-highlight the active tab based on current page URL
  var current = window.location.href.split('?')[0].replace(/\/$/, '');
  var tabs = document.querySelectorAll('.litdom-tab');
  var bestMatch = null;
  var bestLen = -1;

  tabs.forEach(function(tab){
    var match = (tab.getAttribute('data-match') || '').replace(/\/$/, '');
    if (match && current.indexOf(match) === 0 && match.length > bestLen){
      bestMatch = tab;
      bestLen = match.length;
    }
  });
  if (bestMatch){ bestMatch.classList.add('active'); }

  // Footer year
  var yearEl = document.getElementById('litdom-year');
  if (yearEl){ yearEl.textContent = new Date().getFullYear(); }
})();
</script>
