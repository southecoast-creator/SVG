/* =========================================================
   BOOK CARD — KEEP TEXT CLEAR OF COVER
========================================================= */

.book-card-header {
  display: flex;
  align-items: flex-start;
  gap: 16px;
}

.book-card-cover {
  position: relative;
  z-index: 2;
  flex: 0 0 88px;
}

.book-card-info {
  position: relative;
  z-index: 3;

  min-width: 0;
  flex: 1;

  overflow: hidden;
}

.book-card-info h3 {
  position: relative;
  z-index: 3;

  margin: 1px 0 7px;

  overflow-wrap: anywhere;
  word-break: break-word;
}

.book-card-info .book-meta,
.book-card-info .book-status {
  position: relative;
  z-index: 3;
}


/* When there is no actual cover,
   keep the information in its own column */
.book-card-header .book-card-info {
  min-width: 0;
}


/* Mobile */

@media (max-width: 600px) {

  .book-card-header {
    gap: 12px;
  }

  .book-card-cover {
    flex: 0 0 76px;
  }

}