<style>
/* =========================================================
   LITDOM — PUBLICATION APPLICATION
   Brand System
   Scoped ONLY to the publication modal
========================================================= */

.publication-modal {
  position: fixed;
  inset: 0;
  z-index: 99999;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 20px;

  background: rgba(11, 11, 15, 0.86);

  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);

  overflow-y: auto;
}


/* =========================================================
   MAIN CARD
========================================================= */

.publication-modal-box {
  position: relative;

  width: min(720px, 100%);

  max-height: 92vh;
  overflow-y: auto;

  padding: 38px;

  background:
    linear-gradient(
      145deg,
      #17171C 0%,
      #111116 52%,
      #0B0B0F 100%
    );

  border: 1px solid rgba(212, 175, 55, 0.22);

  border-radius: 28px;

  box-shadow:
    0 30px 80px rgba(0, 0, 0, 0.60),
    0 10px 35px rgba(212, 175, 55, 0.08);

  color: #FFF8E7;

  box-sizing: border-box;

  animation:
    publicationModalIn
    0.28s ease-out;
}


@keyframes publicationModalIn {
  from {
    opacity: 0;
    transform:
      translateY(18px)
      scale(0.98);
  }

  to {
    opacity: 1;
    transform:
      translateY(0)
      scale(1);
  }
}


/* =========================================================
   CLOSE BUTTON
========================================================= */

.publication-close {
  position: absolute;

  top: 18px;
  right: 18px;

  width: 42px;
  height: 42px;

  border: 1px solid rgba(212, 175, 55, 0.18);
  border-radius: 50%;

  background: #17171C;

  color: #F4D58D;

  font-size: 25px;
  line-height: 1;

  cursor: pointer;

  transition:
    transform 0.2s ease,
    background 0.2s ease,
    color 0.2s ease,
    border-color 0.2s ease;
}


.publication-close:hover {
  background: #211F18;

  color: #FFF8E7;

  border-color: rgba(212, 175, 55, 0.50);

  transform:
    rotate(8deg)
    scale(1.05);
}


/* =========================================================
   HEADER
========================================================= */

.publication-label {
  margin: 0 0 8px;

  color: #F4D58D;

  font-size: 11px;
  font-weight: 800;

  letter-spacing: 2.2px;

  text-transform: uppercase;
}


.publication-modal-box > h2 {
  margin: 0;

  color: #FFF8E7;

  font-size: clamp(28px, 5vw, 38px);

  line-height: 1.15;

  letter-spacing: -0.8px;
}


.publication-book-name {
  margin: 10px 0 25px;

  color: #B8AA8B;

  font-size: 15px;
}


/* =========================================================
   BOOK SUMMARY
========================================================= */

.publication-summary {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 14px;

  margin-bottom: 32px;
}


.publication-summary > div {
  padding: 17px 18px;

  border-radius: 18px;

  background:
    linear-gradient(
      135deg,
      #17171C,
      #1D1B18
    );

  border: 1px solid rgba(212, 175, 55, 0.16);
}


.publication-summary span {
  display: block;

  margin-bottom: 5px;

  color: #9F967F;

  font-size: 11px;
  font-weight: 700;

  text-transform: uppercase;

  letter-spacing: 1px;
}


.publication-summary strong {
  color: #FFF8E7;

  font-size: 16px;
}


/* =========================================================
   SECTION HEADINGS
========================================================= */

.publication-modal-box h3 {
  position: relative;

  margin: 34px 0 8px;

  padding-left: 14px;

  color: #F4D58D;

  font-size: 20px;
}


.publication-modal-box h3::before {
  content: "";

  position: absolute;

  left: 0;
  top: 3px;
  bottom: 3px;

  width: 4px;

  border-radius: 10px;

  background:
    linear-gradient(
      180deg,
      #F4D58D,
      #8C7625
    );
}


.publication-modal-box h4 {
  margin: 28px 0 15px;

  color: #D4AF37;

  font-size: 16px;
}


/* =========================================================
   SECTION NOTES
========================================================= */

.publication-section-note {
  margin: 0 0 20px;

  color: #A9A092;

  font-size: 13px;

  line-height: 1.65;
}


/* =========================================================
   LABELS
========================================================= */

.publication-modal-box form > label,
.publication-modal-box label[for] {
  display: block;

  margin:
    18px 0 7px;

  color: #E8DDC8;

  font-size: 13px;
  font-weight: 700;
}


/* =========================================================
   INPUTS
========================================================= */

.publication-modal-box
input[type="text"],
.publication-modal-box
input[type="email"],
.publication-modal-box
input[type="tel"],
.publication-modal-box
select,
.publication-modal-box
textarea {
  width: 100%;

  box-sizing: border-box;

  border: 1px solid #302D25;

  border-radius: 15px;

  background: #111116;

  color: #FFF8E7;

  padding: 14px 16px;

  font-family: inherit;

  font-size: 14px;

  outline: none;

  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease,
    background 0.2s ease,
    transform 0.2s ease;
}


.publication-modal-box
input[type="text"],
.publication-modal-box
input[type="email"],
.publication-modal-box
input[type="tel"],
.publication-modal-box
select {
  min-height: 50px;
}


.publication-modal-box textarea {
  min-height: 120px;

  resize: vertical;

  line-height: 1.6;
}


.publication-modal-box
input::placeholder,
.publication-modal-box
textarea::placeholder {
  color: #716B60;
}


/* =========================================================
   FOCUS
========================================================= */

.publication-modal-box
input[type="text"]:focus,
.publication-modal-box
input[type="email"]:focus,
.publication-modal-box
input[type="tel"]:focus,
.publication-modal-box
select:focus,
.publication-modal-box
textarea:focus {
  border-color: #D4AF37;

  background: #15140F;

  box-shadow:
    0 0 0 4px
    rgba(212, 175, 55, 0.10);

  transform:
    translateY(-1px);
}


/* =========================================================
   FICTION SECTION
========================================================= */

#fiction-publication-fields {
  margin-top: 30px;

  padding: 22px;

  border-radius: 22px;

  background:
    linear-gradient(
      145deg,
      #17171C,
      #121216
    );

  border: 1px solid rgba(212, 175, 55, 0.15);
}


/* =========================================================
   AGREEMENTS
========================================================= */

.publication-agreements {
  margin-top: 32px;

  padding: 20px;

  border-radius: 20px;

  background: #121216;

  border: 1px solid #2C2923;
}


.publication-check {
  display: flex !important;

  align-items: flex-start;

  gap: 12px;

  margin: 0 0 15px !important;

  color: #BEB5A5 !important;

  font-size: 13px !important;

  font-weight: 500 !important;

  line-height: 1.55;
}


.publication-check:last-child {
  margin-bottom: 0 !important;
}


.publication-check input[type="checkbox"] {
  flex: 0 0 auto;

  width: 18px;
  height: 18px;

  margin-top: 2px;

  accent-color: #D4AF37;

  cursor: pointer;
}


.publication-check span {
  cursor: pointer;
}


/* =========================================================
   SUBMIT BUTTON
========================================================= */

#submit-publication-application {
  width: 100%;

  min-height: 56px;

  margin-top: 28px;

  padding: 15px 22px;

  border: 1px solid #D4AF37;

  border-radius: 17px;

  background:
    linear-gradient(
      135deg,
      #D4AF37,
      #A98520
    );

  color: #0B0B0F;

  font-family: inherit;

  font-size: 15px;
  font-weight: 900;

  letter-spacing: 0.2px;

  cursor: pointer;

  box-shadow:
    0 12px 28px
    rgba(212, 175, 55, 0.18);

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    filter 0.2s ease;
}


#submit-publication-application:hover {
  transform:
    translateY(-2px);

  box-shadow:
    0 16px 35px
    rgba(212, 175, 55, 0.25);

  filter: brightness(1.06);
}


#submit-publication-application:active {
  transform:
    translateY(0)
    scale(0.99);
}


/* =========================================================
   MESSAGE
========================================================= */

#publication-application-message {
  margin: 15px 0 0;

  padding: 0;

  text-align: center;

  color: #CDBF9D;

  font-size: 13px;

  font-weight: 600;

  line-height: 1.5;
}


/* =========================================================
   STATUS COLORS
   Semantic colors intentionally remain distinct
   from Litdom's brand gold.
========================================================= */

:root {
  --status-published: #35C759;
  --status-approved: #35C759;

  --status-draft: #3B82F6;

  --status-pending: #F2C94C;

  --status-changes: #F2994A;

  --status-rejected: #E5484D;
}


/* =========================================================
   CORNER BOOKMARK
   Small status marker for book covers
========================================================= */

.book-status-bookmark {
  position: absolute;

  top: 0;
  left: 0;

  z-index: 5;

  display: inline-flex;

  align-items: center;
  justify-content: center;

  min-width: 76px;
  height: 24px;

  padding: 0 10px;

  border-radius:
    0 0 8px 0;

  font-size: 8px;
  font-weight: 900;

  line-height: 1;

  letter-spacing: 0.8px;

  text-transform: uppercase;

  white-space: nowrap;

  box-sizing: border-box;

  box-shadow:
    2px 3px 8px rgba(0, 0, 0, 0.25);

  transform-origin: top left;
}


/* Small folded corner behind the bookmark */

.book-status-bookmark::after {
  content: "";

  position: absolute;

  right: -7px;
  bottom: -7px;

  width: 8px;
  height: 8px;

  clip-path: polygon(0 0, 100% 0, 100% 100%);

  opacity: 0.65;
}


/* =========================================================
   APPROVED
========================================================= */

.book-status-bookmark.approved {
  background: var(--status-approved);

  color: #071108;
}


.book-status-bookmark.approved::after {
  background: #187A32;
}


/* =========================================================
   PUBLISHED
========================================================= */

.book-status-bookmark.published {
  background: var(--status-published);

  color: #071108;
}


.book-status-bookmark.published::after {
  background: #187A32;
}


/* =========================================================
   DRAFT
========================================================= */

.book-status-bookmark.draft {
  background: var(--status-draft);

  color: #FFFFFF;
}


.book-status-bookmark.draft::after {
  background: #174A94;
}


/* =========================================================
   PENDING
========================================================= */

.book-status-bookmark.pending {
  background: var(--status-pending);

  color: #1C1603;
}


.book-status-bookmark.pending::after {
  background: #A17B08;
}


/* =========================================================
   CHANGES REQUESTED
========================================================= */

.book-status-bookmark.changes-requested {
  background: var(--status-changes);

  color: #1C0D02;
}


.book-status-bookmark.changes-requested::after {
  background: #994E0A;
}


/* =========================================================
   REJECTED
========================================================= */

.book-status-bookmark.rejected {
  background: var(--status-rejected);

  color: #FFFFFF;
}


.book-status-bookmark.rejected::after {
  background: #8F2025;
}


/* =========================================================
   SCROLLBAR
========================================================= */

.publication-modal-box::-webkit-scrollbar {
  width: 7px;
}


.publication-modal-box::-webkit-scrollbar-track {
  background: transparent;
}


.publication-modal-box::-webkit-scrollbar-thumb {
  background: #514A3A;

  border-radius: 20px;
}


.publication-modal-box::-webkit-scrollbar-thumb:hover {
  background: #8C7625;
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

  .publication-modal {
    align-items: flex-start;

    padding: 10px;
  }


  .publication-modal-box {
    width: 100%;

    max-height: 96vh;

    padding: 27px 20px 25px;

    border-radius: 23px;
  }


  .publication-close {
    top: 12px;
    right: 12px;

    width: 38px;
    height: 38px;
  }


  .publication-summary {
    grid-template-columns: 1fr;
  }


  .publication-modal-box > h2 {
    padding-right: 35px;

    font-size: 28px;
  }


  #fiction-publication-fields {
    padding: 17px;
  }


  .book-status-bookmark {
    min-width: 68px;
    height: 22px;

    padding: 0 8px;

    font-size: 7px;
  }
}
</style>