async function countBookRead() {

  const {
    data: {
      session
    }
  } = await client.auth.getSession();

  /*
     Only signed-in readers count as
     a unique reader.
  */
  if (!session) {
    return;
  }

  try {

    const {
      error
    } = await client
      .from("book_reads")
      .upsert(
        {
          book_id: book.id,
          reader_id: session.user.id,
          last_read_at: new Date().toISOString()
        },
        {
          onConflict: "book_id,reader_id"
        }
      );

    if (error) {

      console.error(
        "READ COUNT ERROR:",
        error
      );

      return;
    }

    const {
      count
    } = await client
      .from("book_reads")
      .select("id", { count: "exact", head: true })
      .eq("book_id", book.id);

    const viewsElement =
      document.getElementById(
        "litdom-book-views"
      );

    if (viewsElement) {

      viewsElement.textContent =
        Number(count || 0).toLocaleString();

    }

  } catch (error) {

    console.error(
      "Unexpected read count error:",
      error
    );

  }
}

countBookRead();