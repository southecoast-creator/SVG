/* =====================================================
   BOOK ENGAGEMENT TOTALS
   Likes = total likes across the book's chapters
   Comments = total reader comments on the book
   One lightweight RPC request
===================================================== */

const {
  data: engagement,
  error: engagementError
} = await client.rpc(
  "get_book_engagement",
  {
    p_book_id: book.id
  }
);

if (engagementError) {

  console.error(
    "BOOK ENGAGEMENT ERROR:",
    engagementError
  );

} else {

  const likesElement =
    document.getElementById(
      "litdom-book-likes"
    );

  const commentsElement =
    document.getElementById(
      "litdom-book-comments"
    );

  if (likesElement) {

    likesElement.textContent =
      Number(
        engagement?.total_likes ?? 0
      ).toLocaleString();

  }

  if (commentsElement) {

    commentsElement.textContent =
      Number(
        engagement?.total_comments ?? 0
      ).toLocaleString();

  }

}