/* =====================================================
   LITDOM — PREMIUM SECTION SEPARATION
   ===================================================== */

.litdom-book-description,
.litdom-book-stats,
.litdom-book-actions,
.litdom-book-reading {
  position: relative;
}


/* Subtle atmospheric divider between sections */
.litdom-book-description::after,
.litdom-book-stats::after,
.litdom-book-actions::after {
  content: "";
  display: block;

  width: 100%;
  height: 1px;

  margin-top: 22px;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(140, 118, 37, 0.28),
      rgba(244, 213, 141, 0.18),
      rgba(140, 118, 37, 0.28),
      transparent
    );
}


/* =====================================================
   LITDOM — CALLIGRAPHIC AUTHOR NAME
   ===================================================== */

.litdom-author-link {
  display: inline-block;

  color: #F4D58D;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: 15px;
  font-style: italic;
  font-weight: 600;

  letter-spacing: 0.2px;

  text-decoration: none;

  position: relative;

  transition:
    color 0.25s ease,
    text-shadow 0.25s ease,
    transform 0.25s ease;
}


/* Tiny underline hint that suggests clickability */
.litdom-author-link::after {
  content: "";

  position: absolute;

  left: 0;
  right: 0;
  bottom: -3px;

  height: 1px;

  background:
    linear-gradient(
      90deg,
      transparent,
      #D4AF37,
      transparent
    );

  opacity: 0.45;

  transform: scaleX(0.65);

  transition:
    opacity 0.25s ease,
    transform 0.25s ease;
}


.litdom-author-link:hover {
  color: #FFF8E7;

  text-shadow:
    0 0 10px
    rgba(244, 213, 141, 0.25);

  transform: translateY(-1px);
}


.litdom-author-link:hover::after {
  opacity: 0.9;
  transform: scaleX(1);
}


/* =====================================================
   LITDOM — PREMIUM ADD TO LIBRARY
   ===================================================== */

#litdom-library-button {
  position: relative;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  gap: 8px;

  min-height: 44px;

  padding: 11px 19px;

  border: 1px solid
    rgba(212, 175, 55, 0.55);

  border-radius: 13px;

  background:
    linear-gradient(
      145deg,
      #202026 0%,
      #17171C 48%,
      #0F0F13 100%
    );

  color: #F4D58D;

  font-size: 13px;
  font-weight: 700;

  letter-spacing: 0.15px;

  cursor: pointer;

  overflow: hidden;

  box-shadow:
    inset 0 1px 0
      rgba(255, 248, 231, 0.08),
    0 5px 18px
      rgba(0, 0, 0, 0.22);

  transition:
    transform 0.2s ease,
    border-color 0.2s ease,
    box-shadow 0.25s ease,
    color 0.2s ease,
    background 0.25s ease;
}


/* Soft glossy sweep */
#litdom-library-button::before {
  content: "";

  position: absolute;

  top: 0;
  left: -120%;

  width: 80%;
  height: 100%;

  background:
    linear-gradient(
      110deg,
      transparent,
      rgba(255, 248, 231, 0.12),
      transparent
    );

  transform: skewX(-18deg);

  transition:
    left 0.55s ease;
}


#litdom-library-button:hover {
  transform: translateY(-2px);

  border-color: #D4AF37;

  color: #FFF8E7;

  background:
    linear-gradient(
      145deg,
      #25252C,
      #17171C
    );

  box-shadow:
    inset 0 1px 0
      rgba(255, 248, 231, 0.1),
    0 7px 24px
      rgba(0, 0, 0, 0.3),
    0 0 16px
      rgba(212, 175, 55, 0.12);
}


#litdom-library-button:hover::before {
  left: 140%;
}


#litdom-library-button:active {
  transform: scale(0.97);
}


/* =====================================================
   LIBRARY — ADDED STATE
   ===================================================== */

#litdom-library-button.library-added {
  border-color:
    rgba(244, 213, 141, 0.7);

  background:
    linear-gradient(
      145deg,
      #24231F,
      #17171C
    );

  color: #FFF8E7;

  cursor: default;

  box-shadow:
    inset 0 1px 0
      rgba(255, 248, 231, 0.09),
    0 5px 18px
      rgba(0, 0, 0, 0.2);
}


#litdom-library-button.library-added:hover {
  transform: none;

  border-color:
    rgba(244, 213, 141, 0.7);

  box-shadow:
    inset 0 1px 0
      rgba(255, 248, 231, 0.09),
    0 5px 18px
      rgba(0, 0, 0, 0.2);
}


/* =====================================================
   OPTIONAL — SMALL LIBRARY ICON
   ===================================================== */

#litdom-library-button .litdom-library-icon {
  width: 17px;
  height: 17px;

  flex-shrink: 0;

  fill: none;

  stroke: currentColor;

  stroke-width: 1.7;

  stroke-linecap: round;
  stroke-linejoin: round;
}


/* =====================================================
   MOBILE REFINEMENT
   ===================================================== */

@media (max-width: 600px) {

  #litdom-library-button {
    min-height: 43px;

    padding:
      10px 15px;

    font-size: 12.5px;
  }

  .litdom-author-link {
    font-size: 14px;
  }

}