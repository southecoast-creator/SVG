/* =====================================================
   LITDOM — ADD TO LIBRARY
===================================================== */

const libraryButton =
  document.getElementById(
    "litdom-library-button"
  );

if (libraryButton) {

  /*
     Check whether this reader already
     has the book in their Library.
  */

  async function checkLibraryStatus() {

    const {
      data: {
        session
      }
    } =
      await client.auth.getSession();

    /*
       Visitor is not signed in.
       Keep the normal button.
    */

    if (!session) {
      return;
    }

    const userId =
      session.user.id;

    const {
      data: libraryEntry,
      error: libraryError
    } =
      await client
        .from("library")
        .select("id")
        .eq(
          "user_id",
          userId
        )
        .eq(
          "book_id",
          book.id
        )
        .maybeSingle();

    if (libraryError) {

      console.error(
        "LIBRARY STATUS ERROR:",
        libraryError
      );

      return;
    }

    /*
       Already added.
    */

    if (libraryEntry) {

      libraryButton.textContent =
        "✓ Added to Library";

      libraryButton.classList.add(
        "litdom-library-added"
      );

      libraryButton.disabled =
        true;

      libraryButton.setAttribute(
        "aria-label",
        "Book added to Library"
      );

    }

  }


  /*
     Add book to Library.
  */

  libraryButton.addEventListener(
    "click",
    async function () {

      /*
         Prevent accidental double clicks.
      */

      if (
        libraryButton.disabled
      ) {
        return;
      }

      const {
        data: {
          session
        }
      } =
        await client.auth.getSession();


      /*
         Reader must be signed in.
      */

      if (!session) {

        const popup =
          document.createElement(
            "div"
          );

        popup.className =
          "litdom-auth-popup";

        popup.innerHTML = `
          <div class="litdom-auth-box">

            <button
              type="button"
              class="litdom-auth-close"
              aria-label="Close"
            >
              ×
            </button>

            <h3>
              Add to Library
            </h3>

            <p>
              Sign in or create a free Litdom
              account to save this book to
              your Library.
            </p>

            <a
              href="/p/sign-up-for-litdom.html"
              class="litdom-auth-button"
            >
              Sign In / Create Account
            </a>

          </div>
        `;

        document.body.appendChild(
          popup
        );


        popup
          .querySelector(
            ".litdom-auth-close"
          )
          .addEventListener(
            "click",
            function () {

              popup.remove();

            }
          );


        popup.addEventListener(
          "click",
          function (event) {

            if (
              event.target === popup
            ) {

              popup.remove();

            }

          }
        );

        return;
      }


      /*
         Temporarily disable the button
         while Supabase saves it.
      */

      libraryButton.disabled =
        true;

      libraryButton.textContent =
        "Adding…";


      try {

        const userId =
          session.user.id;


        const {
          error: insertError
        } =
          await client
            .from("library")
            .insert({
              user_id:
                userId,

              book_id:
                book.id
            });


        /*
           If Supabase rejects the insert,
           restore the button.
        */

        if (insertError) {

          /*
             The unique constraint means that
             even a double request cannot create
             a duplicate.
          */

          if (
            insertError.code ===
            "23505"
          ) {

            libraryButton.textContent =
              "✓ Added to Library";

            libraryButton.classList.add(
              "litdom-library-added"
            );

            return;
          }


          throw insertError;
        }


        /*
           SUCCESS
        */

        libraryButton.textContent =
          "✓ Added to Library";

        libraryButton.classList.add(
          "litdom-library-added"
        );

        libraryButton.setAttribute(
          "aria-label",
          "Book added to Library"
        );


      } catch (error) {

        console.error(
          "ADD TO LIBRARY ERROR:",
          error
        );

        libraryButton.disabled =
          false;

        libraryButton.textContent =
          "＋ Add to Library";

        alert(
          "We couldn't add this book to your Library right now."
        );

      }

    }
  );


  /*
     Check status when the book page loads.
  */

  checkLibraryStatus();

}

/* =====================================================
   LITDOM — LIBRARY BUTTON
===================================================== */

#litdom-library-button {
  transition:
    background 0.2s ease,
    border-color 0.2s ease,
    color 0.2s ease,
    box-shadow 0.2s ease,
    transform 0.15s ease;
}


/* Added state */

#litdom-library-button.litdom-library-added {
  background:
    linear-gradient(
      135deg,
      #1d1b15,
      #17171c
    );

  border-color: #D4AF37;

  color: #F4D58D;

  box-shadow:
    0 0 10px
    rgba(212, 175, 55, 0.14);

  cursor: default;
}


/* While saving */

#litdom-library-button:disabled {
  opacity: 0.85;
}


/* Don't make the completed button jump */

#litdom-library-button.litdom-library-added:hover {
  transform: none;
}