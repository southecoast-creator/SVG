downloadButton.addEventListener(
    "click",
    async function () {

      downloadButton.disabled =
        true;

      downloadButton.textContent =
        "Preparing download…";

      try {

        const {
          data: freeChapters,
          error: freeChaptersError
        } = await client
          .from("chapters")
          .select("id,chapter_number,title,content,is_locked")
          .eq("book_id", book.id)
          .eq("status", "published")
          .eq("is_locked", false);

        if (freeChaptersError) {
          throw freeChaptersError;
        }

        await litdomSaveBookOffline(
          book.id,
          book.title,
          freeChapters || []
        );

        downloadButton.textContent =
          "✓ Downloaded";

        setTimeout(function () {

          overlay.remove();

        }, 1000);

      } catch (downloadError) {

        console.error(
          "OFFLINE DOWNLOAD ERROR:",
          downloadError
        );

        downloadButton.disabled = false;

        downloadButton.textContent =
          "↓ Download for Offline";

        alert(
          "Could not download this book for offline reading."
        );

      }

    }
  );