card.addEventListener("click", async function () {

      const isOnline = navigator.onLine;

      if (!isOnline && !isDownloaded) {

        alert(
          "You're offline and this book hasn't been downloaded yet. Connect to the internet to download and read it."
        );

        return;

      }

      if (isOnline && !isDownloaded) {

        const wantsDownload =
          confirm(
            "\"" + book.title + "\" is not downloaded yet. Download it now for offline reading?"
          );

        if (wantsDownload) {

          badge.textContent = "Downloading...";

          try {

            const {
              data: freeChapters,
              error: freeChaptersError
            } = await client
              .from("chapters")
              .select("id,chapter_number,title,content,is_locked")
              .eq("book_id", book.id)
              .eq("status", "published")
              .eq("is_locked", false);

            if (freeChaptersError) {
              throw freeChaptersError;
            }

            await litdomSaveBookOffline(
              book.id,
              book.title,
              freeChapters || []
            );

            badge.textContent = "Downloaded";

            badge.className =
              "library-download-badge downloaded";

          } catch (downloadError) {

            console.error("LIBRARY DOWNLOAD ERROR:", downloadError);

            badge.textContent = "Not Downloaded";

            alert("Could not download this book right now.");

            return;

          }

        }

      }

      localStorage.setItem(seenKey, String(currentCount));

      window.location.href =
        "/p/book.html?book=" + encodeURIComponent(book.id);

    });