/* =====================================================
   DISPLAY BOOK
===================================================== */

const titleElement =
  document.getElementById(
    "litdom-book-title"
  );

const descriptionElement =
  document.getElementById(
    "litdom-book-description"
  );

const readMoreButton =
  document.getElementById(
    "litdom-read-more"
  );

const tagsContainer =
  document.getElementById(
    "litdom-book-tags"
  );


/* =====================================================
   BOOK TITLE
===================================================== */

if (titleElement) {

  titleElement.textContent =
    book.title ||
    "Untitled Book";

}


/* =====================================================
   BOOK DESCRIPTION
   Read More appears ONLY when the blurb
   contains more than 100 words.
===================================================== */

const fullDescription =
  String(
    book.description ||
    "No description available."
  ).trim();


const descriptionWords =
  fullDescription
    .split(/\s+/)
    .filter(Boolean);


const DESCRIPTION_LIMIT =
  100;


let descriptionExpanded =
  false;


function renderDescription() {

  if (!descriptionElement) {
    return;
  }


  /*
     100 words or fewer:
     show everything and hide Read More.
  */

  if (
    descriptionWords.length <=
    DESCRIPTION_LIMIT
  ) {

    descriptionElement.textContent =
      fullDescription;

    if (readMoreButton) {

      readMoreButton.style.display =
        "none";

    }

    return;
  }


  /*
     More than 100 words:
     show shortened version.
  */

  if (!descriptionExpanded) {

    descriptionElement.textContent =
      descriptionWords
        .slice(
          0,
          DESCRIPTION_LIMIT
        )
        .join(" ") +
      "...";

    if (readMoreButton) {

      readMoreButton.style.display =
        "inline-flex";

      readMoreButton.textContent =
        "Read more";

    }

  } else {

    /*
       Expanded:
       show the complete blurb.
    */

    descriptionElement.textContent =
      fullDescription;

    if (readMoreButton) {

      readMoreButton.style.display =
        "inline-flex";

      readMoreButton.textContent =
        "Show less";

    }

  }

}


/* Initial description */

renderDescription();


/* =====================================================
   READ MORE / SHOW LESS
===================================================== */

if (readMoreButton) {

  readMoreButton.addEventListener(
    "click",
    function () {

      descriptionExpanded =
        !descriptionExpanded;

      renderDescription();

    }
  );

}


/* =====================================================
   BOOK TAGS
   Tags remain separate from the blurb
   and are displayed as individual pills.
===================================================== */

if (tagsContainer) {

  tagsContainer.replaceChildren();

  const tags = [];


  /* GENRE */

  if (book.genre) {

    tags.push(
      String(book.genre).trim()
    );

  }


  /* PROTAGONIST TAGS */

  if (
    Array.isArray(
      book.protagonist_tags
    )
  ) {

    book.protagonist_tags
      .forEach(
        function (tag) {

          const cleanTag =
            String(
              tag || ""
            ).trim();

          if (
            cleanTag &&
            !tags.includes(cleanTag)
          ) {

            tags.push(
              cleanTag
            );

          }

        }
      );

  }


  /* ANTAGONIST TAGS */

  if (
    Array.isArray(
      book.antagonist_tags
    )
  ) {

    book.antagonist_tags
      .forEach(
        function (tag) {

          const cleanTag =
            String(
              tag || ""
            ).trim();

          if (
            cleanTag &&
            !tags.includes(cleanTag)
          ) {

            tags.push(
              cleanTag
            );

          }

        }
      );

  }


  /*
     Maximum of 8 pills.
     This keeps the Book Page clean,
     especially on mobile.
  */

  tags
    .slice(0, 8)
    .forEach(
      function (tag) {

        const pill =
          document.createElement(
            "span"
          );

        pill.className =
          "litdom-book-tag";

        pill.textContent =
          tag;

        tagsContainer.appendChild(
          pill
        );

      }
    );

}


/* =====================================================
   LITDOM BOOK DESCRIPTION
===================================================== */

.litdom-book-description {
  position: relative;
}

#litdom-book-description {
  margin: 0;
  color: #FFF8E7;
  line-height: 1.75;
}


/* =====================================================
   READ MORE
===================================================== */

#litdom-read-more {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  margin-top: 12px;
  padding: 8px 15px;

  border: 1px solid #8C7625;
  border-radius: 999px;

  background: #17171C;
  color: #F4D58D;

  font-size: 13px;
  font-weight: 600;

  cursor: pointer;

  transition:
    background 0.2s ease,
    border-color 0.2s ease,
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

#litdom-read-more:hover {
  background: #0B0B0F;
  border-color: #D4AF37;

  box-shadow:
    0 0 12px
    rgba(212, 175, 55, 0.22);

  transform: translateY(-1px);
}

#litdom-read-more:active {
  transform: scale(0.97);
}


/* =====================================================
   BOOK TAG PILLS
===================================================== */

#litdom-book-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;

  margin-top: 14px;
}

.litdom-book-tag {
  display: inline-flex;
  align-items: center;

  min-height: 30px;
  padding: 5px 11px;

  border: 1px solid #8C7625;
  border-radius: 999px;

  background:
    linear-gradient(
      135deg,
      #17171C,
      #0B0B0F
    );

  color: #F4D58D;

  font-size: 12px;
  font-weight: 600;

  letter-spacing: 0.2px;

  box-shadow:
    inset 0 1px 0
    rgba(244, 213, 141, 0.08);
}