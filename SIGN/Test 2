/* =====================================================
   LITDOM — SHARE BOOK
   Shares the current book's direct URL
===================================================== */

const shareButton =
  document.getElementById(
    "litdom-share-button"
  );

if (shareButton) {

  shareButton.addEventListener(
    "click",
    async function () {

      /*
         Build the exact URL of this book.
         The current book ID is already loaded,
         so no database request is needed.
      */

      const bookUrl =
        window.location.origin +
        window.location.pathname +
        "?book=" +
        encodeURIComponent(
          book.id
        );


      const shareTitle =
        book.title ||
        "Read this book on Litdom";


      const shareText =
        `Read "${shareTitle}" on Litdom 📖`;


      /* =================================================
         NATIVE SHARE
         Works especially well on phones.
      ================================================= */

      if (
        navigator.share
      ) {

        try {

          await navigator.share({

            title:
              shareTitle,

            text:
              shareText,

            url:
              bookUrl

          });

        } catch (error) {

          /*
             User cancelling the share sheet
             is normal — don't show an error.
          */

          if (
            error?.name !==
            "AbortError"
          ) {

            console.error(
              "SHARE ERROR:",
              error
            );

          }

        }

        return;
      }


      /* =================================================
         FALLBACK — COPY LINK
         For browsers without navigator.share.
      ================================================= */

      try {

        await navigator.clipboard.writeText(
          bookUrl
        );


        const originalText =
          shareButton.textContent;


        shareButton.textContent =
          "✓ Link Copied";


        shareButton.classList.add(
          "share-copied"
        );


        setTimeout(
          function () {

            shareButton.textContent =
              originalText;

            shareButton.classList.remove(
              "share-copied"
            );

          },
          1800
        );


      } catch (error) {

        console.error(
          "COPY LINK ERROR:",
          error
        );


        /*
           Last-resort fallback.
        */

        window.prompt(
          "Copy this book link:",
          bookUrl
        );

      }

    }
  );

}













/* =====================================================
   LITDOM — PREMIUM SHARE BUTTON
===================================================== */

#litdom-share-button {
  position: relative;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  gap: 7px;

  min-height: 44px;

  padding: 11px 18px;

  border: 1px solid
    rgba(140, 118, 37, 0.65);

  border-radius: 13px;

  background:
    linear-gradient(
      145deg,
      #202026 0%,
      #17171C 48%,
      #0F0F13 100%
    );

  color: #F4D58D;

  font-size: 13px;
  font-weight: 700;

  letter-spacing: 0.15px;

  cursor: pointer;

  overflow: hidden;

  box-shadow:
    inset 0 1px 0
      rgba(255, 248, 231, 0.07),
    0 5px 18px
      rgba(0, 0, 0, 0.2);

  transition:
    transform 0.2s ease,
    border-color 0.2s ease,
    box-shadow 0.25s ease,
    color 0.2s ease;
}


/* Glossy sweep */

#litdom-share-button::before {
  content: "";

  position: absolute;

  top: 0;
  left: -120%;

  width: 80%;
  height: 100%;

  background:
    linear-gradient(
      110deg,
      transparent,
      rgba(255, 248, 231, 0.11),
      transparent
    );

  transform: skewX(-18deg);

  transition:
    left 0.55s ease;
}


#litdom-share-button:hover {
  transform: translateY(-2px);

  border-color:
    #D4AF37;

  color:
    #FFF8E7;

  box-shadow:
    inset 0 1px 0
      rgba(255, 248, 231, 0.09),
    0 7px 24px
      rgba(0, 0, 0, 0.28),
    0 0 16px
      rgba(212, 175, 55, 0.12);
}


#litdom-share-button:hover::before {
  left: 140%;
}


#litdom-share-button:active {
  transform: scale(0.97);
}


/* =====================================================
   LINK COPIED STATE
===================================================== */

#litdom-share-button.share-copied {
  border-color:
    #D4AF37;

  color:
    #FFF8E7;

  box-shadow:
    0 0 15px
      rgba(212, 175, 55, 0.16);
}


/* =====================================================
   MOBILE
===================================================== */

@media (max-width: 600px) {

  #litdom-share-button {
    min-height: 43px;

    padding:
      10px 15px;

    font-size: 12.5px;
  }

}