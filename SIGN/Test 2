/* =====================================================
     AGE GATE
  ===================================================== */

  const ageGateMinimums = {
    "13+": 13,
    "16+": 16,
    "18+": 18
  };

  const requiredAge =
    ageGateMinimums[book.age_rating];

  if (requiredAge) {

    const gateKey =
      "litdom_age_confirmed_" + requiredAge;

    const alreadyConfirmed =
      localStorage.getItem(gateKey) === "yes";

    if (!alreadyConfirmed) {

      content.style.display = "none";

      const gateOverlay =
        document.createElement("div");

      gateOverlay.style.position = "fixed";
      gateOverlay.style.inset = "0";
      gateOverlay.style.zIndex = "999999";
      gateOverlay.style.background = "#0B0B0F";
      gateOverlay.style.display = "flex";
      gateOverlay.style.alignItems = "center";
      gateOverlay.style.justifyContent = "center";
      gateOverlay.style.padding = "20px";

      gateOverlay.innerHTML =
        "<div style='max-width:360px; text-align:center; color:#FFF8E7;'>" +
        "<h2 style='color:#F4D58D; margin-bottom:12px;'>Age Restricted Content</h2>" +
        "<p style='color:#B9AE9A; margin-bottom:24px; line-height:1.6;'>This book is rated " +
        book.age_rating +
        ". You must confirm you are at least " +
        requiredAge +
        " years old to continue.</p>" +
        "<button id='age-gate-confirm' style='width:100%; padding:14px; border:none; border-radius:10px; background:linear-gradient(135deg,#D4AF37,#F4D58D); color:#0B0B0F; font-weight:800; font-size:14px; margin-bottom:10px; cursor:pointer;'>I am " +
        requiredAge +
        " or older</button>" +
        "<button id='age-gate-leave' style='width:100%; padding:14px; border:1px solid #8C7625; border-radius:10px; background:transparent; color:#FFF8E7; font-size:14px; cursor:pointer;'>Leave</button>" +
        "</div>";

      document.body.appendChild(gateOverlay);

      document.getElementById("age-gate-confirm")
        .addEventListener("click", function () {

          localStorage.setItem(gateKey, "yes");

          gateOverlay.remove();

          content.style.display = "block";

        });

      document.getElementById("age-gate-leave")
        .addEventListener("click", function () {

          window.location.href = "/";

        });

    }

  }