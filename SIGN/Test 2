/* =====================================================
   LITDOM — OFFLINE DOWNLOAD POPUP
===================================================== */

.litdom-offline-overlay {
  position: fixed;
  inset: 0;
  z-index: 99999;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 20px;

  background: rgba(0, 0, 0, 0.62);

  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(5px);
}

.litdom-offline-popup {
  width: 100%;
  max-width: 390px;

  padding: 28px 22px 22px;

  box-sizing: border-box;

  border: 1px solid rgba(212, 175, 55, 0.42);
  border-radius: 18px;

  background: #17171c;
  color: #fff8e7;

  text-align: center;

  box-shadow:
    0 18px 55px rgba(0, 0, 0, 0.42);
}

.litdom-offline-popup-icon {
  font-size: 34px;
  margin-bottom: 10px;
}

.litdom-offline-popup h3 {
  margin: 0 0 8px;

  font-size: 20px;
}

.litdom-offline-popup p {
  margin: 0 auto 20px;

  max-width: 310px;

  font-size: 13px;
  line-height: 1.6;

  opacity: 0.68;
}

.litdom-offline-download-button {
  width: 100%;

  padding: 13px 18px;

  border: 0;
  border-radius: 11px;

  background:
    linear-gradient(
      135deg,
      #d4af37,
      #f4d58d
    );

  color: #0b0b0f;

  font-size: 14px;
  font-weight: 700;

  cursor: pointer;
}

.litdom-offline-later-button {
  width: 100%;

  margin-top: 9px;

  padding: 11px 18px;

  border: 1px solid rgba(244, 213, 141, 0.18);
  border-radius: 11px;

  background: transparent;

  color: #fff8e7;

  font-size: 13px;

  cursor: pointer;

  opacity: 0.72;
}

.litdom-offline-later-button:hover {
  opacity: 1;
}

.litdom-offline-download-button:disabled {
  opacity: 0.7;
  cursor: wait;
}













