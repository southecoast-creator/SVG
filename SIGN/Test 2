/* =====================================================
   COUNT BOOK READ
   One read per browser session
===================================================== */

async function countBookRead() {

  const readKey =
    "litdom_book_read_" + book.id;

  /*
     Prevent repeated refreshes in the same
     browser session from inflating the count.
  */
  if (sessionStorage.getItem(readKey)) {
    return;
  }

  try {

    const { data, error } =
      await client.rpc(
        "increment_book_reads",
        {
          p_book_id: book.id
        }
      );

    if (error) {

      console.error(
        "READ COUNT ERROR:",
        error
      );

      return;
    }

    /*
       Mark this book as read only after
       Supabase successfully increments it.
    */
    sessionStorage.setItem(
      readKey,
      "1"
    );

    /*
       Update the number displayed on the page.
    */
    const viewsElement =
      document.getElementById(
        "litdom-book-views"
      );

    if (viewsElement) {

      viewsElement.textContent =
        Number(data || 0).toLocaleString();

    }

  } catch (error) {

    console.error(
      "Unexpected read count error:",
      error
    );

  }
}

countBookRead();