<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
<meta http-equiv="Pragma" content="no-cache">
<meta http-equiv="Expires" content="0">

<div class="full-bleed">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<section id="litdom-fresh-releases" class="ldr-fresh-releases">

  <div class="ldr-fresh-header">
    <span class="ldr-eyebrow">LITDOM</span>
    <h1>Fresh Releases</h1>
    <p>New fiction books ready to discover.</p>
  </div>

  <div id="ldr-fresh-status" class="ldr-fresh-status" aria-live="polite">
    Loading fresh releases...
  </div>

  <div id="ldr-fresh-books" class="ldr-fresh-books"></div>

</section>

<style>
  .full-bleed { width: 100vw; position: relative; left: 50%; right: 50%; margin-left: -50vw; margin-right: -50vw; }
  body { margin: 0 !important; }
  .main-inner, .content-outer, .content-inner, .post, .post-body {
    width: 100% !important; max-width: none !important; margin-left: 0 !important;
    margin-right: 0 !important; padding-left: 0 !important; padding-right: 0 !important;
  }
  .post-body { box-sizing: border-box !important; }

  .ldr-fresh-releases { width: 100%; max-width: 1100px; margin: 0 auto; padding: 22px 12px 40px; box-sizing: border-box; font-family: Arial, sans-serif; }
  .ldr-fresh-header { margin-bottom: 18px; }
  .ldr-eyebrow { display: block; margin-bottom: 4px; font-size: 10px; font-weight: 700; letter-spacing: 1.5px; opacity: 0.55; }
  .ldr-fresh-header h1 { margin: 0; font-size: 25px; line-height: 1.2; }
  .ldr-fresh-header p { margin: 5px 0 0; font-size: 13px; opacity: 0.6; }

  .ldr-fresh-status { padding: 12px 0; font-size: 13px; opacity: 0.6; }
  .ldr-fresh-status.ldr-error { opacity: 1; color: #b8203f; }

  .ldr-retry-btn {
    display: inline-block; margin-top: 8px; padding: 8px 16px; font-size: 13px;
    font-weight: 600; color: #fff; background: #b8203f; border: none; border-radius: 6px; cursor: pointer;
  }
  .ldr-retry-btn:active { opacity: 0.85; }

  .ldr-fresh-books { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: 9px; row-gap: 22px; }
  .ldr-book-card { min-width: 0; padding: 0; border: 0; background: transparent; cursor: pointer; transition: transform 0.18s ease; }
  .ldr-book-card:hover { transform: translateY(-2px); }
  .ldr-book-cover { display: block; width: 100%; aspect-ratio: 2 / 3; object-fit: cover; border-radius: 6px; background: #17171C; box-shadow: 0 3px 10px rgba(0,0,0,0.16); }
  .ldr-book-info { min-width: 0; padding-top: 7px; }
  .ldr-book-title { margin: 0; font-size: 12px; line-height: 1.35; font-weight: 600; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; word-break: break-word; }
  .ldr-book-stats { display: flex; align-items: center; gap: 10px; margin-top: 6px; font-size: 10px; color: inherit; opacity: 0.62; flex-wrap: wrap; }
  .ldr-book-stat { display: inline-flex; align-items: center; gap: 3px; min-width: 0; }
  .ldr-book-stat svg { width: 14px; height: 14px; flex: 0 0 auto; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .ldr-book-stat-number { line-height: 1; white-space: nowrap; }

  @media (min-width: 900px) {
    .ldr-fresh-releases { padding-left: 18px; padding-right: 18px; }
    .ldr-fresh-books { grid-template-columns: repeat(5, minmax(0, 1fr)); column-gap: 15px; row-gap: 30px; }
    .ldr-book-title { font-size: 13px; }
  }
  @media (max-width: 360px) {
    .ldr-fresh-books { column-gap: 7px; }
    .ldr-book-title { font-size: 11.5px; }
    .ldr-book-stats { gap: 8px; font-size: 9px; }
    .ldr-book-stat svg { width: 13px; height: 13px; }
  }
</style>

<script>
(function () {

  const status = document.getElementById("ldr-fresh-status");
  const booksContainer = document.getElementById("ldr-fresh-books");

  if (!status || !booksContainer) {
    console.error("LITDOM: Fresh Releases elements were not found.");
    return;
  }

  // ---- Helper: race any promise against a timeout ----
  function withTimeout(promise, ms) {
    return Promise.race([
      promise,
      new Promise((_, reject) =>
        setTimeout(() => reject(new Error("Request timed out")), ms)
      )
    ]);
  }

  function showError(message) {
    booksContainer.innerHTML = "";
    status.style.display = "block";
    status.className = "ldr-fresh-status ldr-error";
    status.innerHTML =
      (message || "Something went wrong loading this page.") +
      '<br><button class="ldr-retry-btn" id="ldr-retry-btn">Try Again</button>' +
      '<div style="margin-top:8px;font-size:11px;opacity:0.75;">Still stuck? Try clearing this site\'s data in your browser settings, or open this page in a private/incognito tab.</div>';

    const btn = document.getElementById("ldr-retry-btn");
    if (btn) btn.addEventListener("click", loadFreshReleases);
  }

  function formatCount(value) {
    const number = Number(value) || 0;
    if (number < 1000) return String(number);
    if (number < 1000000) {
      const formatted = number / 1000;
      return formatted >= 10 ? Math.round(formatted) + "K" : formatted.toFixed(1).replace(".0", "") + "K";
    }
    if (number < 1000000000) {
      const formatted = number / 1000000;
      return formatted >= 10 ? Math.round(formatted) + "M" : formatted.toFixed(1).replace(".0", "") + "M";
    }
    const formatted = number / 1000000000;
    return formatted >= 10 ? Math.round(formatted) + "B" : formatted.toFixed(1).replace(".0", "") + "B";
  }

  async function loadFreshReleases() {

    status.style.display = "block";
    status.className = "ldr-fresh-status";
    status.textContent = "Loading fresh releases...";
    booksContainer.innerHTML = "";

    if (!window.supabase) {
      showError("Fresh Releases could not connect.");
      console.error("LITDOM: Supabase library is not loaded.");
      return;
    }

    let client;
    try {
      client = window.supabase.createClient(
        "https://uniecvgkxhcbedppadgx.supabase.co",
        "sb_publishable_UhqP7y8Cjyiv8RebOSMUDA_lBj0QuTE",
        { auth: { persistSession: true, autoRefreshToken: true, detectSessionInUrl: true } }
      );
    } catch (err) {
      console.error("LITDOM: failed to create Supabase client:", err);
      showError("Fresh Releases could not connect.");
      return;
    }

    let books, booksError;
    try {
      const result = await withTimeout(
        client
          .from("books")
          .select(`id, title, cover_url, read_count, published_at`)
          .eq("book_type", "fiction")
          .eq("status", "published")
          .order("published_at", { ascending: false }),
        10000 // 10 second timeout
      );
      books = result.data;
      booksError = result.error;
    } catch (err) {
      console.error("LITDOM FRESH RELEASES FETCH THREW:", err);
      showError("Something went wrong loading this page.");
      return;
    }

    if (booksError) {
      console.error("LITDOM FRESH RELEASES ERROR:", booksError);
      showError("Fresh Releases could not be loaded.");
      return;
    }

    if (!books || books.length === 0) {
      status.textContent = "No fresh fiction releases yet.";
      return;
    }

    status.style.display = "none";

    books.forEach(function (book) {

      const card = document.createElement("article");
      card.className = "ldr-book-card";
      card.setAttribute("role", "link");
      card.setAttribute("tabindex", "0");

      function openBook() {
        window.location.href = "/p/books.html?book=" + encodeURIComponent(book.id);
      }

      card.addEventListener("click", openBook);
      card.addEventListener("keydown", function (event) {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          openBook();
        }
      });

      const cover = document.createElement("img");
      cover.className = "ldr-book-cover";
      cover.src = book.cover_url || "";
      cover.alt = book.title || "Book cover";
      cover.loading = "lazy";
      cover.decoding = "async";

      const info = document.createElement("div");
      info.className = "ldr-book-info";

      const title = document.createElement("h2");
      title.className = "ldr-book-title";
      title.textContent = book.title || "Untitled Book";

      const stats = document.createElement("div");
      stats.className = "ldr-book-stats";

      // Reads
      const reads = document.createElement("span");
      reads.className = "ldr-book-stat";
      reads.setAttribute("aria-label", "Reads");
      reads.innerHTML = `
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M2 12 C4.5 8 7.5 6 12 6 C16.5 6 19.5 8 22 12 C19.5 16 16.5 18 12 18 C7.5 18 4.5 16 2 12 Z" />
          <circle cx="12" cy="12" r="3" />
        </svg>
        <span class="ldr-book-stat-number">${formatCount(book.read_count)}</span>
      `;

      // Likes (loaded async below)
      const likes = document.createElement("span");
      likes.className = "ldr-book-stat";
      likes.setAttribute("aria-label", "Likes");
      likes.innerHTML = `
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.84 4.61 A5.5 5.5 0 0 0 13.06 4.61 L12 5.67 L10.94 4.61 A5.5 5.5 0 0 0 3.16 12.39 L12 21.23 L20.84 12.39 A5.5 5.5 0 0 0 20.84 4.61 Z" />
        </svg>
        <span class="ldr-book-stat-number">0</span>
      `;

      // Chapter count (loaded async below)
      const chapters = document.createElement("span");
      chapters.className = "ldr-book-stat";
      chapters.setAttribute("aria-label", "Chapters");
      chapters.innerHTML = `
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 4.5 C4 3.67 4.67 3 5.5 3 H18.5 C19.33 3 20 3.67 20 4.5 V19.5 C20 20.33 19.33 21 18.5 21 H5.5 C4.67 21 4 20.33 4 19.5 Z" />
          <line x1="8" y1="7" x2="16" y2="7" />
          <line x1="8" y1="11" x2="16" y2="11" />
          <line x1="8" y1="15" x2="13" y2="15" />
        </svg>
        <span class="ldr-book-stat-number">…</span>
      `;

      stats.appendChild(reads);
      stats.appendChild(chapters);
      stats.appendChild(likes);

      info.appendChild(title);
      info.appendChild(stats);
      card.appendChild(cover);
      card.appendChild(info);
      booksContainer.appendChild(card);

      // ---- Load real chapter count ----
      // Assumes a "chapters" table with a "book_id" column.
      // If your chapters table also has a status column (e.g. "published"),
      // add .eq("status", "published") below to only count published chapters.
      client
        .from("chapters")
        .select("id", { count: "exact", head: true })
        .eq("book_id", book.id)
        .then(function (result) {
          if (result.error) {
            console.error("LITDOM CHAPTER COUNT ERROR:", result.error);
            return;
          }
          const chapterNumber = chapters.querySelector(".ldr-book-stat-number");
          if (chapterNumber) {
            chapterNumber.textContent = formatCount(result.count ?? 0);
          }
        })
        .catch(function (error) {
          console.error("LITDOM CHAPTER COUNT REQUEST ERROR:", error);
        });

      // ---- Load real chapter likes ----
      client
        .rpc("get_book_engagement", { p_book_id: book.id })
        .then(function (result) {
          if (result.error) {
            console.error("LITDOM BOOK ENGAGEMENT ERROR:", result.error);
            return;
          }
          const likesNumber = likes.querySelector(".ldr-book-stat-number");
          if (likesNumber) {
            likesNumber.textContent = formatCount(result.data?.total_likes ?? 0);
          }
        })
        .catch(function (error) {
          console.error("LITDOM ENGAGEMENT REQUEST ERROR:", error);
        });

    });
  }

  loadFreshReleases();

})();
</script>
</div>
