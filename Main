<script>

document.addEventListener(
  "DOMContentLoaded",
  async function () {

    /* =====================================================
       SUPABASE
    ===================================================== */

    const SUPABASE_URL =
      "https://uniecvgkxhcbedppadgx.supabase.co";

    const SUPABASE_KEY =
      "sb_publishable_UhqP7y8Cjyiv8RebOSMUDA_lBj0QuTE";

    const supabaseClient =
      window.supabase.createClient(
        SUPABASE_URL,
        SUPABASE_KEY,
        {
          auth: {
            persistSession: true,
            autoRefreshToken: true,
            detectSessionInUrl: true
          }
        }
      );


    /* =====================================================
       ELEMENTS
    ===================================================== */

    const booksContainer =
      document.getElementById(
        "led-books"
      );

    const bookCount =
      document.getElementById(
        "led-book-count"
      );

    const reviewPanel =
      document.getElementById(
        "led-review-panel"
      );

    const closeReview =
      document.getElementById(
        "led-close-review"
      );

    const approveBookButton =
      document.getElementById(
        "led-approve-book"
      );

    const rejectBookButton =
      document.getElementById(
        "led-reject-book"
      );

    const diamondPriceInput =
      document.getElementById(
        "led-book-diamond-price"
      );

    const saveDiamondPriceButton =
      document.getElementById(
        "led-save-diamond-price"
      );

    let currentReviewBook = null;

    let allBooks = [];

    let deletionRequestedBookIds =
      new Set();


    /* =====================================================
       CHECK LOGIN
    ===================================================== */

    const {
      data: {
        session
      }
    } =
      await supabaseClient.auth.getSession();


    if (!session) {

      booksContainer.innerHTML =
        "<div class='led-message'>" +
        "Please log in to use the Editor Dashboard." +
        "</div>";

      return;
    }


    /* =====================================================
       DELETION REQUEST NOTIFICATION
    ===================================================== */

    async function updateDeletionNotification() {

      deletionRequestedBookIds =
        new Set();

      if (!allBooks.length) {
        updateDeletionDot();
        return;
      }

      const bookIds =
        allBooks
          .map(function (book) {
            return book.book_id;
          })
          .filter(Boolean);


      if (!bookIds.length) {
        updateDeletionDot();
        return;
      }


      const {
        data: deletionRequests,
        error
      } =
        await supabaseClient
          .from("chapters")
          .select(
            "id,book_id"
          )
          .in(
            "book_id",
            bookIds
          )
          .eq(
            "deletion_requested",
            true
          );


      if (error) {

        console.error(
          "CHAPTER DELETION REQUEST LOAD ERROR:",
          error
        );

        updateDeletionDot();

        return;
      }


      (deletionRequests || []).forEach(
        function (chapter) {

          deletionRequestedBookIds.add(
            chapter.book_id
          );

        }
      );


      updateDeletionDot();

    }


    /* =====================================================
       RED NOTIFICATION DOT
    ===================================================== */

    function updateDeletionDot() {

      let dot =
        document.getElementById(
          "led-deletion-notification-dot"
        );


      if (!dot) {

        dot =
          document.createElement(
            "span"
          );

        dot.id =
          "led-deletion-notification-dot";

        dot.className =
          "led-deletion-dot";

        dot.setAttribute(
          "aria-label",
          "Chapter deletion requests pending"
        );

        dot.title =
          "There are pending chapter deletion requests";


        const booksHeading =
          document.querySelector(
            "#litdom-editor-dashboard .led-section:first-of-type .led-section-title h2"
          );


        if (booksHeading) {

          booksHeading.appendChild(
            dot
          );

        }

      }


      dot.style.display =
        deletionRequestedBookIds.size > 0
          ? "inline-block"
          : "none";

    }


    /* =====================================================
       LOAD ALL BOOK SUBMISSIONS
    ===================================================== */

    async function loadBooks() {

      booksContainer.innerHTML =
        "<div class='led-message'>" +
        "Loading books..." +
        "</div>";


      const {
        data: submissions,
        error
      } =
        await supabaseClient
          .from("book_submissions")
          .select(
            "id,author_id,book_id,title,description,genre,cover_url,status,created_at,submitted_at,subgenre,book_outline,protagonist,antagonist,additional_details,author_details"
          )
          .order(
            "created_at",
            {
              ascending: false
            }
          );


      if (error) {

        console.error(
          "EDITOR BOOK LOAD ERROR:",
          error
        );


        booksContainer.innerHTML =
          "<div class='led-message'>" +
          "Could not load book submissions." +
          "</div>";

        return;

      }


      allBooks =
        submissions || [];


      bookCount.textContent =
        allBooks.length;


      await updateDeletionNotification();


      if (allBooks.length === 0) {

        booksContainer.innerHTML =
          "<div class='led-message'>" +
          "No book submissions yet." +
          "</div>";

        return;

      }


      /* ===================================================
         BOOK GROUPS
      =================================================== */

      const approvedBooks =
        allBooks.filter(
          function (book) {

            return (
              String(
                book.status || ""
              ).toLowerCase() ===
              "approved" ||
              String(
                book.status || ""
              ).toLowerCase() ===
              "published"
            );

          }
        );


      const rejectedBooks =
        allBooks.filter(
          function (book) {

            return (
              String(
                book.status || ""
              ).toLowerCase() ===
              "rejected"
            );

          }
        );


      const otherBooks =
        allBooks.filter(
          function (book) {

            const status =
              String(
                book.status || ""
              ).toLowerCase();

            return (
              status !== "approved" &&
              status !== "published" &&
              status !== "rejected"
            );

          }
        );


      booksContainer.innerHTML =
        "";


      /* ===================================================
         BOOK GROUP WRAPPER
      =================================================== */

      const groups =
        document.createElement(
          "div"
        );

      groups.className =
        "led-book-groups";


      /* ===================================================
         APPROVED BOOKS
      =================================================== */

      const approvedSection =
        document.createElement(
          "div"
        );

      approvedSection.className =
        "led-book-group led-approved-group";


      const approvedHeader =
        document.createElement(
          "div"
        );

      approvedHeader.className =
        "led-book-group-header";


      const approvedEyebrow =
        document.createElement(
          "div"
        );

      approvedEyebrow.className =
        "led-eyebrow";

      approvedEyebrow.textContent =
        "APPROVED";


      const approvedTitle =
        document.createElement(
          "h3"
        );

      approvedTitle.textContent =
        "Approved Books";


      approvedHeader.appendChild(
        approvedEyebrow
      );

      approvedHeader.appendChild(
        approvedTitle
      );


      const approvedScroller =
        document.createElement(
          "div"
        );

      approvedScroller.className =
        "led-approved-scroll";


      const approvedTrack =
        document.createElement(
          "div"
        );

      approvedTrack.className =
        "led-approved-track";


      if (approvedBooks.length === 0) {

        approvedScroller.innerHTML =
          "<div class='led-message'>" +
          "No approved books yet." +
          "</div>";

      } else {

        approvedBooks.forEach(
          function (book) {

            approvedTrack.appendChild(
              createBookCard(book)
            );

          }
        );

        approvedScroller.appendChild(
          approvedTrack
        );

      }


      approvedSection.appendChild(
        approvedHeader
      );

      approvedSection.appendChild(
        approvedScroller
      );


      groups.appendChild(
        approvedSection
      );


      /* ===================================================
         REJECTED BOOKS
      =================================================== */

      const rejectedSection =
        document.createElement(
          "div"
        );

      rejectedSection.className =
        "led-book-group led-rejected-group";


      const rejectedHeader =
        document.createElement(
          "div"
        );

      rejectedHeader.className =
        "led-book-group-header";


      const rejectedEyebrow =
        document.createElement(
          "div"
        );

      rejectedEyebrow.className =
        "led-eyebrow";

      rejectedEyebrow.textContent =
        "REJECTED";


      const rejectedTitle =
        document.createElement(
          "h3"
        );

      rejectedTitle.textContent =
        "Rejected Books";


      rejectedHeader.appendChild(
        rejectedEyebrow
      );

      rejectedHeader.appendChild(
        rejectedTitle
      );


      const rejectedList =
        document.createElement(
          "div"
        );

      rejectedList.className =
        "led-rejected-list";


      if (rejectedBooks.length === 0) {

        rejectedList.innerHTML =
          "<div class='led-message'>" +
          "No rejected books." +
          "</div>";

      } else {

        rejectedBooks.forEach(
          function (book) {

            rejectedList.appendChild(
              createBookCard(book)
            );

          }
        );

      }


      rejectedSection.appendChild(
        rejectedHeader
      );

      rejectedSection.appendChild(
        rejectedList
      );


      groups.appendChild(
        rejectedSection
      );


      /* ===================================================
         OTHER / PENDING BOOKS
      =================================================== */

      if (otherBooks.length > 0) {

        const otherSection =
          document.createElement(
            "div"
          );

        otherSection.className =
          "led-book-group led-other-group";


        const otherHeader =
          document.createElement(
            "div"
          );

        otherHeader.className =
          "led-book-group-header";


        const otherEyebrow =
          document.createElement(
            "div"
          );

        otherEyebrow.className =
          "led-eyebrow";

        otherEyebrow.textContent =
          "REVIEW QUEUE";


        const otherTitle =
          document.createElement(
            "h3"
          );

        otherTitle.textContent =
          "Books Awaiting Review";


        otherHeader.appendChild(
          otherEyebrow
        );

        otherHeader.appendChild(
          otherTitle
        );


        const otherList =
          document.createElement(
            "div"
          );

        otherList.className =
          "led-other-list";


        otherBooks.forEach(
          function (book) {

            otherList.appendChild(
              createBookCard(book)
            );

          }
        );


        otherSection.appendChild(
          otherHeader
        );

        otherSection.appendChild(
          otherList
        );


        groups.appendChild(
          otherSection
        );

      }


      booksContainer.appendChild(
        groups
      );

    }


    /* =====================================================
       CREATE BOOK CARD
    ===================================================== */

    function createBookCard(
      book
    ) {

      const card =
        document.createElement(
          "div"
        );

      card.className =
        "led-book-card";


      const cover =
        document.createElement(
          "div"
        );

      cover.className =
        "led-book-cover";


      if (book.cover_url) {

        cover.style.backgroundImage =
          "url('" +
          book.cover_url +
          "')";

      }


      const info =
        document.createElement(
          "div"
        );

      info.className =
        "led-book-info";


      const title =
        document.createElement(
          "h3"
        );

      title.textContent =
        book.title ||
        "Untitled Book";


      const author =
        document.createElement(
          "p"
        );

      const authorDetails =
        book.author_details ||
        {};


      author.textContent =
        "Author: " +
        (
          authorDetails.pen_name ||
          authorDetails.full_name ||
          "Unknown"
        );


      const genre =
        document.createElement(
          "p"
        );

      genre.textContent =
        "Genre: " +
        (
          book.genre ||
          "Not specified"
        );


      const status =
        document.createElement(
          "span"
        );

      status.className =
        "led-status";

      status.textContent =
        book.status ||
        "draft";


      info.appendChild(
        title
      );

      info.appendChild(
        author
      );

      info.appendChild(
        genre
      );

      info.appendChild(
        status
      );


      /* ===================================================
         DELETION REQUEST BADGE
      =================================================== */

      if (
        deletionRequestedBookIds.has(
          book.book_id
        )
      ) {

        const deletionBadge =
          document.createElement(
            "span"
          );

        deletionBadge.className =
          "led-deletion-request-badge";

        deletionBadge.textContent =
          "Chapter deletion requested";


        info.appendChild(
          deletionBadge
        );

      }


      const button =
        document.createElement(
          "button"
        );

      button.type =
        "button";

      button.className =
        "led-review-button";

      button.textContent =
        "Open Review";


      button.addEventListener(
        "click",
        function () {

          openBookReview(
            book
          );

        }
      );


      card.appendChild(
        cover
      );

      card.appendChild(
        info
      );

      card.appendChild(
        button
      );


      return card;

    }


    /* =====================================================
       OPEN BOOK REVIEW
    ===================================================== */

    async function openBookReview(
      book
    ) {

      currentReviewBook =
        book;


      const title =
        document.getElementById(
          "led-review-title"
        );

      const author =
        document.getElementById(
          "led-review-author"
        );

      const details =
        document.getElementById(
          "led-review-details"
        );

      const chapters =
        document.getElementById(
          "led-review-chapters"
        );


      title.textContent =
        book.title ||
        "Untitled Book";


      const authorDetails =
        book.author_details ||
        {};


      author.textContent =
        "Author: " +
        (
          authorDetails.pen_name ||
          authorDetails.full_name ||
          "Unknown author"
        );


      /* ===================================================
         CLEAR OLD DETAILS FIRST
      =================================================== */

      details.innerHTML =
        "";

      diamondPriceInput.value =
        "";


      /* ===================================================
         BASIC BOOK DETAILS
      =================================================== */

      addDetail(
        details,
        "Status",
        book.status ||
        "Not provided"
      );


      addDetail(
        details,
        "Genre",
        book.genre
      );


      addDetail(
        details,
        "Subgenre",
        book.subgenre
      );


      addDetail(
        details,
        "Description",
        book.description
      );


      addDetail(
        details,
        "Book Outline",
        book.book_outline
      );


      addDetail(
        details,
        "Author Name",
        authorDetails.full_name
      );


      addDetail(
        details,
        "Pen Name",
        authorDetails.pen_name
      );


      addDetail(
        details,
        "Author Bio",
        authorDetails.bio
      );


      addDetail(
        details,
        "Email",
        authorDetails.email
      );


      addDetail(
        details,
        "Phone",
        authorDetails.phone
      );


      /* ===================================================
         SUBMITTED PAYOUT INFORMATION
      =================================================== */

      const additionalDetails =
        book.additional_details ||
        {};


      addDetail(
        details,
        "Bank Name",
        additionalDetails.bank_name
      );


      addDetail(
        details,
        "Account Name",
        additionalDetails.account_name
      );


      addDetail(
        details,
        "Account Number",
        additionalDetails.account_number
      );


      /* ===================================================
         BOOK STATISTICS
      =================================================== */

      if (book.book_id) {

        const {
          count: rubyCount
        } =
          await supabaseClient
            .from("chapter_unlocks")
            .select(
              "id",
              {
                count: "exact",
                head: true
              }
            )
            .eq(
              "book_id",
              book.book_id
            );


        const {
          count: diamondCount
        } =
          await supabaseClient
            .from("book_unlocks")
            .select(
              "id",
              {
                count: "exact",
                head: true
              }
            )
            .eq(
              "book_id",
              book.book_id
            );


        addDetail(
          details,
          "Total Rubies Spent (Chapter Unlocks)",
          String(
            rubyCount || 0
          )
        );


        addDetail(
          details,
          "Total Diamonds Spent (Book Unlocks)",
          String(
            diamondCount || 0
          )
        );

      }


      /* ===================================================
         LOAD SAVED DIAMOND PRICE
      =================================================== */

      if (book.book_id) {

        const {
          data: bookPricing,
          error: bookPricingError
        } =
          await supabaseClient
            .from("books")
            .select(
              "full_book_unlock_cost"
            )
            .eq(
              "id",
              book.book_id
            )
            .maybeSingle();


        if (
          bookPricingError
        ) {

          console.error(
            "BOOK PRICING LOAD ERROR:",
            bookPricingError
          );

        } else if (
          bookPricing &&
          bookPricing.full_book_unlock_cost !== null &&
          bookPricing.full_book_unlock_cost !== undefined
        ) {

          diamondPriceInput.value =
            bookPricing.full_book_unlock_cost;

        }

      }


      /* ===================================================
         LOAD CHAPTERS
      =================================================== */

      chapters.innerHTML =
        "<div class='led-message'>" +
        "Loading chapters..." +
        "</div>";


      if (!book.book_id) {

        chapters.innerHTML =
          "<div class='led-message'>" +
          "This submission has no linked book." +
          "</div>";

        reviewPanel.style.display =
          "block";

        return;

      }


      const {
        data: chapterData,
        error: chapterError
      } =
        await supabaseClient
          .from("chapters")
          .select(
            "id,book_id,chapter_number,title,content,status,word_count,is_locked,unlock_cost,updated_at,created_at,published_at,submitted_at,reviewed_at,reviewed_by,deletion_requested"
          )
          .eq(
            "book_id",
            book.book_id
          )
          .order(
            "chapter_number",
            {
              ascending: true
            }
          );


      if (chapterError) {

        console.error(
          "CHAPTER LOAD ERROR:",
          chapterError
        );


        chapters.innerHTML =
          "<div class='led-message'>" +
          "Could not load chapters." +
          "</div>";

      } else if (
        !chapterData ||
        chapterData.length === 0
      ) {

        chapters.innerHTML =
          "<div class='led-message'>" +
          "No chapters submitted yet." +
          "</div>";

      } else {

        chapters.innerHTML =
          "";


        chapterData.forEach(
          function (chapter) {

            const chapterCard =
              document.createElement(
                "div"
              );

            chapterCard.className =
              "led-chapter-card";


            const chapterInfo =
              document.createElement(
                "div"
              );

            chapterInfo.className =
              "led-chapter-info";


            const chapterTitle =
              document.createElement(
                "h4"
              );

            chapterTitle.textContent =
              "Chapter " +
              (
                chapter.chapter_number ||
                "?"
              ) +
              ": " +
              (
                chapter.title ||
                "Untitled Chapter"
              );


            const chapterMeta =
              document.createElement(
                "p"
              );

            chapterMeta.textContent =
              (
                chapter.word_count ||
                0
              ) +
              " words • " +
              (
                chapter.status ||
                "draft"
              );


            const lockedMeta =
              document.createElement(
                "p"
              );

            lockedMeta.textContent =
              chapter.is_locked
                ? "Locked chapter • " +
                  (
                    chapter.unlock_cost ||
                    0
                  ) +
                  " rubies"
                : "Free chapter";


            chapterInfo.appendChild(
              chapterTitle
            );

            chapterInfo.appendChild(
              chapterMeta
            );

            chapterInfo.appendChild(
              lockedMeta
            );


            /* =================================================
               RUBY PRICE CONTROL
            ================================================= */

            const priceWrap =
              document.createElement(
                "div"
              );

            priceWrap.className =
              "led-chapter-price-wrap";


            const priceLabel =
              document.createElement(
                "label"
              );

            priceLabel.textContent =
              "Ruby price";


            const priceInput =
              document.createElement(
                "input"
              );

            priceInput.type =
              "number";

            priceInput.min =
              "0";

            priceInput.step =
              "1";

            priceInput.placeholder =
              "Free";


            if (
              chapter.unlock_cost !== null &&
              chapter.unlock_cost !== undefined
            ) {

              priceInput.value =
                chapter.unlock_cost;

            }


            const savePriceButton =
              document.createElement(
                "button"
              );

            savePriceButton.type =
              "button";

            savePriceButton.className =
              "led-small-button";

            savePriceButton.textContent =
              "Save Ruby Price";


            savePriceButton.addEventListener(
              "click",
              async function () {

                const rawValue =
                  priceInput.value.trim();


                if (rawValue === "") {

                  const {
                    error
                  } =
                    await supabaseClient
                      .from("chapters")
                      .update({
                        unlock_cost: null,
                        is_locked: false,
                        updated_at:
                          new Date().toISOString()
                      })
                      .eq(
                        "id",
                        chapter.id
                      );


                  if (error) {

                    console.error(
                      "CLEAR RUBY PRICE ERROR:",
                      error
                    );

                    alert(
                      "Could not clear the Ruby price."
                    );

                    return;

                  }


                  alert(
                    "Chapter is now free."
                  );

                  openBookReview(
                    currentReviewBook
                  );

                  return;

                }


                const amount =
                  parseInt(
                    rawValue,
                    10
                  );


                if (
                  !Number.isInteger(amount) ||
                  amount < 0
                ) {

                  alert(
                    "Please enter a valid Ruby amount."
                  );

                  return;

                }


                const {
                  error
                } =
                  await supabaseClient
                    .from("chapters")
                    .update({
                      unlock_cost:
                        amount,
                      is_locked:
                        amount > 0,
                      updated_at:
                        new Date().toISOString()
                    })
                    .eq(
                      "id",
                      chapter.id
                    );


                if (error) {

                  console.error(
                    "SAVE RUBY PRICE ERROR:",
                    error
                  );

                  alert(
                    "Could not save the Ruby price."
                  );

                  return;

                }


                alert(
                  amount > 0
                    ? "Ruby price saved."
                    : "Chapter is now free."
                );


                openBookReview(
                  currentReviewBook
                );

              }
            );


            priceWrap.appendChild(
              priceLabel
            );

            priceWrap.appendChild(
              priceInput
            );

            priceWrap.appendChild(
              savePriceButton
            );


            /* =================================================
               REVIEW ACTIONS
            ================================================= */

            const actions =
              document.createElement(
                "div"
              );

            actions.className =
              "led-review-actions";


            /* =================================================
               DELETE CHAPTER REQUEST
            ================================================= */

            if (
              chapter.deletion_requested ===
              true
            ) {

              const deleteChapterButton =
                document.createElement(
                  "button"
                );

              deleteChapterButton.type =
                "button";

              deleteChapterButton.className =
                "led-delete-request-button";

              deleteChapterButton.textContent =
                "Delete Chapter";


              deleteChapterButton.addEventListener(
                "click",
                async function () {

                  const confirmed =
                    confirm(
                      "Delete this chapter permanently? This cannot be undone."
                    );


                  if (!confirmed) {
                    return;
                  }


                  deleteChapterButton.disabled =
                    true;

                  deleteChapterButton.textContent =
                    "Deleting...";


                  const {
                    error
                  } =
                    await supabaseClient
                      .from("chapters")
                      .delete()
                      .eq(
                        "id",
                        chapter.id
                      )
                      .eq(
                        "deletion_requested",
                        true
                      );


                  if (error) {

                    console.error(
                      "DELETE CHAPTER ERROR:",
                      error
                    );

                    alert(
                      "Could not delete the chapter."
                    );


                    deleteChapterButton.disabled =
                      false;

                    deleteChapterButton.textContent =
                      "Delete Chapter";

                    return;

                  }


                  alert(
                    "Chapter deleted successfully."
                  );


                  await loadBooks();


                  if (
                    currentReviewBook
                  ) {

                    await openBookReview(
                      currentReviewBook
                    );

                  }

                }
              );


              actions.appendChild(
                deleteChapterButton
              );

            }


            /* =================================================
               APPROVE CHAPTER
            ================================================= */

            const approveChapterButton =
              document.createElement(
                "button"
              );

            approveChapterButton.type =
              "button";

            approveChapterButton.className =
              "led-small-button";

            approveChapterButton.textContent =
              "Approve Chapter";


            approveChapterButton.addEventListener(
              "click",
              async function () {

                const {
                  error
                } =
                  await supabaseClient
                    .from("chapters")
                    .update({
                      status:
                        "published",
                      reviewed_at:
                        new Date().toISOString(),
                      reviewed_by:
                        session.user.id,
                      published_at:
                        new Date().toISOString(),
                      updated_at:
                        new Date().toISOString()
                    })
                    .eq(
                      "id",
                      chapter.id
                    );


                if (error) {

                  console.error(
                    "APPROVE CHAPTER ERROR:",
                    error
                  );

                  alert(
                    "Could not approve the chapter."
                  );

                  return;

                }


                alert(
                  "Chapter approved and published."
                );


                await loadBooks();

                await openBookReview(
                  currentReviewBook
                );

              }
            );


            /* =================================================
               REJECT CHAPTER
            ================================================= */

            const rejectChapterButton =
              document.createElement(
                "button"
              );

            rejectChapterButton.type =
              "button";

            rejectChapterButton.className =
              "led-small-button";

            rejectChapterButton.textContent =
              "Reject Chapter";


            rejectChapterButton.addEventListener(
              "click",
              async function () {

                const {
                  error
                } =
                  await supabaseClient
                    .from("chapters")
                    .update({
                      status:
                        "rejected",
                      reviewed_at:
                        new Date().toISOString(),
                      reviewed_by:
                        session.user.id,
                      updated_at:
                        new Date().toISOString()
                    })
                    .eq(
                      "id",
                      chapter.id
                    );


                if (error) {

                  console.error(
                    "REJECT CHAPTER ERROR:",
                    error
                  );

                  alert(
                    "Could not reject the chapter."
                  );

                  return;

                }


                alert(
                  "Chapter rejected."
                );


                await loadBooks();

                await openBookReview(
                  currentReviewBook
                );

              }
            );


            actions.appendChild(
              approveChapterButton
            );

            actions.appendChild(
              rejectChapterButton
            );


            chapterCard.appendChild(
              chapterInfo
            );

            chapterCard.appendChild(
              priceWrap
            );

            chapterCard.appendChild(
              actions
            );


            chapters.appendChild(
              chapterCard
            );

          }
        );

      }


      /* ===================================================
         SHOW REVIEW PANEL
      =================================================== */

      reviewPanel.style.display =
        "block";


      reviewPanel.scrollIntoView({
        behavior: "smooth",
        block: "start"
      });

    }


    /* =====================================================
       ADD DETAIL HELPER
    ===================================================== */

    function addDetail(
      container,
      label,
      value
    ) {

      if (
        value === null ||
        value === undefined ||
        String(value).trim() === ""
      ) {
        return;
      }


      const row =
        document.createElement(
          "div"
        );

      row.className =
        "led-detail-row";


      const labelElement =
        document.createElement(
          "strong"
        );

      labelElement.textContent =
        label;


      const valueElement =
        document.createElement(
          "span"
        );

      valueElement.textContent =
        String(value);


      row.appendChild(
        labelElement
      );

      row.appendChild(
        valueElement
      );


      container.appendChild(
        row
      );

    }


    /* =====================================================
       CLOSE REVIEW
    ===================================================== */

    closeReview.addEventListener(
      "click",
      function () {

        reviewPanel.style.display =
          "none";

        currentReviewBook =
          null;

      }
    );


    /* =====================================================
       APPROVE BOOK
    ===================================================== */

    approveBookButton.addEventListener(
      "click",
      async function () {

        if (
          !currentReviewBook ||
          !currentReviewBook.id
        ) {
          return;
        }


        const confirmed =
          confirm(
            "Approve this book and publish it?"
          );


        if (!confirmed) {
          return;
        }


        approveBookButton.disabled =
          true;


        const now =
          new Date().toISOString();


        const {
          error: submissionError
        } =
          await supabaseClient
            .from("book_submissions")
            .update({
              status:
                "approved"
            })
            .eq(
              "id",
              currentReviewBook.id
            );


        if (submissionError) {

          console.error(
            "APPROVE SUBMISSION ERROR:",
            submissionError
          );

          alert(
            "Could not approve the submission."
          );

          approveBookButton.disabled =
            false;

          return;

        }


        const {
          error: bookError
        } =
          await supabaseClient
            .from("books")
            .update({
              status:
                "published",
              submission_status:
                "approved",
              published_at:
                now,
              updated_at:
                now
            })
            .eq(
              "id",
              currentReviewBook.book_id
            );


        if (bookError) {

          console.error(
            "APPROVE BOOK ERROR:",
            bookError
          );

          alert(
            "Submission approved, but the book itself could not be published."
          );

          approveBookButton.disabled =
            false;

          return;

        }


        alert(
          "Book approved and published."
        );


        approveBookButton.disabled =
          false;


        await loadBooks();

        reviewPanel.style.display =
          "none";

        currentReviewBook =
          null;

      }
    );


    /* =====================================================
       REJECT BOOK
    ===================================================== */

    rejectBookButton.addEventListener(
      "click",
      async function () {

        if (
          !currentReviewBook ||
          !currentReviewBook.id
        ) {
          return;
        }


        const confirmed =
          confirm(
            "Reject this book submission?"
          );


        if (!confirmed) {
          return;
        }


        rejectBookButton.disabled =
          true;


        const now =
          new Date().toISOString();


        const {
          error: submissionError: submissionError
        } =
          await supabaseClient
            .from("book_submissions")
            .update({
              status:
                "rejected"
            })
            .eq(
              "id",
              currentReviewBook.id
            );


        if (submissionError) {

          console.error(
            "REJECT SUBMISSION ERROR:",
            submissionError
          );

          alert(
            "Could not reject the submission."
          );

          rejectBookButton.disabled =
            false;

          return;

        }


        const {
          error: bookError
        } =
          await supabaseClient
            .from("books")
            .update({
              status:
                "rejected",
              submission_status:
                "rejected",
              updated_at:
                now
            })
            .eq(
              "id",
              currentReviewBook.book_id
            );


        if (bookError) {

          console.error(
            "REJECT BOOK ERROR:",
            bookError
          );

          alert(
            "Submission rejected, but the book itself could not be updated."
          );

          rejectBookButton.disabled =
            false;

          return;

        }


        alert(
          "Book rejected."
        );


        rejectBookButton.disabled =
          false;


        await loadBooks();

        reviewPanel.style.display =
          "none";

        currentReviewBook =
          null;

      }
    );


    /* =====================================================
       SAVE DIAMOND PRICE
    ===================================================== */

    saveDiamondPriceButton.addEventListener(
      "click",
      async function () {

        if (
          !currentReviewBook ||
          !currentReviewBook.book_id
        ) {
          return;
        }


        const rawValue =
          diamondPriceInput.value.trim();


        if (rawValue === "") {

          alert(
            "Please enter a Diamond price."
          );

          return;

        }


        const amount =
          parseInt(
            rawValue,
            10
          );


        if (
          !Number.isInteger(amount) ||
          amount < 0
        ) {

          alert(
            "Please enter a valid Diamond amount."
          );

          return;

        }


        const {
          error
        } =
          await supabaseClient
            .from("books")
            .update({
              full_book_unlock_cost:
                amount,
              updated_at:
                new Date().toISOString()
            })
            .eq(
              "id",
              currentReviewBook.book_id
            );


        if (error) {

          console.error(
            "SAVE DIAMOND PRICE ERROR:",
            error
          );

          alert(
            "Could not save the Diamond price."
          );

          return;

        }


        alert(
          "Diamond price saved."
        );

      }
    );


    /* =====================================================
       WITHDRAWAL REQUESTS
    ===================================================== */

    const withdrawalContainer =
      document.getElementById(
        "led-withdrawals"
      );

    const withdrawalCount =
      document.getElementById(
        "led-withdrawal-count"
      );


    async function loadWithdrawals() {

      if (!withdrawalContainer) {
        return;
      }


      withdrawalContainer.innerHTML =
        "<div class='led-message'>" +
        "Loading withdrawal requests..." +
        "</div>";


      const {
        data: withdrawals,
        error
      } =
        await supabaseClient
          .from("withdrawal_requests")
          .select(
            "id,user_id,amount,currency,status,created_at,payout_account_id"
          )
          .order(
            "created_at",
            {
              ascending: false
            }
          );


      if (error) {

        console.error(
          "WITHDRAWAL LOAD ERROR:",
          error
        );


        withdrawalContainer.innerHTML =
          "<div class='led-message'>" +
          "Could not load withdrawal requests." +
          "</div>";

        return;

      }


      withdrawalCount.textContent =
        (
          withdrawals ||
          []
        ).length;


      if (
        !withdrawals ||
        withdrawals.length === 0
      ) {

        withdrawalContainer.innerHTML =
          "<div class='led-message'>" +
          "No withdrawal requests yet." +
          "</div>";

        return;

      }


      /* ===================================================
         LOAD PAYOUT ACCOUNTS
      =================================================== */

      const payoutIds =
        withdrawals
          .map(function (item) {
            return item.payout_account_id;
          })
          .filter(Boolean);


      let payoutAccounts =
        [];


      if (
        payoutIds.length > 0
      ) {

        const {
          data: payoutData,
          error: payoutError
        } =
          await supabaseClient
            .from("payout_accounts")
            .select(
              "id,account_name,bank_name,account_number"
            )
            .in(
              "id",
              payoutIds
            );


        if (payoutError) {

          console.error(
            "PAYOUT ACCOUNT LOAD ERROR:",
            payoutError
          );

        } else {

          payoutAccounts =
            payoutData ||
            [];

        }

      }


      withdrawalContainer.innerHTML =
        "";


      withdrawals.forEach(
        function (request) {

          const payout =
            payoutAccounts.find(
              function (account) {

                return (
                  account.id ===
                  request.payout_account_id
                );

              }
            ) ||
            {};


          const card =
            document.createElement(
              "div"
            );

          card.className =
            "led-withdrawal-card";


          const title =
            document.createElement(
              "h4"
            );

          title.textContent =
            (
              request.amount ||
              0
            ) +
            " " +
            (
              request.currency ||
              ""
            );


          const status =
            document.createElement(
              "p"
            );

          status.textContent =
            "Status: " +
            (
              request.status ||
              "pending"
            );


          const date =
            document.createElement(
              "p"
            );

          date.textContent =
            "Requested: " +
            new Date(
              request.created_at
            ).toLocaleString();


          const payoutInfo =
            document.createElement(
              "p"
            );

          payoutInfo.textContent =
            "Bank: " +
            (
              payout.bank_name ||
              "Not provided"
            ) +
            " • Account: " +
            (
              payout.account_number ||
              "Not provided"
            );


          card.appendChild(
            title
          );

          card.appendChild(
            status
          );

          card.appendChild(
            date
          );

          card.appendChild(
            payoutInfo
          );


          if (
            String(
              request.status ||
              ""
            ).toLowerCase() ===
            "pending"
          ) {

            const payButton =
              document.createElement(
                "button"
              );

            payButton.type =
              "button";

            payButton.className =
              "led-small-button";

            payButton.textContent =
              "Mark as Paid";


            payButton.addEventListener(
              "click",
              async function () {

                const confirmed =
                  confirm(
                    "Mark this withdrawal request as paid?"
                  );


                if (!confirmed) {
                  return;
                }


                payButton.disabled =
                  true;


                const {
                  error
                } =
                  await supabaseClient
                    .from("withdrawal_requests")
                    .update({
                      status:
                        "paid",
                      updated_at:
                        new Date().toISOString()
                    })
                    .eq(
                      "id",
                      request.id
                    );


                if (error) {

                  console.error(
                    "MARK WITHDRAWAL PAID ERROR:",
                    error
                  );

                  alert(
                    "Could not update the withdrawal."
                  );

                  payButton.disabled =
                    false;

                  return;

                }


                alert(
                  "Withdrawal marked as paid."
                );


                await loadWithdrawals();

              }
            );


            card.appendChild(
              payButton
            );

          }


          withdrawalContainer.appendChild(
            card
          );

        }
      );

    }


    /* =====================================================
       SET MONTHLY EARNINGS
    ===================================================== */

    const earningsInput =
      document.getElementById(
        "led-earnings-input"
      );

   
     