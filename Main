const bookIds =
  books
    .map(function (book) {
      return book.book_id;
    })
    .filter(function (id) {
      return !!id;
    });


if (bookIds.length > 0) {

  const {
    data: currentBookRows,
    error: currentBookError
  } =
    await supabaseClient
      .from("books")
      .select("id,title,cover_url")
      .in("id", bookIds);


  if (currentBookError) {

    console.error(
      "CURRENT BOOK TITLE/COVER LOAD ERROR:",
      currentBookError
    );

  } else {

    (currentBookRows || []).forEach(
      function (currentBook) {

        const submission =
          books.find(
            function (book) {
              return book.book_id === currentBook.id;
            }
          );


        if (submission) {

          submission.title =
            currentBook.title ||
            submission.title;

          submission.cover_url =
            currentBook.cover_url ||
            submission.cover_url;

        }

      }
    );

  }

}