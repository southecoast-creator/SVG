                  additionalDetails

              })
              .select(
                "id,book_id,status,submitted_at"
              )
              .single(),

            new Promise(function (
              resolve
            ) {

              setTimeout(
                function () {

                  resolve({

                    data: null,

                    error: {
                      message:
                        "Submission request timed out. Please check your connection and try again."
                    }

                  });

                },
                15000
              );

            })

          ]);

      } catch (error) {

