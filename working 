              /*
               * Get logged-in reader.
               */

              const {
                data: {
                  user
                },

                error:
                  userError

              } =
                await litdomSupabase
                  .auth
                  .getUser();


              if (
                userError ||
                !user
              ) {

                throw new Error(
                  "Please sign in before sending a gift."
                );

              }


              /*
               * Check email.
               */

              if (
                !user.email
              ) {

                throw new Error(
                  "Your account does not have an email address."
                );

              }


              /*
               * Create gift payment.
               ** IMPORTANT:
               * Send the detected currency to the
               * Edge Function.
               */

              const {
                data,
                error
              } =
                await litdomSupabase
                  .functions
                  .invoke(
                    "create-gift-payment",
                    {
                      body: {

                        gift_type:
                          gift.type,

                        book_id:
                          bookId,

                        chapter_id:
                          chapter.id,

                        sender_id:
                          user.id,

                        receiver_id:
                          bookAuthorId,

                        email:
                          user.email,

                        currency:
                          detectedCurrency

                      }

                    }
                  );


              /*
               * Check Supabase function error.
               */

              if (error) {

                console.error(
                  "Gift payment function error:",
                  error
                );

                throw new Error(
                  error.message ||
                  "Unable to start the gift payment."
                );

              }


              /*
               * Check payment response.
               */

              if (
                !data ||
                !data.success ||
                !data.payment_link
              ) {

                console.error(
                  "Gift payment response:",
                  data
                );

                throw new Error(
                  data?.error ||
                  "Unable to create the gift payment."
                );

              }


              /*
               * Go to Flutterwave.
               */

              window.location.href =
                data.payment_link;


