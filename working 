 * LOAD GIFT COUNT
 * ============================================================
 */

async function loadGiftCount() {

  try {

    const {
      data: { user }
    } =
      await litdomSupabase.auth.getUser();

    if (!user) {
      return;
    }

    const {
      count,
      error
    } =
      await litdomSupabase
        .from("gift_payments")
        .select("id", {
          count: "exact",
          head: true
        })
        .eq(
          "sender_id",
          user.id
        )
        .in("status", [
          "successful",
          "completed"
        ]);

    if (error) {

      console.error(
        "Gift count error:",
        error
      );

      return;
    }

    const countElement =
      giftButton.querySelector(
        ".gift-count"
      );

    if (countElement) {

      countElement.textContent =
        String(count || 0);

    }

  } catch (error) {

    console.error(
      "Unable to load gift count:",
      error
    );

  }
}

loadGiftCount();


