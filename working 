             */

            giftCard.classList.add(
              "selected"
            );


            giftCard.dataset.processing =
              "true";


            /*
             * Save original card.
             */

            const originalContent =
              giftCard.innerHTML;


            /*
             * Show loading.
             */

            giftCard.innerHTML = `
