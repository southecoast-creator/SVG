/*
 * ============================================================
 * DETECT READER COUNTRY AND PAYMENT CURRENCY
 * ============================================================
 */

let readerCurrency = "NGN";

try {
  const locationResponse =
    await fetch(
      "https://ipapi.co/json/"
    );

  if (locationResponse.ok) {

    const locationData =
      await locationResponse.json();

    const countryCode =
      String(
        locationData?.country_code || "NG"
      )
        .toUpperCase()
        .trim();

    const countryCurrencyMap = {

      NG: "NGN",

      US: "USD",
      CA: "USD",

      GB: "GBP",

      IE: "EUR",
      FR: "EUR",
      DE: "EUR",
      ES: "EUR",
      IT: "EUR",
      PT: "EUR",
      NL: "EUR",
      BE: "EUR",
      AT: "EUR",
      FI: "EUR",
      GR: "EUR",

      ZA: "ZAR",

      GH: "GHS",

      KE: "KES",

      UG: "UGX",

      RW: "RWF",

      TZ: "TZS",

      MW: "MWK",

      CM: "XAF",

      SN: "XOF",

      EG: "EGP"
    };

    readerCurrency =
      countryCurrencyMap[
        countryCode
      ] || "USD";
  }

} catch (locationError) {

  console.warn(
    "Unable to detect reader country. Using NGN:",
    locationError
  );

  readerCurrency = "NGN";
}