      ========================= */

      const bankName =
        document.getElementById(
          "publication-bank-name"
        ).value.trim();

      const accountName =
        document.getElementById(
          "publication-account-name"
        ).value.trim();

      const accountNumber =
        document.getElementById(
          "publication-account-number"
        ).value.trim();


      const additionalDetails = {

        bank_name:
          bankName,

        account_name:
          accountName,

        account_number:
          accountNumber

      };


      /* =========================
         BOOK INFORMATION
      ========================= */

      const genre =
        document.getElementById(
          "publication-genre"
        ).value;

      const description =
        document.getElementById(
          "publication-description"
        ).value.trim();

      const outline =
        document.getElementById(
          "publication-outline"
        ).value.trim();


      /* =========================
         FICTION INFORMATION
      ========================= */

      let protagonist = {};
      let antagonist = {};


      if (
        book.book_type === "fiction"
      ) {

        const protagonistName =
          document.getElementById(
            "protagonist-name"
          ).value.trim();

        const protagonistProfile =
          document.getElementById(
            "protagonist-profile"
          ).value.trim();

        const protagonistTraits =
          document.getElementById(
            "protagonist-traits"
          ).value.trim();


        protagonist = {

          name:
            protagonistName,

          profile:
            protagonistProfile,

          traits:
            protagonistTraits

        };


        const antagonistName =
          document.getElementById(
            "antagonist-name"
          ).value.trim();

        const antagonistProfile =
          document.getElementById(
            "antagonist-profile"
          ).value.trim();

        const antagonistTraits =
          document.getElementById(
            "antagonist-traits"
          ).value.trim();


        antagonist = {

          name:
            antagonistName,

          profile:
            antagonistProfile,

          traits:
            antagonistTraits

        };

      }


      /* =========================
         CREATE SUBMISSION
      ========================= */

      message.textContent =
        "Sending your application for review...";


      let submissionResult;

      try {

        submissionResult =
          await Promise.race([

            supabaseClient
              .from("book_submissions")
              .insert({

                author_id:
                  user.id,

                book_id:
                  bookId,

                title:
                  book.title ||
                  null,

