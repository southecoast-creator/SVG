/*
 * ============================================================
 * DETERMINE READER CURRENCY
 * ============================================================
 */

const readerLocale =
  navigator.language ||
  "en-NG";

const localeCurrencyMap = {
  NG: "NGN",
  US: "USD",
  CA: "CAD",
  GB: "GBP",
  IE: "EUR",
  FR: "EUR",
  DE: "EUR",
  ES: "EUR",
  IT: "EUR",
  PT: "EUR",
  NL: "EUR",
  BE: "EUR",
  AT: "EUR",
  FI: "EUR",
  GR: "EUR",
  GH: "GHS",
  KE: "KES",
  ZA: "ZAR",
  UG: "UGX",
  RW: "RWF",
  TZ: "TZS",
  MW: "MWK",
  EG: "EGP",
  CM: "XAF",
  SN: "XOF"
};

const localeParts =
  readerLocale.split("-");

const readerCountry =
  localeParts.length > 1
    ? localeParts[
        localeParts.length - 1
      ].toUpperCase()
    : "NG";

const readerCurrency =
  localeCurrencyMap[
    readerCountry
  ] || "USD";


/*
 * ============================================================
 * CREATE GIFT PAYMENT
 * ============================================================
 */

const {
  data,
  error
} =
  await litdomSupabase.functions.invoke(
    "create-gift-payment",
    {
      body: {

        gift_type:
          gift.type,

        book_id:
          bookId,

        chapter_id:
          chapter.id,

        sender_id:
          user.id,

        receiver_id:
          bookAuthorId,

        email:
          user.email,

        currency:
          readerCurrency

      }
    }
  );