    font-weight: 700;
  }

  .wallet-earn-task {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 13px 0;
    border-bottom: 1px solid #f2ecef;
  }

  .wallet-earn-task:last-child {
    border-bottom: none;
  }

  .wallet-earn-task-info {
    font-size: 14px;
  }

  .wallet-earn-task-title {
    font-weight: 600;
    margin-bottom: 2px;
  }

  .wallet-earn-task-reward {
    color: #82786f;
    font-size: 12px;
  }

  .wallet-earn-task-button {
    padding: 8px 16px;
    border: 1px solid #241f1b;
    border-radius: 8px;
    background: transparent;
    color: #241f1b;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
  }

  /* ===== TOP-UP MODAL ===== */

  .wallet-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 999999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 16px;
    background: rgba(8, 7, 5, 0.7);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .wallet-modal-overlay.visible {
    display: flex;
  }

  .wallet-modal {
    width: 100%;
    max-width: 480px;
    max-height: 86vh;
    overflow-y: auto;
    background: #ffffff;
    border-radius: 22px;
    padding: 24px 18px;
  }

  .wallet-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  .wallet-modal-header h2 {
    margin: 0;
    font-size: 20px;
    font-weight: 700;
  }

  .wallet-modal-close {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: none;
    background: #f2ecef;
    font-size: 20px;
    cursor: pointer;
  }

  .wallet-tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 18px;
  }

  .wallet-tab-button {
    flex: 1;
    padding: 11px;
    border: 1px solid #eadde5;
    border-radius: 10px;
    background: #faf6f8;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    color: #6b625b;
  }

  .wallet-tab-button.active {
    background: #241f1b;
    color: #fff;
    border-color: #241f1b;
  }

  .wallet-package-group {
    display: none;
  }

  .wallet-package-group.active {
    display: block;
  }

  .wallet-package-tier-label {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #82786f;
    margin: 18px 0 10px;
  }

  .wallet-package-tier-label:first-child {
    margin-top: 0;
  }

  .wallet-package-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .wallet-package-card {
    border: 1px solid #eadde5;
    border-radius: 14px;
    padding: 14px 10px;
    text-align: center;
    background: #faf6f8;
    cursor: pointer;
  }

  .wallet-package-card:hover {
    border-color: #241f1b;
  }

  .wallet-package-image-slot {
    width: 56px;
    height: 56px;
    margin: 0 auto 8px;
    border-radius: 12px;
    overflow: hidden;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .wallet-package-image-slot img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .wallet-package-amount {
    font-size: 15px;
    font-weight: 700;
    margin-bottom: 3px;
  }

  .wallet-package-price {
    font-size: 12px;
    color: #6b625b;
  }

  .wallet-modal-message {
    text-align: center;
    padding: 20px;
    color: #6b625b;
    font-size: 14px;
  }

</style>


