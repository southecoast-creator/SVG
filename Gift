async function renderChapterAccess() {
  if (!chapter.is_locked || !chapter.unlock_cost || chapter.unlock_cost <= 0) {
    chapterContent.innerHTML = chapter.content || "";
    return;
  }

  const { data: { user } } = await litdomSupabase.auth.getUser();

  if (user) {
    const { data: existingUnlock } = await litdomSupabase
      .from("chapter_unlocks")
      .select("id")
      .eq("chapter_id", chapter.id)
      .eq("reader_id", user.id)
      .maybeSingle();

    if (existingUnlock) {
      chapterContent.innerHTML = chapter.content || "";
      return;
    }
  }

  chapterContent.innerHTML = `
    <div class="chapter-lock-blocker" style="
      padding: 40px 20px;
      text-align: center;
      background: #faf6f8;
      border-radius: 16px;
      border: 1px solid #eadde5;
    ">
      <p style="font-size: 17px; margin-bottom: 18px;">
        You need <strong>${chapter.unlock_cost} Rubies</strong> to continue reading this chapter.
      </p>
      <button
        type="button"
        class="unlock-chapter-button"
        style="
          padding: 12px 26px;
          border: none;
          border-radius: 10px;
          background: #241f1b;
          color: #fff;
          font-size: 15px;
          font-weight: 600;
          cursor: pointer;
        "
      >
        Pay ${chapter.unlock_cost} Rubies to Unlock
      </button>
    </div>
  `;

  const unlockButton = chapterContent.querySelector(".unlock-chapter-button");

  unlockButton.addEventListener("click", async function () {
    const { data: { user: unlockUser }, error: unlockUserError } = await litdomSupabase.auth.getUser();

    if (unlockUserError || !unlockUser) {
      alert("Please log in to unlock this chapter.");
      return;
    }

    unlockButton.disabled = true;
    unlockButton.textContent = "Unlocking...";

    const { data: wallet, error: walletError } = await litdomSupabase
      .from("wallets")
      .select("ruby_balance")
      .eq("user_id", unlockUser.id)
      .maybeSingle();

    if (walletError || !wallet) {
      alert("We couldn't check your wallet balance right now.");
      unlockButton.disabled = false;
      unlockButton.textContent = `Pay ${chapter.unlock_cost} Rubies to Unlock`;
      return;
    }

    if (wallet.ruby_balance < chapter.unlock_cost) {
      alert("You don't have enough Rubies. Please top up your wallet to continue reading.");
      unlockButton.disabled = false;
      unlockButton.textContent = `Pay ${chapter.unlock_cost} Rubies to Unlock`;
      return;
    }

    const newBalance = wallet.ruby_balance - chapter.unlock_cost;

    const { error: deductError } = await litdomSupabase
      .from("wallets")
      .update({ ruby_balance: newBalance, updated_at: new Date().toISOString() })
      .eq("user_id", unlockUser.id);

    if (deductError) {
      console.error("Wallet deduction error:", deductError);
      alert("We couldn't deduct Rubies from your wallet.");
      unlockButton.disabled = false;
      unlockButton.textContent = `Pay ${chapter.unlock_cost} Rubies to Unlock`;
      return;
    }

    const { error: unlockInsertError } = await litdomSupabase
      .from("chapter_unlocks")
      .insert([{
        reader_id: unlockUser.id,
        book_id: chapter.book_id,
        chapter_id: chapter.id,
        currency: "ruby",
        currency_amount: chapter.unlock_cost
      }]);

    if (unlockInsertError) {
      console.error("Chapter unlock insert error:", unlockInsertError);
      alert("Rubies were deducted but we couldn't unlock the chapter. Please contact support.");
      return;
    }

    await litdomSupabase
      .from("wallet_transactions")
      .insert([{
        user_id: unlockUser.id,
        currency: "ruby",
        amount: -chapter.unlock_cost,
        transaction_type: "chapter_unlock",
        reference_id: chapter.id,
        description: `Unlocked Chapter ${chapter.chapter_number}`
      }]);

    chapterContent.innerHTML = chapter.content || "";
  });
}

renderChapterAccess();