async function renderChapterAccess() {
  if (!chapter.is_locked || !chapter.unlock_cost || chapter.unlock_cost <= 0) {
    chapterContent.innerHTML = chapter.content || "";
    return;
  }

  const { data: { user } } = await litdomSupabase.auth.getUser();

  if (user) {
    const { data: existingChapterUnlock } = await litdomSupabase
      .from("chapter_unlocks")
      .select("id")
      .eq("chapter_id", chapter.id)
      .eq("reader_id", user.id)
      .maybeSingle();

    if (existingChapterUnlock) {
      chapterContent.innerHTML = chapter.content || "";
      return;
    }

    const { data: existingBookUnlock } = await litdomSupabase
      .from("book_unlocks")
      .select("id")
      .eq("book_id", bookId)
      .eq("reader_id", user.id)
      .maybeSingle();

    if (existingBookUnlock) {
      chapterContent.innerHTML = chapter.content || "";
      return;
    }
  }

  const { data: bookPricing } = await litdomSupabase
    .from("books")
    .select("full_book_unlock_cost")
    .eq("id", bookId)
    .maybeSingle();

  const diamondCost = bookPricing?.full_book_unlock_cost || 0;

  chapterContent.innerHTML = `
    <div class="chapter-lock-blocker" style="
      padding: 32px 20px;
      text-align: center;
      background: #faf6f8;
      border-radius: 16px;
      border: 1px solid #eadde5;
    ">

      <p style="font-size: 17px; margin-bottom: 14px; font-weight: 600;">
        You need ${chapter.unlock_cost} Rubies to unlock this chapter
      </p>

      <div style="
  width: 96px;
  height: 96px;
  margin: 0 auto 14px;
  border-radius: 16px;
  overflow: hidden;
">
  <img
    src="PASTE_YOUR_RUBY_IMAGE_URL_HERE"
    alt="Ruby"
    style="width: 100%; height: 100%; object-fit: contain;"
  />
</div>

      <button
        type="button"
        class="pay-ruby-button"
        style="
          width: 100%;
          max-width: 320px;
          padding: 13px 20px;
          border: none;
          border-radius: 10px;
          background: #241f1b;
          color: #fff;
          font-size: 15px;
          font-weight: 600;
          cursor: pointer;
          margin-bottom: 26px;
        "
      >
        Pay ${chapter.unlock_cost} Rubies
      </button>

      <div style="height: 1px; background: #eadde5; margin: 0 0 26px;"></div>

      <p style="font-size: 17px; margin-bottom: 14px; font-weight: 600;">
        You need ${diamondCost} Diamonds to unlock this book
      </p>

      <div style="
  width: 96px;
  height: 96px;
  margin: 0 auto 14px;
  border-radius: 16px;
  overflow: hidden;
">
  <img
    src="PASTE_YOUR_DIAMOND_IMAGE_URL_HERE"
    alt="Diamond"
    style="width: 100%; height: 100%; object-fit: contain;"
  />
</div>

      <button
        type="button"
        class="pay-diamond-button"
        style="
          width: 100%;
          max-width: 320px;
          padding: 13px 20px;
          border: none;
          border-radius: 10px;
          background: #241f1b;
          color: #fff;
          font-size: 15px;
          font-weight: 600;
          cursor: pointer;
          margin-bottom: 20px;
        "
      >
        Pay ${diamondCost} Diamonds
      </button>

      <div>
        <button
          type="button"
          class="check-wallet-button"
          style="
            border: none;
            background: transparent;
            color: #6b625b;
            font-size: 13px;
            text-decoration: underline;
            cursor: pointer;
          "
        >
          Check your wallet balance
        </button>
      </div>

    </div>
  `;

  const payRubyButton = chapterContent.querySelector(".pay-ruby-button");
  const payDiamondButton = chapterContent.querySelector(".pay-diamond-button");
  const checkWalletButton = chapterContent.querySelector(".check-wallet-button");

  checkWalletButton.addEventListener("click", function () {
    window.location.href = "/p/wallet.html";
  });

  payRubyButton.addEventListener("click", async function () {
    const { data: { user: unlockUser }, error: unlockUserError } = await litdomSupabase.auth.getUser();

    if (unlockUserError || !unlockUser) {
      alert("Please log in to unlock this chapter.");
      return;
    }

    payRubyButton.disabled = true;
    payRubyButton.textContent = "Unlocking...";

    const { data: wallet, error: walletError } = await litdomSupabase
      .from("wallets")
      .select("ruby_balance")
      .eq("user_id", unlockUser.id)
      .maybeSingle();

    if (walletError || !wallet) {
      alert("We couldn't check your wallet balance right now.");
      payRubyButton.disabled = false;
      payRubyButton.textContent = `Pay ${chapter.unlock_cost} Rubies`;
      return;
    }

    if (wallet.ruby_balance < chapter.unlock_cost) {
      alert("You don't have enough Rubies. Please top up your wallet.");
      payRubyButton.disabled = false;
      payRubyButton.textContent = `Pay ${chapter.unlock_cost} Rubies`;
      return;
    }

    const newBalance = wallet.ruby_balance - chapter.unlock_cost;

    const { error: deductError } = await litdomSupabase
      .from("wallets")
      .update({ ruby_balance: newBalance, updated_at: new Date().toISOString() })
      .eq("user_id", unlockUser.id);

    if (deductError) {
      console.error("Wallet deduction error:", deductError);
      alert("We couldn't deduct Rubies from your wallet.");
      payRubyButton.disabled = false;
      payRubyButton.textContent = `Pay ${chapter.unlock_cost} Rubies`;
      return;
    }

    const { error: unlockInsertError } = await litdomSupabase
      .from("chapter_unlocks")
      .insert([{
        reader_id: unlockUser.id,
        book_id: chapter.book_id,
        chapter_id: chapter.id,
        currency: "ruby",
        currency_amount: chapter.unlock_cost
      }]);

    if (unlockInsertError) {
      console.error("Chapter unlock insert error:", unlockInsertError);
      alert("Rubies were deducted but we couldn't unlock the chapter. Please contact support.");
      return;
    }

    await litdomSupabase
      .from("wallet_transactions")
      .insert([{
        user_id: unlockUser.id,
        currency: "ruby",
        amount: -chapter.unlock_cost,
        transaction_type: "chapter_unlock",
        reference_id: chapter.id,
        description: `Unlocked Chapter ${chapter.chapter_number}`
      }]);

    chapterContent.innerHTML = chapter.content || "";
  });

  payDiamondButton.addEventListener("click", async function () {
    const { data: { user: unlockUser }, error: unlockUserError } = await litdomSupabase.auth.getUser();

    if (unlockUserError || !unlockUser) {
      alert("Please log in to unlock this book.");
      return;
    }

    if (!diamondCost || diamondCost <= 0) {
      alert("This book does not have a Diamond unlock price set yet.");
      return;
    }

    payDiamondButton.disabled = true;
    payDiamondButton.textContent = "Unlocking...";

    const { data: wallet, error: walletError } = await litdomSupabase
      .from("wallets")
      .select("diamond_balance")
      .eq("user_id", unlockUser.id)
      .maybeSingle();

    if (walletError || !wallet) {
      alert("We couldn't check your wallet balance right now.");
      payDiamondButton.disabled = false;
      payDiamondButton.textContent = `Pay ${diamondCost} Diamonds`;
      return;
    }

    if (wallet.diamond_balance < diamondCost) {
      alert("You don't have enough Diamonds. Please top up your wallet.");
      payDiamondButton.disabled = false;
      payDiamondButton.textContent = `Pay ${diamondCost} Diamonds`;
      return;
    }

    const newBalance = wallet.diamond_balance - diamondCost;

    const { error: deductError } = await litdomSupabase
      .from("wallets")
      .update({ diamond_balance: newBalance, updated_at: new Date().toISOString() })
      .eq("user_id", unlockUser.id);

    if (deductError) {
      console.error("Wallet deduction error:", deductError);
      alert("We couldn't deduct Diamonds from your wallet.");
      payDiamondButton.disabled = false;
      payDiamondButton.textContent = `Pay ${diamondCost} Diamonds`;
      return;
    }

    const { error: unlockInsertError } = await litdomSupabase
      .from("book_unlocks")
      .insert([{
        reader_id: unlockUser.id,
        book_id: bookId,
        currency: "diamond",
        currency_amount: diamondCost
      }]);

    if (unlockInsertError) {
      console.error("Book unlock insert error:", unlockInsertError);
      alert("Diamonds were deducted but we couldn't unlock the book. Please contact support.");
      return;
    }

    await litdomSupabase
      .from("wallet_transactions")
      .insert([{
        user_id: unlockUser.id,
        currency: "diamond",
        amount: -diamondCost,
        transaction_type: "book_unlock",
        reference_id: bookId,
        description: `Unlocked full book access`
      }]);

    location.reload();
  });
}

renderChapterAccess();