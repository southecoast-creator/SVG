/*
 * GIFT SHOP
 */

giftButton.addEventListener(
  "click",
  () => {

    /*
     * GIFT CATALOG
     */

    const giftCatalog = [
      {
        type: "pancakes",
        name: "Pancakes",
        price: 8000,
        image: ""
      },

      {
        type: "chips",
        name: "Chips",
        price: 700,
        image: ""
      },

      {
        type: "avocado",
        name: "Avocado",
        price: 100,
        image: ""
      },

      {
        type: "croissant",
        name: "Croissant",
        price: 1000,
        image: ""
      },

      {
        type: "pie",
        name: "Pie",
        price: 2000,
        image: ""
      },

      {
        type: "pizza",
        name: "Pizza",
        price: 5000,
        image: ""
      },

      {
        type: "bracelet",
        name: "Bracelet",
        price: 500,
        image: ""
      },

      {
        type: "teapot",
        name: "Teapot",
        price: 1000,
        image: ""
      },

      {
        type: "donut",
        name: "Donut",
        price: 300,
        image: ""
      },

      {
        type: "camera",
        name: "Camera",
        price: 1000,
        image: ""
      },

      {
        type: "school-bag",
        name: "School Bag",
        price: 200,
        image: ""
      },

      {
        type: "scarf",
        name: "Scarf",
        price: 10000,
        image: ""
      },

      {
        type: "goggles",
        name: "Swimming Goggles",
        price: 2000,
        image: ""
      },

      {
        type: "rocket",
        name: "Rocket",
        price: 1500,
        image: ""
      },

      {
        type: "ink",
        name: "Ink",
        price: 100,
        image: ""
      },

      {
        type: "island",
        name: "Island",
        price: 20000,
        image: ""
      },

      {
        type: "crown",
        name: "Crown",
        price: 50000,
        image: ""
      },

      {
        type: "keyboard",
        name: "Keyboard",
        price: 250,
        image: ""
      },

      {
        type: "coffee",
        name: "Coffee",
        price: 2500,
        image: ""
      }
    ];


    /*
     * CREATE POPUP
     */

    const giftOverlay =
      document.createElement("div");

    giftOverlay.className =
      "litdom-gift-overlay";


    /*
     * CREATE GIFT SHOP
     */

    const giftShop =
      document.createElement("div");

    giftShop.className =
      "litdom-gift-shop";


    /*
     * HEADER
     */

    giftShop.innerHTML = `
      <div class="gift-shop-header">

        <div class="gift-shop-heading">

          <h2>
            Gift Shop
          </h2>

          <p>
            Support the author
          </p>

        </div>

        <button
          type="button"
          class="gift-shop-close"
          aria-label="Close Gift Shop"
        >
          ×
        </button>

      </div>

      <div class="gift-shop-grid"></div>

      <div class="gift-shop-tiers">

        <div class="gift-tier-note">

          <span class="gift-tier-symbol">
            ✦
          </span>

          <div>
            <strong>
              Special support tiers
            </strong>

            <p>
              Some gifts come with extra
              special benefits.
            </p>
          </div>

        </div>

        <button
          type="button"
          class="gift-tier-button"
        >
          Find out more about the tiers
        </button>

      </div>

      <button
        type="button"
        class="gift-cancel-button"
      >
        Cancel
      </button>
    `;


    /*
     * GET ELEMENTS
     */

    const giftGrid =
      giftShop.querySelector(
        ".gift-shop-grid"
      );

    const closeButton =
      giftShop.querySelector(
        ".gift-shop-close"
      );

    const cancelButton =
      giftShop.querySelector(
        ".gift-cancel-button"
      );


    /*
     * CREATE GIFT CARDS
     */

    giftCatalog.forEach(
      (gift) => {

        const giftCard =
          document.createElement(
            "button"
          );

        giftCard.type =
          "button";

        giftCard.className =
          "gift-card";

        giftCard.dataset.giftType =
          gift.type;

        giftCard.dataset.ngnPrice =
          gift.price;


        /*
         * IMAGE AREA
         */

        const imageArea =
          document.createElement(
            "div"
          );

        imageArea.className =
          "gift-image-area";


        /*
         * IMAGE
         *
         * Images will be added
         * later.
         */

        if (gift.image) {

          const image =
            document.createElement(
              "img"
            );

          image.src =
            gift.image;

          image.alt =
            gift.name;

          image.loading =
            "lazy";

          image.className =
            "gift-image";

          imageArea.appendChild(
            image
          );

        } else {

          /*
           * Temporary placeholder
           */

          imageArea.innerHTML = `
            <span
              class="gift-image-placeholder"
              aria-hidden="true"
            >
              ✦
            </span>
          `;

        }


        /*
         * GIFT NAME
         */

        const giftName =
          document.createElement(
            "span"
          );

        giftName.className =
          "gift-name";

        giftName.textContent =
          gift.name;


        /*
         * PRICE
         */

        const giftPrice =
          document.createElement(
            "span"
          );

        giftPrice.className =
          "gift-price";

        giftPrice.textContent =
          `₦${gift.price.toLocaleString(
            "en-NG"
          )}`;


        /*
         * BUILD CARD
         */

        giftCard.appendChild(
          imageArea
        );

        giftCard.appendChild(
          giftName
        );

        giftCard.appendChild(
          giftPrice
        );


        /*
         * GIFT SELECTION
         */

        giftCard.addEventListener(
          "click",
          () => {

            document
              .querySelectorAll(
                ".gift-card.selected"
              )
              .forEach(
                (card) => {
                  card.classList.remove(
                    "selected"
                  );
                }
              );


            giftCard.classList.add(
              "selected"
            );


            console.log(
              "Selected gift:",
              gift.type
            );

            console.log(
              "Gift NGN value:",
              gift.price
            );

          }
        );


        giftGrid.appendChild(
          giftCard
        );

      }
    );


    /*
     * ADD SHOP TO OVERLAY
     */

    giftOverlay.appendChild(
      giftShop
    );


    /*
     * ADD OVERLAY TO PAGE
     */

    document.body.appendChild(
      giftOverlay
    );


    /*
     * PREVENT BACKGROUND
     * SCROLLING
     */

    document.body.style.overflow =
      "hidden";


    /*
     * CLOSE FUNCTION
     */

    const closeGiftShop =
      () => {

        giftOverlay.classList.add(
          "closing"
        );

        setTimeout(
          () => {

            giftOverlay.remove();

            document.body.style.overflow =
              "";

          },
          220
        );

      };


    closeButton.addEventListener(
      "click",
      closeGiftShop
    );

    cancelButton.addEventListener(
      "click",
      closeGiftShop
    );


    /*
     * CLICK OUTSIDE SHOP
     */

    giftOverlay.addEventListener(
      "click",
      (event) => {

        if (
          event.target ===
          giftOverlay
        ) {
          closeGiftShop();
        }

      }
    );


    /*
     * ESCAPE KEY
     */

    const escapeHandler =
      (event) => {

        if (
          event.key === "Escape"
        ) {

          closeGiftShop();

          document.removeEventListener(
            "keydown",
            escapeHandler
          );

        }

      };


    document.addEventListener(
      "keydown",
      escapeHandler
    );

  }
);











/*
 * LITDOM GIFT SHOP
 */

.litdom-gift-overlay {
  position: fixed;
  inset: 0;
  z-index: 999999;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 16px;

  background:
    rgba(8, 7, 5, 0.72);

  backdrop-filter:
    blur(10px);

  -webkit-backdrop-filter:
    blur(10px);

  animation:
    giftOverlayIn 220ms ease;
}


.litdom-gift-shop {
  width: min(
    100%,
    430px
  );

  max-height:
    min(
      88vh,
      720px
    );

  overflow-y: auto;

  position: relative;

  padding:
    22px 16px 18px;

  border:
    1px solid
    rgba(255, 210, 92, 0.22);

  border-radius:
    24px;

  background:
    linear-gradient(
      145deg,
      rgba(31, 27, 20, 0.98),
      rgba(15, 14, 12, 0.99)
    );

  box-shadow:
    0 30px 80px
    rgba(0, 0, 0, 0.55),

    0 0 0 1px
    rgba(255, 255, 255, 0.03),

    inset 0 1px 0
    rgba(255, 255, 255, 0.05);

  animation:
    giftShopIn 280ms
    cubic-bezier(
      0.16,
      1,
      0.3,
      1
    );
}


.litdom-gift-shop::-webkit-scrollbar {
  width: 4px;
}

.litdom-gift-shop::-webkit-scrollbar-thumb {
  background:
    rgba(255, 210, 92, 0.25);

  border-radius:
    10px;
}


/*
 * HEADER
 */

.gift-shop-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  margin-bottom:
    18px;
}


.gift-shop-heading {
  text-align: left;
}


.gift-shop-heading h2 {
  margin: 0;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size:
    25px;

  font-weight:
    700;

  letter-spacing:
    -0.4px;

  color:
    #f8e8bd;
}


.gift-shop-heading p {
  margin:
    4px 0 0;

  font-size:
    12px;

  letter-spacing:
    0.4px;

  color:
    rgba(
      255,
      255,
      255,
      0.58
    );
}


.gift-shop-close {
  width:
    34px;

  height:
    34px;

  flex-shrink: 0;

  border:
    1px solid
    rgba(255, 255, 255, 0.08);

  border-radius:
    50%;

  background:
    rgba(255, 255, 255, 0.04);

  color:
    rgba(255, 255, 255, 0.7);

  font-size:
    23px;

  line-height:
    1;

  cursor:
    pointer;

  transition:
    180ms ease;
}


.gift-shop-close:hover {
  color:
    #fff;

  background:
    rgba(
      255,
      210,
      92,
      0.12
    );

  border-color:
    rgba(
      255,
      210,
      92,
      0.35
    );
}


/*
 * GIFT GRID
 */

.gift-shop-grid {
  display: grid;

  grid-template-columns:
    repeat(
      3,
      minmax(0, 1fr)
    );

  gap:
    9px;
}


/*
 * GIFT CARD
 */

.gift-card {
  position: relative;

  min-width: 0;

  aspect-ratio:
    1 / 1.08;

  padding:
    7px 5px 8px;

  display: flex;

  flex-direction:
    column;

  align-items:
    center;

  justify-content:
    center;

  border:
    1px solid
    rgba(
      255,
      255,
      255,
      0.065
    );

  border-radius:
    14px;

  background:
    rgba(
      255,
      255,
      255,
      0.035
    );

  color:
    #fff;

  cursor:
    pointer;

  transition:
    transform 180ms ease,
    border-color 180ms ease,
    background 180ms ease,
    box-shadow 180ms ease;
}


.gift-card:hover {
  transform:
    translateY(-2px);

  border-color:
    rgba(
      255,
      210,
      92,
      0.38
    );

  background:
    rgba(
      255,
      210,
      92,
      0.055
    );
}


.gift-card:active {
  transform:
    scale(0.97);
}


/*
 * SELECTED GIFT
 */

.gift-card.selected {
  border-color:
    rgba(
      255,
      214,
      92,
      0.92
    );

  background:
    rgba(
      255,
      210,
      92,
      0.075
    );

  box-shadow:
    0 0 0 1px
    rgba(
      255,
      210,
      92,
      0.18
    ),

    0 0 18px
    rgba(
      255,
      203,
      65,
      0.16
    );
}


/*
 * IMAGE AREA
 */

.gift-image-area {
  width:
    64px;

  height:
    64px;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  margin-bottom:
    4px;
}


.gift-image {
  width:
    100%;

  height:
    100%;

  object-fit:
    contain;

  display:
    block;
}


.gift-image-placeholder {
  width:
    46px;

  height:
    46px;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  border-radius:
    12px;

  color:
    rgba(
      255,
      218,
      120,
      0.5
    );

  background:
    rgba(
      255,
      210,
      92,
      0.06
    );

  font-size:
    20px;
}


/*
 * GIFT NAME
 */

.gift-name {
  max-width:
    100%;

  overflow:
    hidden;

  text-overflow:
    ellipsis;

  white-space:
    nowrap;

  font-size:
    11px;

  line-height:
    1.25;

  color:
    rgba(
      255,
      255,
      255,
      0.78
    );
}


/*
 * GIFT PRICE
 */

.gift-price {
  margin-top:
    2px;

  font-size:
    11px;

  font-weight:
    700;

  color:
    #f5d47b;
}


/*
 * SPECIAL TIERS
 */

.gift-shop-tiers {
  margin-top:
    18px;

  padding-top:
    14px;

  border-top:
    1px solid
    rgba(
      255,
      255,
      255,
      0.07
    );
}


.gift-tier-note {
  display:
    flex;

  gap:
    9px;

  align-items:
    flex-start;
}


.gift-tier-symbol {
  color:
    #f5d47b;

  font-size:
    16px;

  line-height:
    1.1;
}


.gift-tier-note strong {
  display:
    block;

  font-size:
    12px;

  color:
    rgba(
      255,
      255,
      255,
      0.86
    );
}


.gift-tier-note p {
  margin:
    3px 0 0;

  font-size:
    11px;

  line-height:
    1.4;

  color:
    rgba(
      255,
      255,
      255,
      0.48
    );
}


.gift-tier-button {
  width:
    100%;

  margin-top:
    10px;

  padding:
    10px;

  border:
    1px solid
    rgba(
      255,
      210,
      92,
      0.2
    );

  border-radius:
    10px;

  background:
    rgba(
      255,
      210,
      92,
      0.045
    );

  color:
    #e9ca79;

  font-size:
    11px;

  cursor:
    pointer;
}


/*
 * CANCEL
 */

.gift-cancel-button {
  width:
    100%;

  margin-top:
    10px;

  padding:
    10px;

  border:
    1px solid
    rgba(
      255,
      255,
      255,
      0.08
    );

  border-radius:
    10px;

  background:
    transparent;

  color:
    rgba(
      255,
      255,
      255,
      0.52
    );

  font-size:
    11px;

  cursor:
    pointer;

  transition:
    160ms ease;
}


.gift-cancel-button:hover {
  color:
    rgba(
      255,
      255,
      255,
      0.85
    );

  background:
    rgba(
      255,
      255,
      255,
      0.04
    );
}


/*
 * ANIMATIONS
 */

@keyframes giftOverlayIn {

  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }

}


@keyframes giftShopIn {

  from {
    opacity: 0;

    transform:
      translateY(18px)
      scale(0.97);
  }

  to {
    opacity: 1;

    transform:
      translateY(0)
      scale(1);
  }

}


.litdom-gift-overlay.closing {
  opacity: 0;

  transition:
    opacity 220ms ease;
}


.litdom-gift-overlay.closing
.litdom-gift-shop {
  transform:
    translateY(12px)
    scale(0.98);

  transition:
    transform 220ms ease;
}


/*
 * SMALL PHONES
 */

@media (
  max-width: 360px
) {

  .litdom-gift-overlay {
    padding:
      10px;
  }

  .litdom-gift-shop {
    padding:
      18px 11px 14px;

    border-radius:
      20px;
  }

  .gift-shop-grid {
    gap:
      7px;
  }

  .gift-card {
    border-radius:
      12px;
  }

  .gift-image-area {
    width:
      56px;

    height:
      56px;
  }

}