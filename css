giftCard.addEventListener(
  "click",
  async () => {

    /*
     * REMOVE PREVIOUS SELECTION
     */

    document
      .querySelectorAll(
        ".gift-card.selected"
      )
      .forEach(
        (card) => {
          card.classList.remove(
            "selected"
          );
        }
      );


    /*
     * SELECT THIS GIFT
     */

    giftCard.classList.add(
      "selected"
    );


    /*
     * PREVENT DOUBLE CLICK
     */

    if (
      giftCard.dataset.processing ===
      "true"
    ) {
      return;
    }

    giftCard.dataset.processing =
      "true";


    /*
     * SAVE ORIGINAL CARD
     */

    const originalContent =
      giftCard.innerHTML;


    /*
     * SHOW LOADING
     */

    giftCard.innerHTML = `
      <div class="gift-payment-loading">
        <span class="gift-loading-spinner"></span>
        <span>Preparing gift...</span>
      </div>
    `;


    try {

      /*
       * GET LOGGED-IN READER
       */

      const {
        data: {
          user
        },
        error: userError
      } =
        await litdomSupabase.auth.getUser();


      /*
       * CHECK READER
       */

      if (
        userError ||
        !user
      ) {
        throw new Error(
          "Please sign in before sending a gift."
        );
      }


      /*
       * CHECK EMAIL
       */

      if (
        !user.email
      ) {
        throw new Error(
          "Your account does not have an email address."
        );
      }


      /*
       * CREATE GIFT PAYMENT
       */

      const {
        data,
        error
      } =
        await litdomSupabase.functions.invoke(
          "create-gift-payment",
          {
            body: {

              gift_type:
                gift.type,

              book_id:
                bookId,

              chapter_id:
                chapter.id,

              sender_id:
                user.id,

              receiver_id:
                bookAuthorId,

              email:
                user.email

            }
          }
        );


      /*
       * CHECK FUNCTION ERROR
       */

      if (error) {

        console.error(
          "Gift payment function error:",
          error
        );

        throw new Error(
          "Unable to start the gift payment."
        );
      }


      /*
       * CHECK PAYMENT LINK
       */

      if (
        !data ||
        !data.success ||
        !data.payment_link
      ) {

        console.error(
          "Gift payment response:",
          data
        );

        throw new Error(
          data?.error ||
          "Unable to create the gift payment."
        );
      }


      /*
       * GO TO FLUTTERWAVE
       */

      window.location.href =
        data.payment_link;


    } catch (error) {

      console.error(
        "Gift payment failed:",
        error
      );


      /*
       * RESTORE CARD
       */

      giftCard.innerHTML =
        originalContent;

      giftCard.dataset.processing =
        "false";

      giftCard.classList.remove(
        "selected"
      );


      /*
       * SHOW ERROR
       */

      alert(
        error?.message ||
        "We couldn't start the gift payment. Please try again."
      );

    }

  }
);