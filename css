async function loadExistingComments() {

  const {
    data: existingComments,
    error: commentsError
  } =
    await litdomSupabase
      .from("comments")
      .select(
        `
        id,
        user_id,
        content,
        created_at,
        profiles (
          username,
          display_name
        )
        `
      )
      .eq(
        "chapter_id",
        chapter.id
      )
      .order(
        "created_at",
        {
          ascending: true
        }
      );


  if (commentsError) {

    console.error(
      "Comments loading error:",
      commentsError
    );

    return;
  }


  commentsList.innerHTML =
    "";


  if (
    !existingComments ||
    existingComments.length === 0
  ) {

    const emptyMessage =
      document.createElement(
        "div"
      );

    emptyMessage.className =
      "no-comments-message";

    emptyMessage.textContent =
      "No comments yet. Be the first to comment.";

    commentsList.appendChild(
      emptyMessage
    );

    return;
  }


  existingComments.forEach(
    function (savedComment) {

      const commentItem =
        document.createElement(
          "div"
        );

      commentItem.className =
        "reader-comment";


      /*
       * COMMENT USER
       */

      const commentUser =
        document.createElement(
          "div"
        );

      commentUser.className =
        "reader-comment-user";


      const profile =
        savedComment.profiles;


      let username =
        "";


      if (profile) {

        username =
          profile.username ||
          profile.display_name ||
          "Reader";

      } else {

        username =
          "Reader";

      }


      commentUser.textContent =
        "@" +
        username;


      /*
       * COMMENT TEXT
       */

      const commentTextElement =
        document.createElement(
          "div"
        );

      commentTextElement.className =
        "reader-comment-text";

      commentTextElement.textContent =
        savedComment.content;


      /*
       * ADD USERNAME
       * AND COMMENT
       */

      commentItem.appendChild(
        commentUser
      );

      commentItem.appendChild(
        commentTextElement
      );


      /*
       * ADD COMMENT
       * TO THE LIST
       */

      commentsList.appendChild(
        commentItem
      );

    }
  );

}


loadExistingComments();