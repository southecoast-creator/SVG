  async function loadInsightsForBook(bookId) {

    if (!bookId) {
      return;
    }

    insightsMessage.textContent =
      "Loading insights...";

    insightsLikes.textContent = "—";
    insightsReads.textContent = "—";
    insightsEarnings.textContent = "—";
       
        const {
      count: readCount,
      error: readError
    } = await supabaseClient
      .from("book_reads")
      .select("id", { count: "exact", head: true })
      .eq("book_id", bookId);

    if (readError) {
      console.error("READ COUNT ERROR:", readError);
    }

    insightsReads.textContent =
      (readCount || 0).toLocaleString();


    const {
      data: bookChapters,
      error: chaptersError
    } = await supabaseClient
      .from("chapters")
      .select("id")
      .eq("book_id", bookId);

    if (chaptersError) {
      
            console.error("CHAPTERS FOR LIKES ERROR:", chaptersError);

      insightsLikes.textContent = "0";

    } else {

      const chapterIds =
        bookChapters.map(function (c) { return c.id; });

      if (!chapterIds.length) {

        insightsLikes.textContent = "0";

      } else {

        const {
          count: likeCount,
          error: likeError
        } = await supabaseClient
          .from("chapter_likes")
          .select("id", { count: "exact", head: true })
          .in("chapter_id", chapterIds);

        if (likeError) {
          console.error("LIKE COUNT ERROR:", likeError);
        }

        insightsLikes.textContent =
          (likeCount || 0).toLocaleString();

      }

    }
    
        const {
      data: earningsRows,
      error: earningsError
    } = await supabaseClient
      .from("author_earnings")
      .select("author_share")
      .eq("book_id", bookId)
      .eq("status", "available");

    if (earningsError) {
      console.error("EARNINGS ERROR:", earningsError);
    }

    const totalEarnings =
      (earningsRows || []).reduce(function (sum, row) {
        return sum + (Number(row.author_share) || 0);
      }, 0);

    insightsEarnings.textContent =
      "\u20A6" + totalEarnings.toLocaleString();

    currentBookEarnings = totalEarnings;

    insightsMessage.textContent = "";

  }
  
