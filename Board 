    "<p>Loading chapters...</p>";

  chapterCount.textContent =
    "0";

  chapterWordCount.textContent =
    "0";


  const {
    data: chapters,
    error
  } = await supabaseClient
    .from("chapters")
    .select(
  "id,book_id,chapter_number,title,content,status,word_count,is_locked,deletion_requested,created_at,updated_at,published_at,submitted_at"
)
  
  
      .eq(
      "book_id",
      bookId
    )
    .order(
      "chapter_number",
      {
        ascending: true
      }
    );


  if (error) {

    console.error(error);

    chaptersList.innerHTML =
      "<p>Unable to load chapters.</p>";

    return;
  }


  chapterCount.textContent =
    chapters.length;
    
    
      const totalWords =
    chapters.reduce(
      function (total, chapter) {

        return total +
          (
            Number(
              chapter.word_count
            ) || 0
          );

      },
      0
    );


  chapterWordCount.textContent =
    totalWords.toLocaleString();


  if (!chapters.length) {

    chaptersList.innerHTML =
      '<p class="empty-chapters">No chapters yet.</p>';

