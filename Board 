  async function loadBooks() {

    booksList.innerHTML =
      "<p>Loading your books...</p>";


    const {
      data: books,
      error
    } = await supabaseClient
      .from("books")
      .select(
  "id,title,description,genre,age_rating,cover_url,book_type,status,submission_status,type_details,created_at,total_word_count"
)
      .eq("author_id", session.user.id)
      .order("created_at", {
        ascending: false
      });


    if (error) {

      console.error(error);

      booksList.innerHTML =
        "<p>Unable to load your books.</p>";

      return;

    }


    authorBooksCache = books;

    bookCount.textContent =
      books.length +
      (books.length === 1 ? " book" : " books");


    if (!books.length) {

      booksList.innerHTML =
        '<p class="empty-books">You haven\'t created any books yet.</p>';

      return;

    }


    /* =========================
       BATCH: PUBLICATION SUBMISSIONS
       (one query for all books, replaces
       N separate per-book queries)
    ========================= */

    const bookIds =
      books.map(function (b) { return b.id; });

    const {
      data: existingSubmissions,
      error: submissionsError
    } = await supabaseClient
      .from("book_submissions")
      .select("book_id,status")
      .in("book_id", bookIds);
    
        if (submissionsError) {
      console.error(
        "PUBLICATION SUBMISSIONS BATCH ERROR:",
        submissionsError
      );
    }

    const submittedBookIds =
      new Set(
        (existingSubmissions || []).map(
          function (s) { return s.book_id; }
        )
      );

    const submissionStatusByBookId = {};

    (existingSubmissions || []).forEach(function (s) {
      submissionStatusByBookId[s.book_id] = s.status;
    });


