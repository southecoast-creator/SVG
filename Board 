  async function handleWithdrawClick() {

    const bookId = insightsBookSelect.value;

    if (!bookId) {
      alert("Please select a book first.");
      return;
    }

    if (!currentBookEarnings || currentBookEarnings <= 0) {
      alert("This book has no available earnings to withdraw.");
      return;
    }
    
        withdrawButton.disabled = true;

    const {
      data: existingAccounts,
      error: accountsError
    } = await supabaseClient
      .from("payout_accounts")
      .select("id")
      .eq("author_id", session.user.id)
      .eq("is_primary", true)
      .maybeSingle();

    if (accountsError) {

      console.error("PAYOUT ACCOUNT LOOKUP ERROR:", accountsError);

      alert("Could not check your payout account. Please try again.");

      withdrawButton.disabled = false;
      
            return;

    }

    let payoutAccountId =
      existingAccounts ? existingAccounts.id : null;

    if (!payoutAccountId) {

      const bankName =
        prompt("Enter your bank name:");

      if (!bankName) {
        withdrawButton.disabled = false;
        return;
      }

      const accountName =
        prompt("Enter the account name:");

      if (!accountName) {
        withdrawButton.disabled = false;
        return;
      }
      
            const accountNumber =
        prompt("Enter the account number:");

      if (!accountNumber) {
        withdrawButton.disabled = false;
        return;
      }

      const {
        data: newAccount,
        error: createAccountError
      } = await supabaseClient
        .from("payout_accounts")
        .insert({
          author_id: session.user.id,
          bank_name: bankName.trim(),
          account_name: accountName.trim(),
          account_number: accountNumber.trim(),
          is_primary: true
        })
        .select("id")
        .single();
      
            if (createAccountError) {

        console.error("PAYOUT ACCOUNT CREATE ERROR:", createAccountError);

        alert("Could not save your payout account. Please try again.");

        withdrawButton.disabled = false;

        return;

      }

      payoutAccountId = newAccount.id;

    }

    const {
      error: withdrawalError
    } = await supabaseClient
      .from("withdrawal_requests")
      .insert({
        author_id: session.user.id,
        payout_account_id: payoutAccountId,
                amount: currentBookEarnings,
        currency: "NGN",
        status: "pending"
      });

    withdrawButton.disabled = false;

    if (withdrawalError) {

      console.error("WITHDRAWAL REQUEST ERROR:", withdrawalError);

      alert(
        "Withdrawal failed.\n\nError: " +
        (withdrawalError.message || "Unknown") +
        "\n\nCode: " +
        (withdrawalError.code || "Unknown")
      );

      return;

    }

    const {
      error: markPaidError
    } = await supabaseClient
      .from("author_earnings")
      .update({ status: "paid" })
      .eq("book_id", bookId)
      .eq("status", "available");

    if (markPaidError) {

      console.error("MARK EARNINGS PAID ERROR:", markPaidError);

      alert(
        "Withdrawal saved, but earnings could not be marked paid.\n\nError: " +
        (markPaidError.message || "Unknown") +
        "\n\nCode: " +
        (markPaidError.code || "Unknown")
      );

    }

    alert("Withdrawal requested. You will receive your funds within the next 24 hours.");

    loadInsightsForBook(bookId);

  }
  
